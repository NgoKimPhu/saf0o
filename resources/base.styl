  --doubleThick rgba(0, 0, 10, .4)
  --tripleThick rgba(0, 0, 10, .5)
  --thick0 rgba(0, 0, 10, 0)

  --accent1 var(--saf0o-accent-primary)
  --accent2 var(--saf0o-warning)
  --accent3 var(--saf0o-text-tertiary)
  --accent4 var(--saf0o-danger)
  --accent5 var(--saf0o-accent-secondary)
  --accent6 #9b8cb6
  --accent7 var(--saf0o-info)
  --accent8 var(--saf0o-text-tertiary)

@media (max-width: 540px)
  body
    --saf0o-page-gutter var(--saf0o-space-3)

@keyframes cardShow
  0%
    opacity 0
    transform translateY(4px)

  100%
    opacity 1
    transform translateY(0)

.cardShow
  z-index 3000001
  animation cardShow var(--saf0o-motion-page) var(--saf0o-ease) both
  animation-delay 0s

.cardHide
  opacity 0
  pointer-events none

@import './Native/style'
@import './Components'
