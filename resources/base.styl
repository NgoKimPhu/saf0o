body
  // Saf0o foundation. FiraCode remains the provisional technical face.
  --saf0o-font-ui 'MainFont', sans-serif
  --saf0o-font-mono 'FiraCode', monospace
  --saf0o-font-utility var(--saf0o-font-mono)
  --saf0o-font-body-settings 'CASL' .03, 'CRSV' 0
  --saf0o-font-heading-settings 'CASL' .28, 'CRSV' 0

  --saf0o-type-display 32px
  --saf0o-type-title 24px
  --saf0o-type-heading 20px
  --saf0o-type-sub 18px
  --saf0o-type-lead 16px
  --saf0o-type-body 14px
  --saf0o-type-small 13px
  --saf0o-type-caption 12px
  --saf0o-type-label var(--saf0o-type-caption)

  --saf0o-space-1 4px
  --saf0o-space-2 8px
  --saf0o-space-3 12px
  --saf0o-space-4 16px
  --saf0o-space-5 20px
  --saf0o-space-6 24px
  --saf0o-space-8 32px
  --saf0o-space-10 40px
  --saf0o-space-12 48px
  --saf0o-page-gutter var(--saf0o-space-5)
  // Review ledgers share one label/value anchor and one compact row rhythm.
  --saf0o-review-label-column 112px
  --saf0o-review-row-height 48px

  --saf0o-radius-sm 5px
  --saf0o-radius-md 8px
  --saf0o-radius-lg 10px
  --saf0o-radius-xl 14px
  --saf0o-radius-pill 999px

  --saf0o-shadow-sm 0 1px 2px rgba(0, 0, 0, .22)
  --saf0o-shadow-md 0 6px 18px rgba(0, 0, 0, .22)
  --saf0o-shadow-lg 0 12px 28px rgba(0, 0, 0, .28)
  --saf0o-shadow-inset inset 0 1px 0 rgba(255, 255, 255, .03)

  // Direction-free top light and a deeper lower edge keep controls tactile without patterned noise.
  --saf0o-control-texture-dark linear-gradient(180deg, rgba(255, 255, 255, .04), rgba(255, 255, 255, 0) 55%)
  --saf0o-control-texture-light linear-gradient(180deg, rgba(236, 252, 248, .16), rgba(236, 252, 248, 0) 52%)
  --saf0o-control-shadow inset 0 1px 0 rgba(255, 255, 255, .06), inset 0 -2px 0 rgba(0, 0, 0, .42), 0 1px 2px rgba(0, 0, 0, .24)
  --saf0o-control-shadow-hover inset 0 1px 0 rgba(255, 255, 255, .08), inset 0 -2px 0 rgba(0, 0, 0, .38), 0 2px 5px rgba(0, 0, 0, .26)
  --saf0o-control-shadow-pressed inset 0 1px 2px rgba(0, 0, 0, .42), 0 1px 1px rgba(0, 0, 0, .18)
  --saf0o-control-shadow-disabled inset 0 1px 0 rgba(255, 255, 255, .02)

  --saf0o-motion-fast 120ms
  --saf0o-motion-standard 180ms
  --saf0o-motion-slow 240ms
  --saf0o-motion-page 260ms
  --saf0o-ease cubic-bezier(.2, .8, .2, 1)

  // Shadows
  --cardDrop 0px 1px 1px rgba(0, 34, 32, 0.1)

  // Transitions: every legacy duration maps onto the Saf0o scale (120-240ms) and one easing curve.
  --standardFaster var(--saf0o-motion-fast) var(--saf0o-ease) all
  --standardFast var(--saf0o-motion-fast) var(--saf0o-ease) all
  --standard var(--saf0o-motion-standard) var(--saf0o-ease) all
  --standardVibe var(--saf0o-motion-standard) var(--saf0o-ease) all
  --standardSlow var(--saf0o-motion-slow) var(--saf0o-ease) all
  --standardSlower var(--saf0o-motion-slow) var(--saf0o-ease) all
  --standardSlowest var(--saf0o-motion-slow) var(--saf0o-ease) all
  --slowRocket var(--saf0o-motion-slow) var(--saf0o-ease) all

  --cubic var(--saf0o-ease)

  font-feature-settings 'ss04', 'zero'
  font-variation-settings var(--saf0o-font-body-settings)

h1, h2, h3, h4
  font-family var(--saf0o-font-ui)
  font-variation-settings var(--saf0o-font-heading-settings)
  letter-spacing -.01em

[class$='Title'], [class$='Heading'], [class$='Headline']
  font-variation-settings var(--saf0o-font-heading-settings)

button, input, select, textarea
  font-family inherit
  font-feature-settings inherit

button
  color inherit

.saf0oUtilityText
  font-family var(--saf0o-font-utility)

:focus-visible
  outline 2px solid var(--saf0o-focus, var(--moon))
  outline-offset 2px

@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    animation-duration 1ms !important
    animation-iteration-count 1 !important
    scroll-behavior auto !important
    transition-duration 1ms !important

.frameOverlay
  position absolute
  top 0 
  right 0
  bottom 0 
  left 0
  background linear-gradient(-35deg, var(--overlayA) 0%, var(--overlayB) 100%)
  z-index 9999999999999999
  pointer-events none

.suspend
  *
    animation-play-state paused !important

.clip
  *
    transition none !important

