.confirmationDialog
  font-family 'MainFont'
  font-weight 300

.confirmButtonOptions
  display flex
  justify-content center
  align-items center

  .confirmButton
    appearance none
    margin 8px
    padding 0px 16px
    height 44px
    font-weight 500
    background var(--saf0o-surface-card)
    color var(--saf0o-text-primary)
    font-family var(--saf0o-font-ui)
    border-radius var(--saf0o-radius-sm)
    display flex
    justify-content center
    align-items center
    border 1px solid var(--saf0o-border-default)
    cursor pointer
    *
      pointer-events none

  .confirmButton:hover:not(:disabled)
    background var(--saf0o-surface-hover)

  .confirmButton:disabled
    opacity .5
    cursor default

.confirmText
  font-size var(--saf0o-type-heading)
  padding 0 42px 42px
  font-weight 500
  font-variation-settings var(--saf0o-font-heading-settings)

.confirmTextWithDescription
  padding-bottom 18px

.confirmDescription
  max-width 420px
  margin 0 auto 24px
  padding 0 42px
  color var(--saf0o-text-secondary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-body)
  line-height 1.5
