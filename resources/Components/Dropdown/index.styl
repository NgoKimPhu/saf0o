.dropdownWrap
  position relative
  display flex
  align-items center
  min-width 0
  height 32px
  color var(--saf0o-text-primary)

.dropdown
  appearance none
  color-scheme dark
  min-width 130px
  max-width 100%
  height 32px
  padding 0 var(--saf0o-space-8) 0 var(--saf0o-space-3)
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-small)
  font-weight 500
  letter-spacing .2px
  text-transform none
  text-overflow ellipsis
  background-color var(--saf0o-surface-inset)
  background-image linear-gradient(45deg, transparent 50%, var(--saf0o-text-tertiary) 50%), linear-gradient(135deg, var(--saf0o-text-tertiary) 50%, transparent 50%)
  background-position calc(100% - 16px) 13px, calc(100% - 11px) 13px
  background-repeat no-repeat
  background-size 5px 5px, 5px 5px
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  box-shadow var(--saf0o-shadow-inset)
  cursor pointer
  transition background-color var(--saf0o-motion-fast), border-color var(--saf0o-motion-fast)

  option
    color var(--saf0o-text-primary)
    background var(--saf0o-surface-inset)

  option:checked
    color var(--saf0o-text-inverse)
    background var(--saf0o-accent-primary)

  option:hover,
  option:focus
    color var(--saf0o-text-primary)
    background var(--saf0o-surface-active)

  &:hover:not(:disabled)
    background-color var(--saf0o-surface-hover)
    border-color var(--saf0o-border-strong)

  &:disabled
    opacity .5
    cursor default

.darkerDrop
  background-color var(--saf0o-surface-card)
