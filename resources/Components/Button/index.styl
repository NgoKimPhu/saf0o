button.saf0oControl
  appearance none
  min-height 38px
  padding 0 var(--saf0o-space-3)
  display inline-flex
  align-items center
  justify-content center
  gap var(--saf0o-space-2)
  box-sizing border-box
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-primary)
  background-color var(--saf0o-bg-elevated)
  background-image var(--saf0o-control-texture-dark)
  box-shadow var(--saf0o-control-shadow)
  font-family var(--saf0o-font-ui)
  font-size 13px
  font-weight 550
  line-height 1
  letter-spacing .01em
  text-transform none
  cursor pointer
  transform translateY(0)
  transition background-color var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease), box-shadow var(--saf0o-motion-fast) var(--saf0o-ease), color var(--saf0o-motion-fast) var(--saf0o-ease), transform var(--saf0o-motion-fast) var(--saf0o-ease)

  > svg
    flex none

  &:hover:not(:disabled)
    border-color var(--saf0o-border-strong)
    background-color var(--saf0o-bg-panel)
    box-shadow var(--saf0o-control-shadow-hover)

  &:active:not(:disabled)
    transform translateY(1px)
    background-color var(--saf0o-surface-active)
    box-shadow var(--saf0o-control-shadow-pressed)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

  &:disabled,
  &[aria-disabled='true']
    color var(--saf0o-text-disabled)
    border-color var(--saf0o-border-subtle)
    background-color var(--saf0o-surface-inset)
    background-image none
    box-shadow var(--saf0o-control-shadow-disabled)
    cursor default
    opacity .72

button.saf0oControl.saf0oControlPrimary
  border-color var(--saf0o-control-primary-border)
  color var(--saf0o-text-inverse)
  background-color var(--saf0o-accent-primary)
  background-image var(--saf0o-control-texture-light)
  box-shadow var(--saf0o-control-primary-shadow)

  &:hover:not(:disabled)
    border-color var(--saf0o-control-primary-border-hover)
    background-color var(--saf0o-accent-primary-hover)
    box-shadow var(--saf0o-control-primary-shadow-hover)

  &:active:not(:disabled)
    background-color var(--saf0o-accent-primary-active)
    box-shadow var(--saf0o-control-primary-shadow-pressed)

button.saf0oControl.saf0oControlSecondary
  color var(--saf0o-text-secondary)

  &:hover:not(:disabled)
    color var(--saf0o-text-primary)

button.saf0oControl.saf0oControlGhost
  border-color transparent
  color var(--saf0o-text-secondary)
  background-color transparent
  background-image none
  box-shadow none

  &:hover:not(:disabled)
    color var(--saf0o-text-primary)
    border-color var(--saf0o-border-subtle)
    background-color var(--saf0o-surface-hover)
    background-image none
    box-shadow none

  &:active:not(:disabled)
    background-color var(--saf0o-surface-active)
    background-image none
    box-shadow none

// Persistent selection is a quiet state surface, not a tactile action.
// Keep this rule after the ghost variant so hover cannot erase the applied state.
button.saf0oControl.saf0oControlSelected,
button.saf0oControl[aria-selected='true']
  border-color var(--saf0o-border-subtle)
  color var(--saf0o-text-primary)
  background-color var(--saf0o-surface-active)
  background-image none
  box-shadow var(--saf0o-shadow-sm)

  &:hover:not(:disabled)
    border-color var(--saf0o-border-subtle)
    color var(--saf0o-text-primary)
    background-color var(--saf0o-surface-active)
    background-image none
    box-shadow var(--saf0o-shadow-sm)

button.saf0oControl.saf0oControlDanger
  border-color rgba(213, 116, 104, .48)
  color var(--saf0o-danger)
  background-color var(--saf0o-danger-soft)
  background-image var(--saf0o-control-texture-dark)

  &:hover:not(:disabled)
    border-color var(--saf0o-danger)
    color #f0b2ab
    background-color #321a18

button.saf0oControl.saf0oControlLarge
  min-height 44px
  padding 0 var(--saf0o-space-5)
  font-size 15px

button.saf0oControl.saf0oControlIcon
  width 38px
  min-width 38px
  height 38px
  min-height 38px
  padding 0

button.saf0oControl.saf0oControlCompact
  min-height 32px
  padding 0 var(--saf0o-space-2)
  font-size var(--saf0o-type-small)

button.saf0oControl.saf0oControlChrome
  width 28px
  min-width 28px
  height 24px
  min-height 24px
  padding 0
  border-radius var(--saf0o-radius-sm)

// Navigation shared by the adjoining wallet and dashboard shells.
button.saf0oControl.saf0oShellNav
  width 40px
  min-width 40px
  height 40px
  min-height 40px
  padding 0
  border-color transparent
  border-radius 7px
  color var(--saf0o-text-secondary)
  background-color transparent
  background-image none
  box-shadow none

  &:hover:not(:disabled)
    color var(--saf0o-text-primary)
    border-color var(--saf0o-border-subtle)
    background-color var(--saf0o-surface-hover)
    background-image none
    box-shadow none

  &:active:not(:disabled)
    color var(--saf0o-accent-primary-active)
    background-color var(--saf0o-surface-active)
    box-shadow none

  &[aria-pressed='true'],
  &[aria-expanded='true']
    color var(--saf0o-text-primary)
    border-color var(--saf0o-border-subtle)
    background-color var(--saf0o-surface-active)
    background-image none
    box-shadow var(--saf0o-shadow-sm)

button.saf0oControl.saf0oControlPrimary:disabled,
button.saf0oControl.saf0oControlPrimary[aria-disabled='true'],
button.saf0oControl.saf0oControlSecondary:disabled,
button.saf0oControl.saf0oControlSecondary[aria-disabled='true'],
button.saf0oControl.saf0oControlDanger:disabled,
button.saf0oControl.saf0oControlDanger[aria-disabled='true']
  border-color var(--saf0o-border-subtle)
  color var(--saf0o-text-disabled)
  background-color var(--saf0o-surface-inset)
  background-image none
  box-shadow var(--saf0o-control-shadow-disabled)

button.saf0oControl.saf0oControlGhost:disabled,
button.saf0oControl.saf0oControlGhost[aria-disabled='true']
  border-color transparent
  color var(--saf0o-text-disabled)
  background-color transparent
  background-image none
  box-shadow none

// Emphasized calls to action reproduce the reviewed quiet-tactile masters.
// Onboarding retains a semantic alias so its paired secondary can optically overshoot.
button.saf0oControl.saf0oHeroPrimary,
button.saf0oControl.saf0oOnboardPrimary
  min-width 156px
  height 46px
  min-height 46px
  padding 0 22px
  border-color var(--saf0o-accent-primary-hover)
  border-radius 7px
  color var(--saf0o-bg-elevated)
  background-color var(--saf0o-accent-primary)
  background-image var(--saf0o-control-texture-light)
  box-shadow var(--saf0o-control-primary-shadow)

  &:hover:not(:disabled)
    border-color var(--saf0o-control-primary-border-hover)
    background-color var(--saf0o-accent-primary-hover)
    background-image var(--saf0o-control-texture-light)
    box-shadow var(--saf0o-control-primary-shadow-hover)

  &:active:not(:disabled)
    transform translateY(1px)
    background-color var(--saf0o-accent-primary-active)
    box-shadow var(--saf0o-control-primary-shadow-pressed)

button.saf0oControl.saf0oOnboardSecondary
  min-width 96px
  height 48px
  min-height 48px
  padding 0 18px
  border-color var(--saf0o-border-strong)
  border-radius 7px
  color var(--saf0o-text-secondary)
  background-color var(--saf0o-bg-elevated)
  background-image var(--saf0o-control-texture-dark)
  box-shadow var(--saf0o-control-shadow)
  transform translateY(-1px)

  &:hover:not(:disabled)
    color var(--saf0o-text-primary)
    border-color var(--saf0o-border-strong)
    background-color var(--saf0o-bg-panel)
    background-image var(--saf0o-control-texture-dark)
    box-shadow var(--saf0o-control-shadow-hover)
    transform translateY(-1px)

  &:active:not(:disabled)
    transform translateY(0)
    background-color var(--saf0o-surface-active)
    box-shadow var(--saf0o-control-shadow-pressed)
