// All editable fields share one restrained inset construction. Search fields may
// opt into the quiet alias, but never switch to a different border geometry.
input.saf0oInput,
textarea.saf0oInput,
select.saf0oInput
  box-sizing border-box
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  outline 0
  color var(--saf0o-text-primary)
  background-color var(--saf0o-surface-inset)
  background-image linear-gradient(180deg, rgba(255, 255, 255, .012), transparent 48%)
  box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), inset 0 -1px rgba(255, 255, 255, .018)
  caret-color var(--saf0o-accent-primary-hover)
  transition border-color var(--saf0o-motion-fast) var(--saf0o-ease), box-shadow var(--saf0o-motion-fast) var(--saf0o-ease), color var(--saf0o-motion-fast) var(--saf0o-ease), background-color var(--saf0o-motion-fast) var(--saf0o-ease)

  &::placeholder
    color var(--saf0o-text-muted)
    opacity 1

  &:hover:not(:disabled):not(:focus)
    border-color var(--saf0o-border-strong)

  &:focus,
  &:focus-visible
    border-color var(--saf0o-accent-primary-hover)
    outline 0
    box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), 0 0 0 1px rgba(0, 168, 128, .2)

  &[aria-invalid='true'],
  &.saf0oInputError
    border-color var(--saf0o-danger)
    background-color var(--saf0o-danger-soft)
    box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), 0 0 0 1px rgba(225, 154, 145, .32)

  &:disabled,
  &[aria-disabled='true']
    color var(--saf0o-text-disabled)
    background-color var(--saf0o-surface-inset)
    box-shadow inset 0 1px 2px rgba(0, 0, 0, .38)
    cursor default
    opacity .7

input.saf0oInput,
select.saf0oInput
  min-height 44px

select.saf0oInput
  color-scheme dark

  option
    color var(--saf0o-text-primary)
    background var(--saf0o-surface-inset)

  option:checked
    color var(--saf0o-text-inverse)
    background var(--saf0o-accent-primary)

  option:hover,
  option:focus
    color var(--saf0o-text-primary)
    background var(--saf0o-surface-active)

input.saf0oInputQuiet,
textarea.saf0oInputQuiet,
select.saf0oInputQuiet
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  background-color var(--saf0o-surface-inset)
  box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), inset 0 -1px rgba(255, 255, 255, .018)

  &:hover:not(:disabled):not(:focus)
    border-color var(--saf0o-border-strong)
    box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), inset 0 -1px rgba(255, 255, 255, .018)

  &:focus,
  &:focus-visible
    border-color var(--saf0o-accent-primary-hover)
    box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), 0 0 0 1px rgba(0, 168, 128, .2)

textarea.saf0oInput
  resize vertical

.saf0oInputGroup.saf0oInputGroup
  box-sizing border-box
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  background-color var(--saf0o-surface-inset)
  background-image linear-gradient(180deg, rgba(255, 255, 255, .012), transparent 48%)
  box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), inset 0 -1px rgba(255, 255, 255, .018)
  transition border-color var(--saf0o-motion-fast) var(--saf0o-ease), box-shadow var(--saf0o-motion-fast) var(--saf0o-ease), background-color var(--saf0o-motion-fast) var(--saf0o-ease)

  &:hover:not(:focus-within)
    border-color var(--saf0o-border-strong)

  &:focus-within
    border-color var(--saf0o-accent-primary-hover)
    box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), 0 0 0 1px rgba(0, 168, 128, .2)

  input.saf0oInput,
  textarea.saf0oInput,
  select.saf0oInput
    border 0
    border-radius 0
    background transparent
    box-shadow none

    &:hover,
    &:focus,
    &:focus-visible
      border 0
      outline 0
      background transparent
      box-shadow none

  &.saf0oInputGroupError
    border-color var(--saf0o-danger)
    background-color var(--saf0o-danger-soft)
    box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), 0 0 0 1px rgba(225, 154, 145, .32)

.saf0oInputGroup.saf0oInputGroupQuiet
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), inset 0 -1px rgba(255, 255, 255, .018)

  &:hover:not(:focus-within)
    border-color var(--saf0o-border-strong)
    box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), inset 0 -1px rgba(255, 255, 255, .018)

  &:focus-within
    border-color var(--saf0o-accent-primary-hover)
    box-shadow inset 0 1px 2px rgba(0, 0, 0, .46), 0 0 0 1px rgba(0, 168, 128, .2)
