.receivePanel
  position fixed
  z-index 2147483647
  display flex
  flex-direction column
  align-items center
  gap var(--saf0o-space-4)
  box-sizing border-box
  width 300px
  max-width calc(100vw - 24px)
  max-height calc(100vh - 24px)
  overflow-y auto
  padding var(--saf0o-space-5)
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-md)
  background var(--saf0o-bg-subtle)
  box-shadow var(--saf0o-shadow-sm)
  color var(--saf0o-text-primary)

  h2
    margin 0
    font-size var(--saf0o-type-lead)

  code
    overflow-wrap anywhere
    text-align center
    font-size var(--saf0o-type-small)
    line-height 20px

  .qrCode
    width 185px
    height 185px

  button
    min-height 44px
    width 100%

.receiveBackdrop
  position fixed
  inset 0
  z-index 2147483646
  backdrop-filter blur(4px)
  background rgba(7, 8, 15, .18)
  pointer-events auto
