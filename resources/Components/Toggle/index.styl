.saf0oToggle
  appearance none
  position relative
  width 44px
  height 44px
  flex 0 0 44px
  padding 0
  color inherit
  border 0
  background transparent
  box-shadow none
  cursor pointer

  &::before
    position absolute
    top 10px
    left 0
    width 44px
    height 24px
    box-sizing border-box
    border 1px solid var(--saf0o-border-default)
    border-radius 2px
    content ''
    background var(--saf0o-surface-inset)
    box-shadow var(--saf0o-shadow-inset)
    transition background var(--saf0o-motion-fast), border-color var(--saf0o-motion-fast)

  &:hover:not(:disabled)
    &::before
      border-color var(--saf0o-border-strong)
      background var(--saf0o-surface-hover)

  &:active:not(:disabled)
    &::before
      background var(--saf0o-surface-active)

  &:disabled
    cursor default

    &::before
      opacity .55

    .saf0oToggleThumb
      opacity .72

  .saf0oToggleThumb
    position absolute
    top 14px
    left 4px
    width 16px
    height 16px
    box-sizing border-box
    border-bottom 2px solid var(--saf0o-border-strong)
    border-radius 1px
    background var(--saf0o-text-secondary)
    box-shadow var(--saf0o-shadow-sm)
    transition transform var(--saf0o-motion-fast), background var(--saf0o-motion-fast)

.saf0oToggleOn
  &::before
    border-color var(--saf0o-success)
    background var(--saf0o-success-soft)

  &:hover:not(:disabled)
    &::before
      border-color var(--saf0o-accent-secondary-hover)
      background var(--saf0o-accent-secondary-soft)

  .saf0oToggleThumb
    background var(--saf0o-success)
    transform translateX(20px)

  &:disabled .saf0oToggleThumb
    opacity 1
