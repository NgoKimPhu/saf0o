.saf0oTokenApprovalEditor
  width 100%
  margin 0
  padding var(--saf0o-space-5)
  box-sizing border-box
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-ui)

.saf0oTokenApprovalContext
  display grid
  overflow hidden
  grid-template-columns minmax(0, 1fr)

  > div
    display grid
    min-width 0
    min-height 52px
    padding var(--saf0o-space-1) 0
    box-sizing border-box
    grid-template-columns var(--saf0o-review-label-column) minmax(0, 1fr)
    align-items center
    gap var(--saf0o-space-4)

.saf0oTokenApprovalContextLabel
  display block
  margin 0
  color var(--saf0o-text-muted)
  font-size var(--saf0o-type-caption)

.saf0oTokenApprovalIdentity
  display flex
  min-width 0
  align-items center

  > span
    min-width 0

  strong,
  small
    display block

  strong
    overflow hidden
    font-size var(--saf0o-type-small)
    font-weight 620
    text-overflow ellipsis
    white-space nowrap

  small
    margin-top 2px
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)

.saf0oTokenApprovalAddress
  appearance none
  display flex
  min-width 0
  min-height 44px
  padding var(--saf0o-space-1) 0
  justify-content center
  border 1px solid transparent
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-secondary)
  background transparent
  flex-direction column
  cursor pointer
  text-align left

  code
    display block
    max-width 100%
    overflow-wrap anywhere
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    line-height 18px

  strong,
  span
    display block
    overflow hidden
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)
    font-weight 500
    text-overflow ellipsis
    white-space nowrap

  span
    margin-top 2px
    color var(--saf0o-text-muted)
    font-size var(--saf0o-type-caption)

  &:hover
    border-color var(--saf0o-border-subtle)
    color var(--saf0o-text-primary)
    background var(--saf0o-ledger-hover)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

.saf0oTokenApprovalContext > .saf0oTokenApprovalExpiry
  grid-column 1 / -1
  padding var(--saf0o-space-2) 0

  strong
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)
    font-weight 560

.saf0oTokenApprovalDecision
  padding var(--saf0o-space-4) 0 0

.saf0oTokenApprovalDecisionHeading
  display grid
  min-height 44px
  grid-template-columns var(--saf0o-review-label-column) minmax(0, 1fr)
  align-items center
  gap var(--saf0o-space-4)

  > div > span
    display block
    font-size var(--saf0o-type-small)
    font-weight 620

.saf0oTokenApprovalCurrentValue
  display flex
  min-width 0
  min-height 44px
  padding 0
  color var(--saf0o-text-primary)
  align-items center
  gap var(--saf0o-space-1)

  strong
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-body)
    font-weight 600

  span
    color var(--saf0o-text-muted)
    font-size var(--saf0o-type-caption)

.saf0oTokenApprovalModes
  display grid
  margin-top var(--saf0o-space-3)
  overflow hidden
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  background var(--saf0o-surface-inset)
  box-shadow inset 0 1px 2px rgba(0, 0, 0, .38)
  grid-template-columns repeat(3, minmax(0, 1fr))

.saf0oTokenApprovalMode
  appearance none
  min-width 0
  min-height 44px
  padding 0 var(--saf0o-space-2)
  border 0
  border-left 1px solid var(--saf0o-border-default)
  color var(--saf0o-text-secondary)
  background-color var(--saf0o-bg-elevated)
  background-image var(--saf0o-control-texture-dark)
  box-shadow var(--saf0o-control-shadow)
  cursor pointer
  transition background-color var(--saf0o-motion-fast) var(--saf0o-ease), box-shadow var(--saf0o-motion-fast) var(--saf0o-ease), color var(--saf0o-motion-fast) var(--saf0o-ease)

  &:first-child
    border-left 0

  span
    display block
    font-size var(--saf0o-type-small)
    font-weight 560

  &:hover:not(:disabled)
    color var(--saf0o-text-primary)
    background-color var(--saf0o-hover)
    box-shadow var(--saf0o-control-shadow-hover)

  &:active:not(:disabled),
  &[aria-pressed='true'],
  &[aria-pressed='true']:hover:not(:disabled)
    color var(--saf0o-text-primary)
    background-color var(--saf0o-surface-active)
    background-image none
    box-shadow var(--saf0o-control-shadow-pressed)

  &:focus-visible
    position relative
    z-index 1
    outline 2px solid var(--saf0o-focus)
    outline-offset -2px

  &:disabled
    color var(--saf0o-text-disabled)
    background-image none
    box-shadow var(--saf0o-control-shadow-disabled)
    cursor default

.saf0oTokenApprovalRevoke
  appearance none
  display block
  min-height 44px
  width 100%
  margin var(--saf0o-space-2) 0 0
  padding 0
  border 1px solid transparent
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-danger)
  background transparent
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-caption)
  font-weight 600
  cursor pointer
  text-align left

  &:hover:not(:disabled)
    border-color var(--saf0o-border-subtle)
    background var(--saf0o-ledger-hover)

  &[aria-pressed='true']
    border-color var(--saf0o-border-default)
    background var(--saf0o-surface-active)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

  &:disabled
    color var(--saf0o-text-disabled)
    cursor default

.saf0oTokenApprovalAmountEditor
  margin-top var(--saf0o-space-2)

  > label
    display block
    margin-bottom var(--saf0o-space-1)
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-caption)

.approveTokenSpendAmount.saf0oInputGroup
  position relative
  display flex
  width 100%
  height 46px
  align-items center

  input.saf0oInput
    min-width 0
    width 100%
    height 100%
    padding 0 calc(164px + var(--saf0o-space-2)) 0 var(--saf0o-space-3)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-body)
    text-align left

.saf0oTokenApprovalAmountSymbol
  position absolute
  top 50%
  right 100px
  max-width 64px
  overflow hidden
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  transform translateY(-50%)
  text-overflow ellipsis
  white-space nowrap
  pointer-events none

.saf0oTokenApprovalAmountAction,
.saf0oTokenApprovalAmountStatus
  appearance none
  position absolute
  top 0
  right 0
  bottom 0
  display flex
  width 68px
  padding 0 var(--saf0o-space-2)
  align-items center
  justify-content center
  border 0
  border-left 1px solid var(--saf0o-border-subtle)
  color var(--saf0o-accent-primary-hover)
  background transparent
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-caption)
  font-weight 650

.saf0oTokenApprovalAmountAction
  cursor pointer

  &:hover:not(:disabled)
    color var(--saf0o-text-primary)
    background var(--saf0o-ledger-hover)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset -2px

.saf0oTokenApprovalStatusSuccess
  color var(--saf0o-success)

.saf0oTokenApprovalStatusDanger
  width 112px
  color var(--saf0o-danger)

.saf0oTokenApprovalDecisionCopy,
.saf0oTokenApprovalUnavailable
  margin var(--saf0o-space-2) 0 0
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-caption)
  line-height 1.5

.saf0oTokenApprovalDecisionCopyWarning
  padding-left var(--saf0o-space-2)
  border-left 2px solid var(--saf0o-warning)
  color var(--saf0o-warning)

.saf0oTokenApprovalUnavailable
  color var(--saf0o-warning)

.saf0oTokenApprovalBalance
  display flex
  min-width 0
  min-height 72px
  padding var(--saf0o-space-3)
  box-sizing border-box
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-sm)
  background var(--saf0o-surface-inset)
  margin 0 0 var(--saf0o-space-2)
  gap var(--saf0o-space-4)
  align-items center
  justify-content space-between

  > span
    min-width 0

  strong
    display block
    margin-top 2px
    overflow-wrap anywhere
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-small)
    font-weight 500

  > button.saf0oControl
    flex-shrink 0
    min-height 44px
    padding 0 var(--saf0o-space-4)
