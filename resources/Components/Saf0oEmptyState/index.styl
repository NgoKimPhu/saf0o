.saf0oEmptyState
  position relative
  display flex
  width 100%
  min-height 88px
  padding var(--saf0o-space-3) 220px var(--saf0o-space-3) var(--saf0o-space-4)
  box-sizing border-box
  align-items center
  overflow hidden
  background linear-gradient(90deg, rgba(13, 17, 14, .8) 0%, rgba(13, 17, 14, .34) 58%, rgba(13, 17, 14, 0) 82%)

.saf0oEmptyStateText
  position relative
  z-index 2
  min-width 0

.saf0oEmptyStateTitle
  color var(--saf0o-text-primary)
  font-size var(--saf0o-type-small)
  font-weight 600
  line-height 1.25

.saf0oEmptyStateCopy
  margin-top var(--saf0o-space-1)
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-caption)
  font-weight 400
  line-height 1.45

.saf0oEmptyStateImage
  position absolute
  top 50%
  right var(--saf0o-space-2)
  z-index 1
  display block
  width 210px
  height auto
  transform translateY(-50%)
  opacity .94
  -webkit-mask-image radial-gradient(ellipse 72% 62% at 50% 50%, #000 38%, rgba(0, 0, 0, .92) 61%, transparent 100%)
  mask-image radial-gradient(ellipse 72% 62% at 50% 50%, #000 38%, rgba(0, 0, 0, .92) 61%, transparent 100%)
  pointer-events none

.saf0oEmptyStateExpanded
  min-height 190px
  padding var(--saf0o-space-6) 320px var(--saf0o-space-6) var(--saf0o-space-6)
  background transparent
  text-align left

  .saf0oEmptyStateImage
    position absolute
    top 50%
    right var(--saf0o-space-5)
    width 300px
    margin 0
    transform translateY(-50%)
    opacity 1

  .saf0oEmptyStateText
    max-width 340px

  .saf0oEmptyStateTitle
    font-size var(--saf0o-type-body)

  .saf0oEmptyStateCopy
    margin-top var(--saf0o-space-1)
    font-size var(--saf0o-type-small)

.saf0oEmptyFilter
  display flex
  min-height 64px
  padding var(--saf0o-space-3) var(--saf0o-space-4)
  box-sizing border-box
  align-items center
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-small)

@media (max-width: 560px)
  .saf0oEmptyState
    min-height 84px
    padding-right 164px

  .saf0oEmptyState:not(.saf0oEmptyStateExpanded) .saf0oEmptyStateImage
    right -10px
    width 172px

  .saf0oEmptyStateExpanded
    min-height 156px
    padding var(--saf0o-space-4) 190px var(--saf0o-space-4) var(--saf0o-space-4)

    .saf0oEmptyStateImage
      right 0
      width 190px
