.dappTile
  display flex
  flex-direction column
  align-items center
  justify-content center
  margin var(--saf0o-space-2) 0
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-ui)

  .dappIcon
    display flex
    align-items center
    justify-content center
    width 58px
    height 58px
    box-sizing border-box
    border 1px solid var(--saf0o-border-subtle)
    border-radius var(--saf0o-radius-md)
    background var(--saf0o-bg-elevated)
    cursor pointer
    transition background var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease)

  .dappIcon:hover
    border-color var(--saf0o-border-default)
    background var(--saf0o-surface-hover)

  .dappIcon:active
    background var(--saf0o-surface-active)

  .dappIcon:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

  .dappIcon:disabled
    color var(--saf0o-text-disabled)
    cursor not-allowed
    opacity .6

  .dappName
    max-width 74px
    margin-top var(--saf0o-space-1)
    overflow hidden
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-caption)
    font-weight 500
    line-height 14px
    text-align center
    text-overflow ellipsis
    text-transform none
    white-space nowrap
