// Wallet panel width. Keep equal to shellMainTargetWidth in main/windows/shellGeometry.ts (tested).
shellWidth = 425px

html, body
  margin 0
  width 100%
  height 100%
  border 0
  box-sizing border-box
  font-family 'MainFont'
  font-weight 300
  -webkit-app-region no-drag
  overflow hidden
  color var(--outerspace)
  background transparent

body
  position relative
  border 0
  border-radius var(--saf0o-radius-xl)

.frameOverlay
  display none

body::before
  content ''
  position fixed
  top 0
  right 0
  bottom 0
  width shellWidth
  max-width 100%
  border-radius var(--saf0o-radius-xl)
  background unquote("color-mix(in srgb, var(--saf0o-bg-canvas) calc(var(--saf0o-window-alpha, .7) * 100%), transparent)")
  box-shadow var(--saf0o-shadow-lg), var(--saf0o-shadow-inset)
  pointer-events none

.workspace-edge-left::before
  right auto
  left 0

.workspace-edge-right::before
  border-top-right-radius 0
  border-bottom-right-radius 0

.workspace-edge-left::before
  border-top-left-radius 0
  border-bottom-left-radius 0

.workspace-edge-right
  border-top-right-radius 0
  border-bottom-right-radius 0

.workspace-edge-left
  border-top-left-radius 0
  border-bottom-left-radius 0

body::before
  transition width var(--saf0o-motion-standard) var(--saf0o-ease)

.workspace-joined::before,
.workspace-open::before
  width 100%

.workspace-joined.workspace-edge-right::before,
.workspace-open.workspace-edge-right::before
  border-top-left-radius 0
  border-bottom-left-radius 0

.workspace-joined.workspace-edge-left::before,
.workspace-open.workspace-edge-left::before
  border-top-right-radius 0
  border-bottom-right-radius 0

.workspace-joined.workspace-edge-right,
.workspace-open.workspace-edge-right
  border-top-left-radius 0
  border-bottom-left-radius 0

.workspace-joined.workspace-edge-left,
.workspace-open.workspace-edge-left
  border-top-right-radius 0
  border-bottom-right-radius 0

div
  user-select none
  cursor default

::-webkit-scrollbar
  width 6px
  height 6px
  background transparent

::-webkit-scrollbar-track
  background transparent

::-webkit-scrollbar-thumb
  border 2px solid transparent
  border-radius 2px
  background-color unquote('color-mix(in srgb, var(--saf0o-text-muted) 40%, transparent)')
  background-clip content-box

::-webkit-scrollbar-thumb:hover
  background-color unquote('color-mix(in srgb, var(--saf0o-text-muted) 60%, transparent)')

.clip
  *
    transition none !important

#panel
  // background rgba(228, 232, 248, 1)
  margin 0px
  // border-radius 12px
  // box-shadow 0px 1px 5px 1px rgba(33, 45, 46, 0.1), 0px 0px 0px 1px rgba(110, 120, 140, 0.2)
  overflow hidden
  border 0
  box-sizing border-box

  #bar
    right 360px

  #bot
    left 5px
    right 360px

  #drop
    left 5px
    bottom 5px
    right 360px
    border-radius 3px

  #views
    right 360px
    bottom 5px
    left 5px
    border-bottom-right-radius 3px
    border-bottom-left-radius 3px

    .screen
      z-index 20000

.session
  position fixed
  top 0px
  right 15px
  height 37px
  font-weight 400
  border-bottom-left-radius 4px
  display flex
  justify-content center
  align-items center
  user-select none
  cursor default
  font-size 14px
  transition var(--standard)
  z-index 1000

.hidden
  visibility hidden
  
@import './style'

// Saf0o wallet shell
#panel
  --saf0o-window-mode-canvas var(--saf0o-window-canvas)
  --saf0o-window-mode-image var(--saf0o-window-atmosphere-wallet)
  --saf0o-window-mode-repeat var(--saf0o-window-atmosphere-repeat)
  --saf0o-window-mode-size var(--saf0o-window-atmosphere-wallet-size)
  --saf0o-window-mode-blend var(--saf0o-window-atmosphere-blend)
  --saf0o-window-mode-shadow var(--saf0o-window-atmosphere-wallet-shadow)
  width shellWidth
  max-width 100vw
  left auto
  right 0
  border 0
  border-radius var(--saf0o-radius-xl)
  color var(--saf0o-text-primary)
  background-color unquote("color-mix(in srgb, var(--saf0o-window-mode-canvas) calc(var(--saf0o-window-alpha, .7) * 100%), transparent)")
  background-image var(--saf0o-window-mode-image)
  background-repeat var(--saf0o-window-mode-repeat)
  background-size var(--saf0o-window-mode-size)
  background-blend-mode var(--saf0o-window-mode-blend)
  box-shadow var(--saf0o-window-mode-shadow)

.workspace-edge-left #panel
  left 0
  right auto

.workspace-edge-right #panel
  border-top-right-radius 0
  border-bottom-right-radius 0

.workspace-edge-left #panel
  border-top-left-radius 0
  border-bottom-left-radius 0

.workspace-joined.workspace-edge-right #panel,
.workspace-open.workspace-edge-right #panel
  border-top-left-radius 0
  border-bottom-left-radius 0

.workspace-joined.workspace-edge-left #panel,
.workspace-open.workspace-edge-left #panel
  border-top-right-radius 0
  border-bottom-right-radius 0

// Slide in from the docked edge each time the wallet opens (body loses .suspend).
// The short delay holds the start state until the window is on screen; 'backwards'
// keeps no end transform, so #panel never becomes a containing block for fixed children.
@keyframes shellSlideInRight
  from
    transform translateX(100%)

@keyframes shellSlideInLeft
  from
    transform translateX(-100%)

.workspace-edge-right:not(.suspend) #panel,
.workspace-edge-right:not(.suspend)::before
  animation shellSlideInRight 180ms ease-out 40ms backwards

.workspace-edge-left:not(.suspend) #panel,
.workspace-edge-left:not(.suspend)::before
  animation shellSlideInLeft 180ms ease-out 40ms backwards

@media (prefers-reduced-motion: reduce)
  .workspace-edge-right:not(.suspend) #panel,
  .workspace-edge-right:not(.suspend)::before,
  .workspace-edge-left:not(.suspend) #panel,
  .workspace-edge-left:not(.suspend)::before
    animation none !important

.backdrop,
.overlay
  right 0
  left 0
  border 0
  border-radius 0
  background transparent
  box-shadow none

.overlayMonitor::before
  display none

.cardShow
  animation-duration var(--saf0o-motion-slow)
  animation-timing-function var(--saf0o-ease)

@import '../../resources/Components/Button'
@import '../../resources/Components/Input'

@import '../../resources/Components/Receive/style.styl'

.walletRecovery
  position absolute
  right 0
  top 0
  width 100%
  max-width shellWidth
  height 100%
  box-sizing border-box
  padding var(--saf0o-space-6)
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap var(--saf0o-space-5)
  background var(--saf0o-bg-canvas)
  color var(--saf0o-text-primary)
  border-radius var(--saf0o-radius-xl)

.workspace-edge-left .walletRecovery
  right auto
  left 0

.walletRecoveryActions
  display flex
  gap var(--saf0o-space-3)

  button
    font inherit
    color var(--saf0o-text-primary)
    padding 12px 18px
    border 1px solid var(--saf0o-border-default)
    border-radius var(--saf0o-radius-md)
    background var(--saf0o-bg-elevated)
    box-shadow var(--saf0o-control-shadow)
    cursor pointer

    &:hover
      box-shadow var(--saf0o-control-shadow-hover)

    &:active
      box-shadow var(--saf0o-control-shadow-pressed)

    &:focus-visible
      outline 2px solid var(--saf0o-text-muted)
      outline-offset 3px
