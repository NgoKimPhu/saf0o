.badgeWrap
  position absolute
  z-index 1000000001
  inset 0
  display flex
  align-items center
  justify-content center
  padding var(--saf0o-space-5)
  box-sizing border-box
  background rgba(7, 9, 16, .82)
  backdrop-filter blur(7px)

.updateDialog
  width min(100%, 440px)
  display flex
  box-sizing border-box
  padding var(--saf0o-space-6)
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-md)
  color var(--saf0o-text-primary)
  background-color var(--saf0o-bg-elevated)
  background-image var(--saf0o-control-texture-dark)
  box-shadow var(--saf0o-shadow-lg), var(--saf0o-shadow-inset)
  font-family var(--saf0o-font-ui)
  flex-direction column

.updateDialogCopy
  display flex
  flex-direction column

  h2
    margin var(--saf0o-space-2) 0 var(--saf0o-space-3)
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-heading)
    font-weight 640
    line-height 1.2

  p
    margin 0
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-body)
    line-height 1.55

.updateDialogEyebrow
  color var(--saf0o-accent-primary-hover)
  font-size var(--saf0o-type-caption)
  font-weight 620
  letter-spacing .055em
  text-transform uppercase

.updateDialogActions
  display flex
  justify-content flex-end
  gap var(--saf0o-space-2)
  margin-top var(--saf0o-space-6)

  button
    min-width 118px

.updateDialogSkip
  align-self flex-start
  margin-top var(--saf0o-space-3)

@media (max-height: 560px)
  .badgeWrap
    align-items flex-start
    overflow-y auto

  .updateDialog
    margin auto 0
    padding var(--saf0o-space-5)

@container panel (max-width: 420px)
  .updateDialogActions
    align-items stretch
    flex-direction column

    button
      width 100%
