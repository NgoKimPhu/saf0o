.accountView:has(.tokenApprovalsView) .accountViewMain
  top 64px
  left 0
  right 0

.accountViewScroll.tokenApprovalsView
  padding 0
  overflow-y auto

.tokenApprovalsBody
  padding var(--saf0o-space-5)

.tokenApprovalsToolbar,
.tokenApprovalRow > header,
.tokenApprovalActions,
.tokenApprovalsPagination
  display flex
  align-items center
  justify-content space-between
  gap var(--saf0o-space-4)

.tokenApprovalsToolbar
  margin-bottom var(--saf0o-space-2)
  color var(--saf0o-text-secondary)

.tokenApprovalsList
  list-style none
  margin 0
  padding 0

.tokenApprovalRow
  padding var(--saf0o-space-5) 0
  & + &
    border-top 1px solid var(--saf0o-border-subtle)
  > header
    margin-bottom var(--saf0o-space-3)
    strong
      font-size var(--saf0o-type-body)
    > span
      color var(--saf0o-text-muted)
      font-size var(--saf0o-type-small)

.tokenApprovalField
  display grid
  grid-template-columns 60px minmax(0, 1fr)
  align-items center
  gap var(--saf0o-space-2)
  > span
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-small)

.tokenApprovalAddress
  display flex
  align-items center
  justify-content space-between
  gap var(--saf0o-space-2)
  min-height 44px
  min-width 0
  padding var(--saf0o-space-2) 0
  border 0
  background transparent
  color var(--saf0o-text-secondary)
  text-align left
  cursor pointer
  > span
    min-width 0
    overflow-wrap anywhere
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-small)
    line-height 18px
  svg
    flex-shrink 0
  &:hover
    color var(--saf0o-text-primary)
  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 3px

.tokenApprovalActions
  margin-top var(--saf0o-space-3)
  align-items flex-end
  > button
    flex 0 0 auto

.tokenApprovalLimit
  min-width 0
  display flex
  flex-direction column
  gap var(--saf0o-space-2)
  > span
    color var(--saf0o-text-muted)
    font-size var(--saf0o-type-small)
  strong
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-body)
    line-height 22px
    overflow-wrap anywhere

.tokenApprovalsAbout
  margin-top var(--saf0o-space-5)
  color var(--saf0o-text-secondary)
  summary
    display list-item
    cursor pointer
    min-height 44px
    align-content center
  p
    margin var(--saf0o-space-1) 0 var(--saf0o-space-3)
    font-size var(--saf0o-type-small)
    line-height 20px

.tokenApprovalsEmpty
  margin 36px 0
  color var(--saf0o-text-secondary)

.tokenApprovalsError
  color var(--saf0o-danger)
  line-height 20px

.tokenApprovalsPagination
  margin-top var(--saf0o-space-4)

.accountApprovalsLink
  width 100%
  margin var(--saf0o-space-2) 0 var(--saf0o-space-1)

@container panel (max-width: 560px)
  .tokenApprovalsBody
    padding var(--saf0o-space-3)
  .tokenApprovalField
    grid-template-columns 52px minmax(0, 1fr)
