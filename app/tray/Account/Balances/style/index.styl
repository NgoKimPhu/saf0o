.balancesBlock
  box-sizing border-box
  overflow auto
  color var(--saf0o-text-primary)

.balanceFilter
  position relative
  top auto
  flex none
  margin-bottom var(--saf0o-space-2)
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  background var(--saf0o-surface-inset)
  box-shadow var(--saf0o-shadow-inset)

  .panelFilterInput
    right 10px

    input,
    input:hover,
    input:focus
      border 0
      background transparent
      box-shadow none

  &.balanceFilterHasValue
    .panelFilterInput input
      padding-right 46px

    .panelFilterClear
      top 5px
      right 13px
      width 38px
      min-width 38px
      height 38px
      min-height 38px

.balancesExpandedView
  display flex
  min-height 0
  padding-bottom 0
  overflow hidden
  flex-direction column

.balancesExpandedScroll
  flex 1
  min-height 0
  width 100%
  overflow-x hidden
  overflow-y auto
  padding 0 0 60px
  box-sizing border-box
  border 0
  border-radius 0
  background transparent
  box-shadow none

.balancesExpandedLedger
  display flow-root
  width 100%
  box-sizing border-box
  overflow hidden
  border 1px solid var(--saf0o-border-default)
  border-radius 10px
  background linear-gradient(172deg, rgba(255, 255, 255, .022), transparent 46%), var(--saf0o-surface-card)
  backdrop-filter blur(10px)
  box-shadow 0 10px 26px rgba(0, 0, 0, .5), inset 1px 1px 0 rgba(150, 182, 150, .05), inset 0 1px 0 rgba(255, 255, 255, .05)

.signerBalanceWarning
  appearance none
  position relative
  width 100%
  padding var(--saf0o-space-3) 0
  border 0
  color var(--saf0o-text-secondary)
  background transparent
  font-family inherit
  text-align left
  cursor pointer

  &:hover
    color var(--saf0o-text-primary)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset -2px

.signerBalancesExpanded
  width 100%

.signerBalancesWrap
  min-height 76px
  margin 0 0 var(--saf0o-space-2)
  padding 0 var(--saf0o-space-3)
  box-sizing border-box
  overflow auto
  border 0
  border-radius 0
  background transparent
  box-shadow none
  position relative
  z-index 999

.balancesExpandedLedger > .cluster,
.balancesPreview > .cluster
  margin 0
  padding 0
  border 0
  border-radius 0
  background transparent

  .clusterRow
    gap 0

  .clusterRow + .clusterRow
    margin-top 0

  .clusterValue
    border 0
    border-bottom 1px solid var(--saf0o-ledger-rule)
    border-radius 0
    background transparent

  .clusterRow:last-child .clusterValue
    border-bottom 0

.balancesEmpty
  display flex
  align-items center
  justify-content center
  width 100%
  min-height 48px
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-small)
  font-weight 400

.signerBalanceWarningTitle
  position relative
  z-index 200000
  display flex
  align-items center
  height 24px
  color var(--saf0o-warning)
  font-size var(--saf0o-type-caption)
  font-weight 600
  letter-spacing .3px
  pointer-events none

.signerBalanceWarningMessage
  width 100%
  padding var(--saf0o-space-3) 0 0
  box-sizing border-box
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-small)
  font-weight 400
  line-height 1.45

.signerBalanceTotal
  position relative
  z-index 200000
  width 100%
  height 60px
  margin 0
  border-top 1px solid var(--saf0o-border-subtle)
  font-size var(--saf0o-type-small)

  .signerBalanceButtons
    display flex
    align-items center
    height 100%

  .signerBalanceButton
    z-index 4000
    height 44px
    min-height 44px
    margin-left var(--saf0o-space-3)

  .signerBalanceTotalText
    position absolute
    top 0
    right var(--saf0o-space-4)
    bottom 0
    left var(--saf0o-space-4)
    display flex
    align-items center
    justify-content flex-end
    pointer-events none

    .signerBalanceTotalLabel
      margin-right 6px
      color var(--saf0o-text-tertiary)
      font-family var(--saf0o-font-utility)
      font-size var(--saf0o-type-caption)
      font-weight 500

    .signerBalanceTotalValue
      display flex
      align-items center
      color var(--saf0o-text-primary)
      font-family var(--saf0o-font-mono)
      font-size var(--saf0o-type-body)
      font-weight 400
      letter-spacing -.4px

.signerBalancesLoading
  position relative
  z-index 200
  display flex
  width 100%
  min-height 88px
  box-sizing border-box
  align-items center
  justify-content center
  border 0
  background transparent

  .loader, .loader:after
    width 22px
    height 22px
    border-radius 50%

  .loader
    position relative
    border-top 3px solid var(--saf0o-border-subtle)
    border-right 3px solid var(--saf0o-border-subtle)
    border-bottom 3px solid var(--saf0o-border-subtle)
    border-left 3px solid var(--saf0o-accent-primary)
    font-size 7px
    text-indent -9999em
    transform translateZ(0)
    animation load8 .6s infinite linear
    will-change transform

.signerBalance
  position relative
  width 100%
  height 70px
  overflow hidden
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-ui)
  transition background var(--saf0o-motion-fast) var(--saf0o-ease)

  .signerBalanceLoading
    position absolute
    top 0
    bottom 0
    left 0
    width 400%
    background linear-gradient(90deg, transparent 25%, var(--saf0o-surface-hover) 50%, transparent 75%)
    transform translateX(-100%)
    animation sheenLoad 1.4s infinite linear
    will-change transform

  .signerBalanceInner
    position relative
    height 100%
    transition opacity var(--saf0o-motion-standard) var(--saf0o-ease)

  .signerBalanceCurrency
    position absolute
    top 25px
    right 53%
    left calc(var(--saf0o-space-4) + 40px)
    z-index 2
    overflow hidden
    display flex
    align-items center
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-small)
    font-weight 500
    text-overflow ellipsis
    white-space nowrap

  .signerBalanceChain
    position absolute
    top 8px
    left calc(var(--saf0o-space-4) + 40px)
    z-index 2
    display flex
    align-items center
    height 14px
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)
    font-weight 500
    letter-spacing .7px
    white-space nowrap

  .signerBalancePrice
    position absolute
    right var(--saf0o-space-3)
    bottom var(--saf0o-space-2)
    left calc(var(--saf0o-space-4) + 40px)
    display flex
    align-items center
    justify-content space-between
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)

  .signerBalanceOk,
  .signerBalanceCurrentValue,
  .signerBalanceCurrentPrice,
  .signerBalanceCurrentPriceChange
    display flex
    align-items center

  .signerBalanceCurrentPriceChange
    margin-left var(--saf0o-space-1)

  .signerBalanceCurrentPriceChangeUp
    color var(--saf0o-success)

  .signerBalanceCurrentPriceChangeDown
    color var(--saf0o-danger)

  .signerBalanceIcon
    position absolute
    top 19px
    left var(--saf0o-space-4)
    z-index 1
    width 32px
    height 32px
    display flex
    overflow visible
    align-items center
    justify-content center

  .signerBalanceValue
    position absolute
    top 22px
    right var(--saf0o-space-3)
    left 49%
    display flex
    align-items center
    justify-content flex-end
    min-width 0
    overflow hidden
    color var(--saf0o-text-primary)
    font-family var(--saf0o-font-mono)
    font-size 18px
    font-weight 400
    white-space nowrap

    .displayValue
      min-width 0
      max-width 100%

    .displayValueMain
      flex-shrink 0

    .displayValueSymbol
      min-width 0
      overflow hidden
      margin-right .36em
      color var(--saf0o-text-secondary)
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-caption)
      font-weight 600
      letter-spacing .3px
      text-overflow ellipsis
      white-space nowrap

    .signerBalancePrivateValue
      color var(--saf0o-text-muted)
      font-family var(--saf0o-font-mono)
      font-size 13px
      letter-spacing 1.4px

      span
        margin-left 2px
        font-family var(--saf0o-font-ui)
        font-size var(--saf0o-type-caption)
        font-weight 600
        letter-spacing .2px

  .signerBalancePrivatePrice
    width 100%
    color var(--saf0o-text-muted)
    text-align right
    letter-spacing 1.2px

@keyframes sheenLoad
  from
    transform translateX(-100%)
  to
    transform translateX(100%)
