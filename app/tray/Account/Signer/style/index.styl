.moduleItem
  position relative
  z-index 2000
  display flex
  flex 1
  align-items center
  justify-content center
  min-height 40px
  padding var(--saf0o-space-4)
  box-sizing border-box
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-small)
  font-weight 500
  text-transform none

.moduleItemSignerType
  display flex
  align-items center
  justify-content center
  color var(--saf0o-text-primary)
  font-size var(--saf0o-type-body)
  font-weight 500

.signerPreviewSummary
  display flex
  width 100%
  min-height 54px
  padding 0 var(--saf0o-space-4)
  box-sizing border-box
  align-items center
  justify-content space-between
  gap var(--saf0o-space-4)

  .moduleItemSignerType
    justify-content flex-start

.signerPreviewControl
  display grid
  width 100%
  min-height 52px
  grid-template-columns minmax(0, 1fr) 44px
  align-items stretch

.signerPreviewControlStatic
  grid-template-columns minmax(0, 1fr)

.signerPreviewDetails
  display grid
  min-width 0
  min-height 52px
  padding 0
  border 0
  color inherit
  background transparent
  font inherit
  text-align left
  grid-template-columns 112px minmax(0, 1fr)
  align-items center
  cursor pointer

  &:hover
    background var(--saf0o-ledger-hover)

  &:active
    background var(--saf0o-surface-active)

  &:focus-visible
    z-index 1
    outline 2px solid var(--saf0o-focus)
    outline-offset -2px

  &:disabled
    color var(--saf0o-text-disabled)
    cursor default
    opacity .7

.signerPreviewDetailsStatic
  cursor default

.signerPreviewVerify
  display grid
  align-self center
  width 44px
  min-width 44px
  min-height 44px
  margin var(--saf0o-space-1) 0
  padding 0
  border 0
  border-left 1px solid var(--saf0o-ledger-rule)
  color var(--saf0o-text-secondary)
  background transparent
  place-items center
  cursor pointer

  > svg
    display block

  &:hover
    color var(--saf0o-text-primary)
    background var(--saf0o-ledger-hover)

  &:active
    background var(--saf0o-surface-active)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset -2px

  &:disabled
    color var(--saf0o-text-disabled)
    cursor default
    opacity .7

.signerPreviewStatus
  color var(--saf0o-text-tertiary)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  font-weight 450
  white-space nowrap

.moduleItemIcon
  margin-right var(--saf0o-space-2)
  color var(--saf0o-accent-primary-hover)

.moduleItemInput
  padding var(--saf0o-space-2)
  overflow hidden

.moduleItemButton
  border 1px solid transparent
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-secondary)
  cursor pointer
  transition background var(--saf0o-motion-fast) var(--saf0o-ease), color var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease)

  *
    pointer-events none

  &:hover
    border-color var(--saf0o-border-subtle)
    color var(--saf0o-text-primary)
    background var(--saf0o-surface-hover)

  &:active
    background var(--saf0o-surface-active)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

  &:disabled
    color var(--saf0o-text-disabled)
    cursor default
    opacity .6

.moduleItemEditNameTitle
  position absolute
  top 28px
  left 30px
  right 0
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-caption)

.moduleItemEditName
  display flex
  width 100%
  overflow hidden

  input
    width 100%
    min-width 0
    padding var(--saf0o-space-3)
    border 1px solid var(--saf0o-border-default)
    border-radius var(--saf0o-radius-sm)
    color var(--saf0o-text-primary)
    background var(--saf0o-surface-inset)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-body)
    outline none

    &:hover
      background var(--saf0o-surface-hover)

    &:focus
      border-color var(--saf0o-focus)
      box-shadow 0 0 0 2px var(--saf0o-focus)

  .moduleItemInputSubmit
    margin-left var(--saf0o-space-2)
    padding 0 var(--saf0o-space-3)
    border 1px solid var(--saf0o-border-default)
    border-radius var(--saf0o-radius-sm)
    color var(--saf0o-text-secondary)
    background var(--saf0o-surface-card)
    box-sizing border-box
    cursor pointer
    transition background var(--saf0o-motion-fast) var(--saf0o-ease), color var(--saf0o-motion-fast) var(--saf0o-ease)

    *
      pointer-events none

    &:hover
      color var(--saf0o-text-primary)
      background var(--saf0o-surface-hover)

    &:active
      background var(--saf0o-surface-active)

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

.moduleItemSignerStatus
  display flex
  align-items center
  color var(--saf0o-text-secondary)
  font-family var(--saf0o-font-utility)

  span
    padding-left var(--saf0o-space-2)
