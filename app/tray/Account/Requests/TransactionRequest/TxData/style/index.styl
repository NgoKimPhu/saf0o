._txLabel
  position relative
  font-size var(--saf0o-type-caption)
  text-transform uppercase
  letter-spacing 2px
  padding var(--saf0o-space-4) 0px var(--saf0o-space-2) var(--saf0o-space-4)
  font-family 'MainFont'
  font-weight 500
  display flex
  align-items center

._txDataValue
  font-size var(--saf0o-type-lead)
  font-weight 400
  display flex
  justify-content center
  align-items center
  border-radius var(--saf0o-radius-sm)
  display flex
  justify-content center
  align-items center
  -webkit-app-region no-drag
  transition none
  pointer-events auto
  transform translate3d(0, 0, 0)
  font-family 'MainFont'
  padding var(--saf0o-space-2)
  background var(--ghostZ)

  svg
    position relative
    top -0px
    padding 0px 3px 0px var(--saf0o-space-1)

  span
    word-spacing 0px

  svg
    position relative
    top -2px
    padding 0px 0px

._txDataValue:hover
  background var(--ghostA)
  cursor pointer

._txDataValueMethod
  text-transform uppercase
  font-size var(--saf0o-type-body)
  letter-spacing 1px
  font-weight 300
  color var(--good)

._txDataValueContract
  text-transform uppercase
  font-size var(--saf0o-type-body)
  letter-spacing 1px
  font-weight 300
  color var(--moon)

._txData:hover
  z-index 1000001
