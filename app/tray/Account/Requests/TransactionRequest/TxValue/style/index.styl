.txSendingValue
  min-height 50px
  display flex
  justify-content center
  align-items center
  font-size var(--saf0o-type-sub)
  font-weight 300

._txMain
  position relative
  z-index 100001
  background var(--ghostAZ)
  margin 0px var(--saf0o-space-2) var(--saf0o-space-4) var(--saf0o-space-2)
  border-radius 26px
  overflow hidden
  box-shadow 0px 4px 8px var(--ghostY), 0px 2px 8px var(--ghostY)
  border-bottom 2px solid var(--ghostZ)
  padding 0

  ._txMainInner
    position relative
    margin 0px 0px
    overflow hidden

    ._txMainBackground
      position absolute
      top 0
      right 0
      bottom 0
      left 0
      opacity 0.05
      display none
    
  ._txMainTag
    position relative
    z-index 100001
    // animation-name cardShow
    // animation-duration 0.2s
    // animation-fill-mode both
    overflow hidden
    font-size var(--saf0o-type-caption)
    font-weight 400
    text-transform uppercase
    letter-spacing 1px
    text-align center
    padding var(--saf0o-space-2) 0px var(--saf0o-space-2) 0px
    margin-top 1px

  ._txMainTagWarning
    color var(--moon)

  ._txMainTagBad
    color var(--bad)
  
  ._txMainTagGood
    color var(--good)

// Saf0o transaction review
._txMain
  margin 0 0 var(--saf0o-space-3)
  padding 0
  overflow hidden
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-sm)
  background var(--saf0o-surface-card)
  box-shadow var(--saf0o-shadow-sm), var(--saf0o-shadow-inset)

  ._txMainInner
    overflow hidden

  ._txMainTag
    margin var(--saf0o-space-1) var(--saf0o-space-3) 0
    padding var(--saf0o-space-2) var(--saf0o-space-2)
    border-radius var(--saf0o-radius-sm)
    background var(--saf0o-bg-elevated)
    font-size var(--saf0o-type-caption)
    letter-spacing .3px
    text-transform none

  ._txMainTagWarning
    color var(--saf0o-warning)
    background var(--saf0o-warning-soft, #2c2418)

  ._txMainTagBad
    color var(--saf0o-danger)
    background var(--saf0o-danger-soft, #2d1b1a)

  ._txMainTagGood
    color var(--saf0o-success)
    background var(--saf0o-success-soft, #1b291b)
