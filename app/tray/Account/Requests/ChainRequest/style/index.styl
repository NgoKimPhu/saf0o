.requestChainInner
  display flex
  justify-content center
  align-items center
  flex-direction column
  transform translateZ(0px)
  padding 120px 0px 120px 0px
  margin var(--saf0o-space-4) var(--saf0o-space-1)
  border-radius 20px
  width calc(100% - 16px)
  box-sizing border-box
  background var(--ghostA)
  box-shadow 0px 6px 6px var(--ghostY)
  font-family 'MainFont'

.requestChainOrigin
  font-size var(--saf0o-type-heading)
  font-weight 300
  width 100%
  text-align center
  transform translateZ(0px)
  direction rtl
  text-overflow ellipsis
  white-space nowrap
  overflow hidden
  margin var(--saf0o-space-5) 0px var(--saf0o-space-1) 0px

.requestChainOrigin18
  font-size var(--saf0o-type-sub)

.requestChainOrigin12
  font-size var(--saf0o-type-small)

.requestChainOriginSub
  width 100%
  font-size var(--saf0o-type-small)
  font-weight 300
  text-transform uppercase
  width 100%
  text-align center
  margin 0px 0px var(--saf0o-space-2) 0px
  color var(--good)

.requestChainName
  width calc(100% - 10px)
  margin 0px 0px var(--saf0o-space-5) 0px
  box-sizing border-box
  border-radius var(--saf0o-radius-lg)
  text-align center
  background var(--ghostA)
  font-weight 300
  font-size var(--saf0o-type-title)
  padding var(--saf0o-space-2) 0px