.walletCallsRequestSummary
  padding 0 var(--saf0o-space-3) var(--saf0o-space-2)
  color var(--outerspace08)
  font-size var(--saf0o-type-caption)
  letter-spacing 1px
  text-transform uppercase

.walletCallsSurface
  position absolute
  inset 0
  box-sizing border-box
  padding var(--saf0o-space-4) var(--saf0o-space-8) var(--saf0o-space-6)
  overflow-y auto
  color var(--saf0o-text-primary)
  background transparent

  h2,
  h3,
  p
    margin 0

  h2
    margin-top 3px
    font-size var(--saf0o-type-heading)
    font-weight 660
    line-height 1.18

  h3
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-small)
    font-weight 650

  button,
  input
    font-family var(--saf0o-font-ui)

.walletCallsSummary
  display grid
  min-height 78px
  padding 2px 0 var(--saf0o-space-3)
  grid-template-columns minmax(0, 1fr) 220px
  gap var(--saf0o-space-6)
  align-items end

  p
    margin-top var(--saf0o-space-2)
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-small)
    line-height 1.45

.walletCallsAtomicWarning
  padding-left var(--saf0o-space-4)
  border-left 1px solid var(--saf0o-warning)

  strong,
  span
    display block

  strong
    display flex
    color var(--saf0o-warning)
    font-size var(--saf0o-type-small)
    font-weight 650
    align-items center
    gap var(--saf0o-space-2)

  span
    margin-top var(--saf0o-space-2)
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-caption)
    line-height 1.45

.walletCallsSection
  padding var(--saf0o-space-3) 0
  border-top 0

  > h3
    margin-bottom var(--saf0o-space-3)

.walletCallsReviewActions .requestActionButtons
  margin-left auto

.walletCallsSectionHeading
  display flex
  margin-bottom var(--saf0o-space-2)
  justify-content space-between
  align-items baseline
  gap var(--saf0o-space-4)

  > span
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)

.walletCallsSimulationState-success
  color var(--saf0o-success) !important

.walletCallsSimulationState-warning
  color var(--saf0o-warning) !important

.walletCallsSimulationState-danger
  color var(--saf0o-danger) !important

.walletCallsList,
.walletCallsAdjustList
  gap 0
  border-bottom 0

.walletCall
  display grid
  min-height 70px
  padding var(--saf0o-space-3) 0
  border-top 0
  border-radius 0
  box-sizing border-box
  background transparent
  box-shadow none
  grid-template-columns minmax(0, 1fr)
  gap var(--saf0o-space-3)
  align-items start

  &:hover
    background linear-gradient(90deg, transparent, rgba(255, 255, 255, .016) 10%, rgba(255, 255, 255, .016) 90%, transparent)

.walletCallsCallNumber
  padding-top 2px
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  font-weight 550

.walletCallsCallBody
  min-width 0

.walletCallsDestination
  display block
  width 100%
  min-width 0
  padding 0
  min-height 44px
  border 0
  color inherit
  background transparent
  text-align left

  strong,
  span
    display block

  strong
    overflow hidden
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-body)
    font-weight 640
    text-overflow ellipsis
    white-space nowrap

  span
    margin-top var(--saf0o-space-1)
    overflow hidden
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)
    text-overflow ellipsis
    white-space nowrap

  &:not(:disabled)
    cursor copy

  &:not(:disabled):hover span
    color var(--saf0o-accent-primary-hover)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 3px

.walletCallsCallEvidence
  display flex
  margin-top var(--saf0o-space-2)
  color var(--saf0o-text-secondary)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  flex-wrap wrap
  align-items center
  gap var(--saf0o-space-2) var(--saf0o-space-3)

  button
    display inline-flex
    min-height 44px
    padding 0 var(--saf0o-space-2)
    border 0
    color var(--saf0o-text-secondary)
    background transparent
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)
    align-items center

    &:hover
      color var(--saf0o-accent-primary-hover)

.walletCallsCalldata
  margin-top var(--saf0o-space-2)
  padding var(--saf0o-space-2) var(--saf0o-space-3)
  overflow-wrap anywhere
  color var(--saf0o-text-tertiary)
  background var(--saf0o-surface-inset)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  line-height 1.5
  box-shadow inset 0 1px 2px rgba(0, 0, 0, .32)

.walletCallsCallWarning,
.walletCallsEvidenceWarning,
.walletCallsAdjustError
  color var(--saf0o-warning)
  font-size var(--saf0o-type-caption)
  line-height 1.45

.walletCallsCallWarning
  margin-top var(--saf0o-space-2)

.walletCallsTargetDelegation
  margin-top var(--saf0o-space-2)
  color var(--saf0o-warning)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  line-height 1.45

  strong,
  span
    display block

  strong
    font-weight 620

  span
    margin-top 3px
    overflow-wrap anywhere
    color var(--saf0o-text-secondary)

.walletCallsTargetDelegation-danger
  color var(--saf0o-danger)

.walletCallsEvidenceWarning
  display flex
  padding var(--saf0o-space-3) 0
  border-top 0
  align-items flex-start
  gap var(--saf0o-space-2)

.walletCallsEvidenceWarning-danger
  color var(--saf0o-danger)

.walletCallsAdjustSummary
  min-height 108px
  padding var(--saf0o-space-3) 0 var(--saf0o-space-4)

  h2
    margin 0

  .walletCallsAdjustControls
    display grid
    margin-top var(--saf0o-space-3)
    grid-template-columns var(--saf0o-review-label-column) minmax(0, 1fr)
    align-items end
    gap var(--saf0o-space-4)

  p
    max-width 400px
    margin-top var(--saf0o-space-2)
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-caption)
    line-height 1.5

.walletCallsAdjustTotal
  display grid
  grid-template-rows auto 44px
  row-gap var(--saf0o-space-1)
  text-align left

  span,
  strong
    display block

  span
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)

  strong
    display flex
    align-items center
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-body)

.walletCallsAdjustNonce
  display flex
  min-width 0
  flex-direction column
  align-items stretch

  > span
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)

.walletCallsNonceInput.saf0oInput
  width 100%
  height 44px
  margin-top var(--saf0o-space-1)
  padding 0 var(--saf0o-space-2)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-small)
  text-align right

.walletCallsAdjustCall
  display grid
  padding var(--saf0o-space-4) 0 var(--saf0o-space-4)
  border-top 0
  grid-template-columns 30px minmax(0, 1fr)
  gap var(--saf0o-space-3)

.walletCallsMethod
  padding 1px var(--saf0o-space-1)
  border-radius 4px
  color var(--saf0o-text-primary)
  background var(--saf0o-surface-inset)
  font-weight 620

// Beats `.walletCallsDestination span`, which would make the badge a block on its own line.
.walletCallsDestination .walletCallsCallNumber
  display inline-flex
  margin 0 var(--saf0o-space-2) 0 0
  vertical-align middle
  width 24px
  height 24px
  border 1px solid var(--saf0o-border-subtle)
  border-radius 50%
  color var(--saf0o-text-secondary)
  background var(--saf0o-surface-inset)
  align-items center
  justify-content center
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  font-weight 620

.walletCallsAdjustCallHeader
  display flex
  justify-content space-between
  gap var(--saf0o-space-4)

  > div:first-child
    min-width 0

    strong
      display block

    strong
      overflow hidden
      font-size var(--saf0o-type-body)
      font-weight 640
      text-overflow ellipsis
      white-space nowrap

.walletCallsDestinationAddress
  margin-top var(--saf0o-space-1)
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  overflow-wrap anywhere
  white-space normal

  .clusterAddressRecipient,
  .clusterAddressRecipient span
    display inline
    margin 0
    overflow visible
    color inherit
    font-family inherit
    font-size inherit
    text-overflow clip
    white-space normal

  .clusterAddressRecipientFull
    display none

  .clusterAddressLookalikeEnd
    color var(--saf0o-warning)

.walletCallsAdjustFields
  display grid
  margin-top var(--saf0o-space-3)
  grid-template-columns repeat(3, minmax(108px, 1fr))
  gap var(--saf0o-space-2)
  align-items end

  label > span:first-child
    display block
    margin-bottom var(--saf0o-space-2)
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-caption)

  label > input,
  .walletCallsUnitInput
    display flex
    height 46px
    box-sizing border-box

  label > input
    width 100%
    height 44px
    padding 0 var(--saf0o-space-2)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)

.walletCallsUnitInput
  align-items center

  input
    min-width 0
    width 100%
    height 100%
    padding 0 var(--saf0o-space-1) 0 var(--saf0o-space-2)
    border 0
    color var(--saf0o-text-primary)
    background transparent
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)

    &:focus
      outline 0

  em
    padding-right var(--saf0o-space-2)
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)
    font-style normal

.walletCallsAdjustError
  margin-top var(--saf0o-space-3)
  color var(--saf0o-danger)

.walletCallsAdjustActions .walletCallsCancelButton
  color var(--saf0o-text-secondary)

.walletCallsSimulationAcknowledgement
  min-height 150px
  height auto

  .requestActionContext
    align-items flex-start

  .requestActionContextIcon
    margin-top 2px
    color var(--saf0o-warning)

  .walletCallsSimulationAcknowledgementCheck
    display flex
    margin-top var(--saf0o-space-2)
    color var(--saf0o-text-secondary)
    align-items flex-start
    gap var(--saf0o-space-2)

    input
      flex none
      margin 2px 0 0
      accent-color var(--saf0o-accent-primary)

    span
      margin 0
      color var(--saf0o-text-secondary)

  .requestDecline
    flex-basis 92px
    width 92px
    min-width 92px
    max-width 92px

  .requestSign
    flex-basis 220px
    width 220px
    min-width 220px
    max-width 220px

.walletCallsTerminalActions .requestActionContextIcon
  color var(--saf0o-text-muted)

@container panel (max-width: 610px)
  .walletCallsSurface
    padding-right var(--saf0o-space-6)
    padding-left var(--saf0o-space-6)

  .walletCallsSummary
    grid-template-columns minmax(0, 1fr) 205px
    gap var(--saf0o-space-5)

  .walletCallsAdjustFields
    grid-template-columns repeat(2, minmax(110px, 1fr))

  .walletCallsSimulationAcknowledgement
    .requestDecline,
    .requestSign
      width 100%
      min-width 0
      max-width none
