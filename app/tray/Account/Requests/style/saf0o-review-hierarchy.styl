// Shared signing hierarchy: context, consequence, identities, details, decision.
.signingReviewContext
  display flex
  min-height 32px
  align-items center
  justify-content space-between
  gap var(--saf0o-space-4)
  margin-bottom var(--saf0o-space-5)
  color var(--saf0o-text-secondary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-body)
  line-height 20px

.signingReviewOrigin
  display flex
  min-width 0
  align-items center
  gap var(--saf0o-space-2)
  overflow-wrap anywhere
  font-weight 550

.signingReviewNetwork
  flex 0 1 auto
  min-width 0
  max-width 46%
  color var(--saf0o-text-muted)
  font-size var(--saf0o-type-small)
  text-align right
  overflow-wrap anywhere

.signingReviewLabel,
.signingReviewTechnical
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-small)
  line-height 20px

.signingReviewTechnical
  margin var(--saf0o-space-3) 0

.signingReviewAddressRow
  position relative
  display grid
  grid-template-columns 112px minmax(0, 1fr)
  align-items center
  gap var(--saf0o-space-3)
  padding var(--saf0o-space-2) 0

  &:not(:has(> .signingReviewLabel))
    grid-template-columns minmax(0, 1fr)

.signingReviewAddress
  appearance none
  display flex
  min-width 0
  min-height 32px
  align-items center
  gap var(--saf0o-space-2)
  padding var(--saf0o-space-1) 0
  border 0
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-secondary)
  background transparent
  text-align left
  cursor pointer

  .clusterAddress
    min-width 0
    flex 1 1 auto

  > svg
    flex none
    color var(--saf0o-text-muted)

  &:hover
    background var(--saf0o-surface-hover)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

.signingReviewCopyStatus
  position absolute
  width 1px
  height 1px
  overflow hidden
  clip-path inset(50%)

.signingReviewDetails
  margin var(--saf0o-space-3) 0 var(--saf0o-space-5)
  padding 0

  > summary
    display flex
    min-height 44px
    align-items center
    justify-content space-between
    gap var(--saf0o-space-3)
    padding var(--saf0o-space-2) 0
    border-radius var(--saf0o-radius-sm)
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-body)
    line-height 20px
    list-style none
    cursor pointer

    &::-webkit-details-marker
      display none

    &:hover
      background var(--saf0o-surface-hover)

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

  &[open] > summary > svg
    transform rotate(90deg)

.signingReviewDetailsBody
  padding var(--saf0o-space-2) 0 var(--saf0o-space-3)

.approveTransaction
  font-family var(--saf0o-font-ui)
  padding var(--saf0o-space-2) var(--saf0o-space-6) var(--saf0o-space-6)
  overflow-y auto
  scrollbar-gutter stable both-edges

  .transactionReviewMain
    .transactionReviewOverview > .clusterRow:first-child .clusterValue,
    ._txDescription
      min-height 0

    ._txDescription
      padding 0 0 var(--saf0o-space-5)

    ._txDescriptionSummary
      display block

    ._txDescriptionSummaryMain
      font-family var(--saf0o-font-ui)
      padding 0
      font-size var(--saf0o-type-title)
      line-height 32px

    .transactionReviewStatusRow
      border 0

    .transactionReviewSummaryStatus
      padding var(--saf0o-space-1) 0 var(--saf0o-space-3)

  .transactionReviewRecipient > ._txMainInner > ._txLabel
    display none

  .transactionReviewRecipient .clusterValue
    min-height 48px

  .transactionReviewMetaLabel
    font-family var(--saf0o-font-ui)

  .transactionReviewTokenApproval
    padding var(--saf0o-space-4) var(--saf0o-space-5)
    margin 0 0 var(--saf0o-space-5)
    border 1px solid var(--saf0o-border-subtle)
    border-radius var(--saf0o-radius-md)
    background var(--saf0o-surface-card)

    > ._txMainInner > ._txLabel
      display none

    .clusterRow,
    .clusterValue
      border 0
      background transparent

    .transactionReviewApprovalLimit
      display grid
      grid-template-columns minmax(0, 1fr) auto
      gap var(--saf0o-space-1) var(--saf0o-space-4)
      padding 0 0 var(--saf0o-space-4)

      > .transactionReviewMetaLabel
        grid-column 1

      > strong
        grid-column 1
        font-size var(--saf0o-type-title)
        line-height 34px
        overflow-wrap anywhere

      > .transactionReviewApprovalAdjust
        grid-column 2
        grid-row 1 / span 2
        align-self center

    .transactionReviewApprovalSpender
      grid-template-columns 112px minmax(0, 1fr)
      padding var(--saf0o-space-1) 0

  .transactionReviewAssetChanges
    margin 0 0 var(--saf0o-space-5)

  .transactionReviewAssetChangesInner
    padding var(--saf0o-space-4) var(--saf0o-space-5)

  .transactionReviewAssetChangesHeader
    margin-bottom var(--saf0o-space-2)

  .transactionReviewAssetChange
    min-height 62px

  .transactionReviewAssetChangeIdentity
    font-size var(--saf0o-type-lead)

  .transactionReviewAssetChangeAmount
    font-size var(--saf0o-type-heading)
    line-height 30px

    .displayValue
      font-size inherit

  .transactionReviewFee,
  .transactionReviewNonce
    margin 0

  .transactionReviewNonceHint
    display none

  .transactionReviewDataRow
    margin-top var(--saf0o-space-3)

  .transactionDataDisclosure
    color var(--saf0o-text-secondary)

  .signingReviewDetails .transactionReviewFeeSubline
    display flex

.approveTransaction,
.signingReview,
.signingDecisionSummary,
.walletCallsReview
  .clusterAddressRecipient,
  .clusterAddressRecipientComplete,
  .clusterAddressEvidence,
  .clusterFira
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-caption)
    line-height 19px
    overflow-wrap anywhere

  .clusterAddressRecipientFullNoHover
    display none

.signingDecisionShelf
  display grid
  gap var(--saf0o-space-2)
  min-height 114px
  padding var(--saf0o-space-4) var(--saf0o-space-6) var(--saf0o-space-5)
  background var(--saf0o-bg-subtle)
  color var(--saf0o-text-primary)

  .signingDecisionAccount
    display flex
    align-items center
    justify-content space-between
    min-height 24px
    gap var(--saf0o-space-4)
    font-size var(--saf0o-type-small)

    > strong
      min-width 0
      overflow hidden
      white-space nowrap
      text-overflow ellipsis
      font-weight 550

  .signingDecisionSummary > .signingReviewAddressRow
    padding 0
    margin-bottom var(--saf0o-space-1)

    .signingReviewAddress
      justify-content flex-end

    .clusterAddress
      flex 0 1 auto

    .clusterAddressRecipient
      display inline

  .signingReviewLabel
    flex none
    font-size var(--saf0o-type-caption)

  .requestNotice,
  .requestNoticeInner
    display block
    width 100%
    height auto
    min-height 0
    margin 0
    padding 0
    border 0
    background transparent
    box-shadow none

  .requestApprove
    display grid
    grid-template-columns minmax(0, 1fr)
    min-height 44px
    height auto
    width 100%
    margin 0
    padding 0
    border 0
    border-radius 0
    background transparent
    box-shadow none
    animation none
    gap var(--saf0o-space-2)

  .requestActionContext
    width 100%
    min-height 0
    margin 0
    padding 0

    &:has(.requestActionContextCopy > strong:empty):not(:has(.requestActionError))
      display none

  .requestActionContextCopy > strong:empty
    display none

  .requestActionButtons
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    width 100%
    gap var(--saf0o-space-3)

    > button
      position relative
      inset auto
      flex none
      width 100%
      min-width 0
      max-width none
      min-height 44px

.signingDecisionFee
  display flex
  min-height 32px
  align-items center
  gap var(--saf0o-space-3)
  color var(--saf0o-text-primary)
  font-size var(--saf0o-type-small)

.signingDecisionFeeValue
  min-width 0
  margin-left auto
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-caption)

.signingDecisionFeeAdjust
  appearance none
  flex none
  min-height 32px
  padding var(--saf0o-space-1) 0 var(--saf0o-space-1) var(--saf0o-space-1)
  border 0
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-secondary)
  background transparent
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-small)
  cursor pointer

  &:hover
    background var(--saf0o-surface-hover)

.signingReviewAcknowledgements
  margin var(--saf0o-space-4) 0

// The parent class outranks the footer's .approveTransactionWarning rules (same specificity
// otherwise, so bundle order let the footer's height 100% and fixed rows stretch this card).
.signingReviewAcknowledgements .signingReviewAcknowledgement.approveTransactionWarning
  box-sizing border-box
  height auto
  margin 0 0 var(--saf0o-space-3)
  padding var(--saf0o-space-3) var(--saf0o-space-4)
  border 1px solid rgba(221, 180, 103, .18)
  border-radius var(--saf0o-radius-sm)
  background var(--saf0o-warning-soft)

  .approveTransactionWarningBody
    display grid
    height auto
    grid-template-rows none
    gap var(--saf0o-space-2)
    padding 0

  .approveTransactionWarningTitle
    display flex
    align-items center
    gap var(--saf0o-space-2)
    margin 0
    padding 0
    color var(--saf0o-warning)
    font-size var(--saf0o-type-body)
    line-height 20px
    text-transform none

  .approveTransactionWarningIcon
    display flex
    width 20px
    height 20px
    margin 0

    svg
      width 20px
      height 20px

  .approveTransactionWarningMessage
    margin 0
    padding 0
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-small)
    line-height 19px
    text-align left

  .approveTransactionWarningActions
    display flex
    justify-content flex-start
    margin 0
    padding 0

    // Acknowledgements are signing decisions: the 44px minimum touch target applies.
    .saf0oControl
      min-height 44px

.signingReviewAcknowledgementError
  color var(--saf0o-danger)
  font-size var(--saf0o-type-small)

.signingReview
  width auto
  margin 0
  padding var(--saf0o-space-2) var(--saf0o-space-6) var(--saf0o-space-6)

  .typedDataReviewSummary
    display block
    padding 0 0 var(--saf0o-space-5)

  .typedDataReviewTitle
    margin 0
    font-size var(--saf0o-type-title)
    line-height 32px

  .simpleJsonHeader
    border 0
    padding var(--saf0o-space-3) 0 var(--saf0o-space-2)

  .simpleJson > .simpleJsonChild
    padding var(--saf0o-space-2) 0
    grid-template-columns 128px minmax(0, 1fr)

  .signingRawDisclosure
    border 0

    > summary
      padding-right 0
      padding-left 0

  .signingAuthorityCopy
    appearance none
    border 0
    border-radius var(--saf0o-radius-sm)
    background transparent
    font-family var(--saf0o-font-mono)
    text-align left
    cursor pointer
    display flex
    align-items center
    gap var(--saf0o-space-2)
    width 100%
    min-width 0
    min-height 32px
    padding var(--saf0o-space-1) 0
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-caption)
    line-height 19px
    word-break break-all

    > svg
      flex none
      color var(--saf0o-text-muted)

    &:hover
      background var(--saf0o-surface-hover)

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

  .signingPermissionList
    display grid
    gap var(--saf0o-space-4)
    margin-top var(--saf0o-space-4)

  .signingPermissionRow
    display block
    padding 0
    border 0

  .signingPermissionTokenHeader
    display flex
    align-items baseline
    justify-content space-between
    gap var(--saf0o-space-4)

    > strong
      color var(--saf0o-text-primary)
      font-size var(--saf0o-type-lead)

    > div
      min-width 0
      max-width 70%
      overflow-wrap anywhere
      text-align right

      > strong
        font-family var(--saf0o-font-mono)
        font-size var(--saf0o-type-body)
        line-height 22px

  .signingPermissionExpiration
    margin-top var(--saf0o-space-2)

  .signingAuthorityFacts > div
    display grid
    grid-template-columns 112px minmax(0, 1fr)
    align-items center
    gap var(--saf0o-space-3)
    padding var(--saf0o-space-2) 0

  .signMessageRaw
    margin 0 0 var(--saf0o-space-4)
    padding var(--saf0o-space-4) var(--saf0o-space-5)
    border 1px solid var(--saf0o-border-subtle)
    border-radius var(--saf0o-radius-md)
    background var(--saf0o-surface-card)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-lead)
    line-height 25px

.signingPermissionCard
  padding var(--saf0o-space-4) var(--saf0o-space-5)
  margin 0 0 var(--saf0o-space-5)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-md)
  background var(--saf0o-surface-card)

.signingAuthorityLabel
  display block
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-small)
  font-weight 400
  line-height 20px

.signingPermissionDates
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--saf0o-space-4)
  margin-top var(--saf0o-space-4)

  strong
    display block
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-small)
    line-height 20px

.signingPermitReview
  .signingReviewTitle
    margin 0 0 var(--saf0o-space-5)
    font-size var(--saf0o-type-title)
    line-height 32px

  .signingPermitLimit
    display flex
    min-width 0
    align-items center
    justify-content space-between
    gap var(--saf0o-space-4)
    margin-bottom var(--saf0o-space-4)

    > div
      min-width 0

      > strong
        display block
        margin-top var(--saf0o-space-1)
        font-size var(--saf0o-type-title)
        line-height 34px
        overflow-wrap anywhere

.signingReviewDataLink
  appearance none
  display flex
  min-height 44px
  width 100%
  align-items center
  justify-content space-between
  gap var(--saf0o-space-3)
  margin-top var(--saf0o-space-3)
  padding var(--saf0o-space-2) 0
  border 0
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-secondary)
  background transparent
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-body)
  cursor pointer

  &:hover
    background var(--saf0o-surface-hover)

.walletCallsReview
  font-family var(--saf0o-font-ui)
  padding var(--saf0o-space-2) var(--saf0o-space-6) var(--saf0o-space-6)
  scrollbar-gutter stable both-edges

  .walletCallsSummary
    min-height 0
    padding 0 0 var(--saf0o-space-5)
    grid-template-columns minmax(0, 1fr)
    gap var(--saf0o-space-3)

    h2
      margin 0
      font-size var(--saf0o-type-title)
      line-height 32px

    p
      color var(--saf0o-text-muted)
      font-size var(--saf0o-type-small)

  .walletCallsAtomicWarning
    padding-left 0
    border 0

  .walletCallsCallEvidence
    margin-top var(--saf0o-space-2)

  .walletCallsDestinationAddress
    font-size var(--saf0o-type-caption)

#panel:has(.signingDecisionShelf)
  .footerModule
    height auto !important

  .accountViewRequest
    bottom var(--saf0o-measured-footer-height, 192px) !important
    transition none

@media (max-height: 800px)
  .signingReviewContext
    margin-bottom var(--saf0o-space-4)

  .signingPermissionCard
    padding var(--saf0o-space-3) var(--saf0o-space-4)
    margin-bottom var(--saf0o-space-4)

  .signingReview .signingPermissionList
    gap var(--saf0o-space-3)

@container panel (max-width: 480px)
  .signingReviewAddressRow,
  .signingReview .signingAuthorityFacts > div
    grid-template-columns minmax(0, 1fr)
    gap 0

  .signingDecisionAccount
    align-items start
    flex-direction column
    gap var(--saf0o-space-1)

  .signingPermissionDates
    grid-template-columns minmax(0, 1fr)

.approveTransaction
  .clusterValueClickable .clusterAddressRecipient,
  .clusterValueClickable .clusterAddressEvidence
    color var(--saf0o-text-secondary)

  .transactionReviewRecipient .clusterAddress,
  .transactionReviewApprovalSpender .clusterAddress
    display grid
    grid-template-columns minmax(0, 1fr) 16px
    align-items center
    gap var(--saf0o-space-2)

    .addressSafetyStatus,
    .addressReputation
      grid-column 1 / -1

  .clusterAddress .clusterAddressRecipientFullNoHover
    display none

.signingReviewCopyIcon
  display flex
  align-items center
  color var(--saf0o-text-muted)

.signingDecisionFeeAdjust:focus-visible,
.signingReviewDataLink:focus-visible
  outline 2px solid var(--saf0o-focus)
  outline-offset 2px

.accountViewScroll:has(> .signingReview)
  scrollbar-gutter stable both-edges

.signingAuthorizationAmount
  margin var(--saf0o-space-3) 0

  .signingTokenAmountFormatted,
  > div > strong
    display block
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-title)
    line-height 34px
    overflow-wrap anywhere
