.eip7702RevokeRequest
  min-height 100%
  color var(--saf0o-text-primary)
  background transparent

.eip7702RevokeDocument
  width 100%
  box-sizing border-box
  // 30px = the 24px page gutter plus the 6px scrollbar gutter the signing reviews reserve.
  padding var(--saf0o-space-4) calc(var(--saf0o-space-6) + 6px) var(--saf0o-space-6)

.eip7702RevokeSummary
  padding 0 0 var(--saf0o-space-4)

  h1
    margin 0 0 var(--saf0o-space-2)
    font-family var(--saf0o-font-heading)
    font-size var(--saf0o-type-heading)
    font-variation-settings var(--saf0o-font-heading-settings)
    font-weight 620
    line-height 1.25

  p
    margin 0
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-small)
    line-height 1.55
    overflow-wrap anywhere

.eip7702RevokeSection
  padding 0

  & + &
    margin-top var(--saf0o-space-4)

  > h2
    margin 0 0 var(--saf0o-space-2)
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-caption)
    font-weight 600

.eip7702RevokeFacts
  margin 0

  > div
    display grid
    grid-template-columns var(--saf0o-review-label-column) minmax(0, 1fr)
    gap var(--saf0o-space-3)
    align-items start
    box-sizing border-box
    padding 0

    & + div
      margin-top var(--saf0o-space-4)

  dt
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-caption)
    line-height 1.45

  dd
    min-width 0
    margin 0
    font-size var(--saf0o-type-small)
    line-height 1.45
    overflow-wrap anywhere

.eip7702RevokeIdentity
  dd
    display flex
    min-width 0
    flex-direction column
    gap var(--saf0o-space-1)

  small
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    overflow-wrap anywhere

.eip7702RevokeIdentityName
  font-weight 560

.eip7702RevokeIdentity .lightweightRequestCopy,
.eip7702RevokeEvidence .lightweightRequestCopy
  display flex
  width 100%
  min-height 44px
  margin -6px 0
  padding var(--saf0o-space-1) 0
  align-items center
  justify-content flex-start
  border 1px solid transparent
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-secondary)
  background transparent
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-caption)
  line-height 1.45
  overflow-wrap anywhere
  text-align left

  &:hover
    border-color var(--saf0o-border-subtle)
    background var(--saf0o-ledger-hover)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

  .lightweightRequestCopyValue
    min-width 0
    overflow-wrap anywhere

  .lightweightRequestCopyFeedback
    margin-left auto
    padding-left var(--saf0o-space-2)
    color var(--saf0o-success)

.eip7702RevokeEvidence
  .eip7702RevokeMono
    overflow hidden
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    text-overflow ellipsis
    white-space nowrap

.eip7702RevokeEvidenceDisclosure
  box-shadow none

  .eip7702RevokeEvidenceSummary
    appearance none
    display flex
    width 100%
    min-height 48px
    padding var(--saf0o-space-2) 0
    box-sizing border-box
    border 0
    color var(--saf0o-text-primary)
    background transparent
    align-items center
    justify-content space-between
    gap var(--saf0o-space-3)
    cursor pointer
    text-align left

    > span:first-child
      min-width 0

    strong
      display block
      font-size var(--saf0o-type-caption)
      font-weight 600

    > span:last-child
      flex none
      color var(--saf0o-text-secondary)
      font-size var(--saf0o-type-caption)

      &::after
        content ' +'
        color var(--saf0o-accent-primary-hover)

    &:hover > span:last-child
      color var(--saf0o-text-primary)

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

  &.eip7702RevokeEvidenceDisclosure-open
    padding-bottom var(--saf0o-space-2)

    .eip7702RevokeEvidenceSummary > span:last-child::after
      content ' −'

.eip7702RevokeFee
  padding var(--saf0o-space-2) 0 var(--saf0o-space-3)

.eip7702RevokeFeeRow
  display grid
  grid-template-columns var(--saf0o-review-label-column) minmax(0, 1fr) auto
  grid-template-rows auto auto
  align-items center
  gap 2px var(--saf0o-space-4)
  min-height 52px
  padding var(--saf0o-space-1) 0 var(--saf0o-space-2)

  > span:first-child
    display contents

    strong
      grid-column 1
      grid-row 1 / 3
      align-self center
      color var(--saf0o-text-tertiary)
      font-size var(--saf0o-type-caption)
      font-weight 400

    small
      grid-column 2
      grid-row 2
      color var(--saf0o-text-secondary)
      font-size var(--saf0o-type-caption)
      line-height 1.4

  > button
    grid-column 3
    grid-row 1 / 3
    align-self center
    min-height 44px

.eip7702RevokeFeeAmount
  grid-column 2
  grid-row 1
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-body)
  font-weight 550

.eip7702RevokeFeeUpdated
  color var(--saf0o-success)
  font-size var(--saf0o-type-caption)

.eip7702RevokeFeeBody .txFeeOverlay
  margin-top var(--saf0o-space-2)

.eip7702RevokeFeeBody .txAdjustFeeInline
  padding-left 0

.eip7702RevokeOutcome
  display flex
  margin-top var(--saf0o-space-4)
  padding var(--saf0o-space-3)
  border-left 3px solid var(--saf0o-border-strong)
  color var(--saf0o-text-secondary)
  background var(--saf0o-surface-inset)
  flex-direction column
  gap var(--saf0o-space-1)
  font-size var(--saf0o-type-caption)
  line-height 1.5

  strong
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-small)

.eip7702RevokeRequest-verified .eip7702RevokeOutcome
  border-left-color var(--saf0o-success)

.eip7702RevokeRequest-changed .eip7702RevokeOutcome,
.eip7702RevokeRequest-unclear .eip7702RevokeOutcome,
.eip7702RevokeRequest-unverified .eip7702RevokeOutcome,
.eip7702RevokeRequest-unavailable .eip7702RevokeOutcome
  border-left-color var(--saf0o-warning)

.eip7702RevokeHash
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-caption)

.eip7702RevokeRequestSummary
  padding var(--saf0o-space-2) var(--saf0o-space-3) var(--saf0o-space-3)
  color var(--saf0o-text-secondary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-caption)

  > span
    font-family var(--saf0o-font-mono)

.eip7702StopMonitoringDialog
  min-height 168px
  height auto
  padding var(--saf0o-space-4) var(--saf0o-space-5)
  grid-template-columns minmax(0, 1fr)
  align-items start
  gap var(--saf0o-space-3)

  .requestActionContext
    align-items flex-start

  .requestActionButtons
    display grid
    width 100%
    grid-template-columns repeat(2, minmax(0, 1fr))
    align-items center

  .requestDecline,
  .requestSign
    width 100%
    min-width 0
    max-width none
    flex-basis auto

.eip7702RevokeActionsReview
  min-height 86px
  height 86px
  grid-template-columns 1fr

  .requestActionButtons
    justify-self end

.eip7702RevokeActions
  .requestActionContextCopy strong
    white-space nowrap

  .requestDecline
    flex-basis 100px
    width 100px
    min-width 100px
    max-width 100px

  .requestSign
    flex-basis 156px
    width 156px
    min-width 156px
    max-width 156px

@container panel (max-width: 600px)
  .eip7702RevokeFacts > div
    grid-template-columns 1fr
    gap var(--saf0o-space-1)

  .eip7702RevokeSummary h1
    font-size var(--saf0o-type-sub)

  .eip7702RevokeFeeRow
    grid-template-columns 1fr auto

    > span:first-child
      strong
        grid-column 1
        grid-row 1

      small
        grid-column 1 / -1
        grid-row 2

    .eip7702RevokeFeeAmount
      grid-column 2

    > button
      grid-column 2
      grid-row 3
      justify-self end
      width auto
      min-height 32px
      margin-top var(--saf0o-space-1)

@container panel (max-width: 560px)
  .eip7702StopMonitoringDialog
    .requestDecline,
    .requestSign
      width 100%
      min-width 0
      max-width none

@media (max-height: 760px)
  .eip7702RevokeDocument
    padding-top var(--saf0o-space-3)

  .eip7702RevokeSection
    padding var(--saf0o-space-3) 0
