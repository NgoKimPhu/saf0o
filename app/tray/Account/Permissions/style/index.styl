.clearPermissionsButton
  display grid
  min-height 60px
  padding var(--saf0o-space-2) var(--saf0o-space-3)
  align-items center
  gap var(--saf0o-space-3)
  grid-template-columns minmax(0, 1fr) auto
  border-top 1px solid var(--saf0o-border-subtle)

.clearPermissionsSummary
  min-width 0
  display grid
  gap 2px

  strong
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-small)
    font-weight 550
    line-height 18px

  span
    color var(--saf0o-text-tertiary)
    font-size var(--saf0o-type-caption)
    line-height 18px

.clearPermissionsConfirm
  display flex
  grid-column 1 / -1
  flex-direction column
  gap var(--saf0o-space-2)

.clearPermissionsCopy
  strong
    display block
    color var(--saf0o-text-primary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-body)
    font-weight 600

  p
    margin var(--saf0o-space-2) 0 0
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-small)
    line-height 20px

.clearPermissionsActions
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--saf0o-space-2)

.clearPermissionsAction
  width auto

button.saf0oControl.clearPermissionsAction
  min-height 44px

.clearPermissionsButton > button.saf0oControl.clearPermissionsAction
  min-width 88px
  color var(--saf0o-text-tertiary)

  &:hover:not(:disabled)
    color var(--saf0o-danger)

.clearPermissionsActions .clearPermissionsAction
  flex 1

.clearPermissionsStatus
  padding var(--saf0o-space-3)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-secondary)
  background var(--saf0o-surface-inset)
  font-size var(--saf0o-type-small)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

.signerPermissionControls .saf0oToggle
  margin-top 0

.revokeAccessButton
  flex none
  padding 0

button.saf0oControl.revokeAccessButton
  min-width 68px
  min-height 44px
  padding 0
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-caption)
  font-weight 500

  &:hover:not(:disabled)
    color var(--saf0o-danger)

  &:hover:not(:disabled),
  &:active:not(:disabled)
    border-color transparent
    background transparent

  &:hover:not(:disabled) .revokeAccessLabel
    border-color rgba(213, 116, 104, .32)
    color var(--saf0o-danger)
    background var(--saf0o-danger-soft)

.revokeAccessLabel
  display inline-flex
  min-height 28px
  padding 0 var(--saf0o-space-2)
  align-items center
  justify-content center
  box-sizing border-box
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-sm)
  background rgba(255, 255, 255, .015)

.revokeAccessDialog
  position absolute
  z-index 50000000
  inset 0
  display flex
  align-items center
  justify-content center
  padding var(--saf0o-space-4)
  box-sizing border-box
  background rgba(18, 20, 22, .76)

.revokeAccessPanel
  width 100%
  max-width 430px
  max-height calc(100vh - 32px)
  overflow auto
  padding var(--saf0o-space-5)
  box-sizing border-box
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-md)
  background var(--saf0o-bg-elevated)
  box-shadow var(--saf0o-shadow-lg), var(--saf0o-shadow-inset)

  strong
    display block
    overflow-wrap anywhere
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-body)
    font-weight 600

  p
    margin var(--saf0o-space-2) 0 0
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-small)
    line-height 20px

.revokeAccessActions
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--saf0o-space-2)
  margin-top var(--saf0o-space-5)

  button.saf0oControl
    width 100%
    min-height 44px

.revokeAccessStatus
  min-height 18px
  margin var(--saf0o-space-2) var(--saf0o-space-2) 0
  padding var(--saf0o-space-1) var(--saf0o-space-2) 0
  color var(--saf0o-text-secondary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-caption)
  line-height 18px
  text-align center

  &:focus
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

.revokeAccessFailure
  margin-top var(--saf0o-space-3)
  padding var(--saf0o-space-2)
  border 1px solid var(--saf0o-danger)
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-danger)
  background var(--saf0o-danger-soft)
  font-size var(--saf0o-type-small)
  line-height 20px

.permissionsLedgerView:focus
  outline 2px solid var(--saf0o-focus)
  outline-offset -2px

.permissionsModuleFocusFallback
  position absolute
  width 1px
  height 1px
  margin -1px
  overflow hidden
  clip rect(0 0 0 0)
  white-space nowrap
  pointer-events none

  &:focus,
  &:focus-visible
    outline none

.moduleMainPermissions
  overflow auto
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-md)
  background var(--saf0o-surface-inset)

.signerPermissionOrigin
  width 250px
  overflow hidden
  color var(--saf0o-text-primary)
  direction ltr
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-caption)
  line-height 18px
  text-align left
  text-overflow ellipsis
  white-space nowrap

.signerPermissionNoPermissions
  width 100%
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-small)
  text-align center

.signerPermission
  position relative
  z-index 2000
  width 100%
  padding var(--saf0o-space-3)
  box-sizing border-box
  border-bottom 1px solid var(--saf0o-border-subtle)
  color var(--saf0o-text-primary)
  font-size var(--saf0o-type-small)

  &:last-child
    border-bottom 0

  .signerPermissionControls
    position relative
    z-index 40
    display flex
    justify-content space-between

  .signerPermissionDetails
    position relative
    z-index 20
    display flex
    justify-content space-between
    padding-top var(--saf0o-space-2)
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-caption)

.connectedAppsList
  .signerPermission
    min-height 44px
    padding 0 var(--saf0o-space-2) 0 var(--saf0o-space-3)
    border-bottom 0

  .signerPermissionControls
    min-height 44px
    align-items center
    gap var(--saf0o-space-2)

  .signerPermissionOrigin
    width auto
    min-width 0
    margin 0
    flex 1

  .signerPermissionIdentity
    min-width 0
    flex 1
    display grid
    align-content center
    gap 2px

  .revokeAccessButton
    flex none

.connectedAppMark
  width 30px
  height 30px
  display inline-flex
  flex none
  align-items center
  justify-content center
  box-sizing border-box
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-tertiary)
  background var(--saf0o-surface-inset)

.connectedAppKind
  color var(--saf0o-text-tertiary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-caption)
  line-height 18px

.signerPermissionPrincipal
  overflow-wrap anywhere
  color var(--saf0o-text-tertiary)
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-caption)
  line-height 18px

.dappGuardrailChainActions
  display grid
  gap 0
  padding 0
  border-top 1px solid var(--saf0o-border-subtle)

.dappGuardrailManage
  width 100%
  height auto
  padding var(--saf0o-space-2) 0
  overflow-wrap anywhere
  white-space normal

button.saf0oControl.dappGuardrailManage
  min-height 52px
  justify-content space-between
  border 0
  border-radius 0
  text-align left

button.saf0oControl.dappGuardrailManage.saf0oControlCompact
  min-height 52px

.dappGuardrailIdentity
  min-width 0
  display grid
  gap 1px

  strong
    overflow hidden
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-small)
    font-weight 550
    line-height 18px
    text-overflow ellipsis
    white-space nowrap

  > span
    color var(--saf0o-text-tertiary)
    font-size var(--saf0o-type-caption)
    font-weight 400
    line-height 18px

.dappGuardrailAction
  flex none
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-caption)
  font-weight 550

.connectedAppDetails
  border-top 1px solid var(--saf0o-border-subtle)

  summary
    min-height 44px
    display flex
    align-items center
    color var(--saf0o-text-tertiary)
    font-size var(--saf0o-type-caption)
    font-weight 500
    cursor pointer
    list-style none

    &:after
      content '+'
      margin-left auto
      color var(--saf0o-text-tertiary)
      font-family var(--saf0o-font-mono)
      font-size var(--saf0o-type-body)

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset -2px

  &[open] summary:after
    content '−'

.connectedAppConnection
  display grid
  gap var(--saf0o-space-1)
  padding 0 0 var(--saf0o-space-3)

  span
    color var(--saf0o-text-tertiary)
    font-size var(--saf0o-type-caption)

  code
    overflow-wrap anywhere
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    line-height 18px

.permissionsLedgerView
  .connectedAppsList
    margin 0
    padding 0
    border 0
    background transparent

    .moduleMainPermissions
      display grid
      overflow visible
      gap var(--saf0o-space-3)
      border 0
      background transparent

    .clusterRow + .clusterRow
      margin-top 0

    .clusterValue
      overflow visible
      border-radius var(--saf0o-radius-md)
      background var(--saf0o-surface-card)

    .signerPermission
      min-height 0
      padding var(--saf0o-space-3)

    .signerPermissionControls
      min-height 44px

    .signerPermissionOrigin
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-small)
      font-weight 600

    .connectedAppMark
      width 34px
      height 34px

    .revokeAccessButton
      margin-left var(--saf0o-space-1)

.dappGuardrailNoChains
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-caption)

.dappGuardrailEditor
  margin var(--saf0o-space-1) 0 var(--saf0o-space-2)
  padding var(--saf0o-space-3)
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  background var(--saf0o-surface-inset)

  textarea
    min-height 88px

.dappGuardrailEditorHeader
  display flex
  align-items flex-start
  justify-content space-between
  gap var(--saf0o-space-2)

  > div
    min-width 0
    display grid
    gap var(--saf0o-space-1)

  strong
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-body)

  span
    overflow-wrap anywhere
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)

.dappGuardrailEvidence
  display grid
  gap var(--saf0o-space-1)
  margin var(--saf0o-space-3) 0

  > div
    display grid
    grid-template-columns minmax(88px, auto) minmax(0, 1fr)
    gap var(--saf0o-space-2)

  dt
    color var(--saf0o-text-tertiary)
    font-size var(--saf0o-type-caption)
    text-transform uppercase

  dd
    min-width 0
    margin 0
    overflow-wrap anywhere
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)

.dappGuardrailDisclosure
  margin 0 0 var(--saf0o-space-3)
  padding var(--saf0o-space-2)
  border-left 2px solid var(--saf0o-accent-primary)
  color var(--saf0o-text-secondary)
  background var(--saf0o-surface-overlay)
  font-size var(--saf0o-type-caption)
  line-height 1.45

.dappGuardrailField
  display grid
  gap var(--saf0o-space-1)
  margin-bottom var(--saf0o-space-3)

  > span
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-small)

  input,
  select,
  textarea
    width 100%
    min-height 44px
    padding var(--saf0o-space-2)

.dappGuardrailToggleField
  min-width 0
  margin 0 0 var(--saf0o-space-3)
  padding var(--saf0o-space-2)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-sm)

  legend
    width 100%
    display flex
    align-items center
    justify-content space-between
    gap var(--saf0o-space-2)
    padding 0
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-small)

  > input,
  > textarea
    width 100%
    min-height 44px
    margin-top var(--saf0o-space-2)
    padding var(--saf0o-space-2)

.dappGuardrailFieldDetail
  display block
  padding-top var(--saf0o-space-1)
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-caption)
  line-height 1.4

.dappGuardrailMessage
  margin-bottom var(--saf0o-space-2)
  padding var(--saf0o-space-2)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-sm)
  overflow-wrap anywhere
  font-size var(--saf0o-type-small)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

.dappGuardrailMessage-status
  color var(--saf0o-text-secondary)

.dappGuardrailMessage-alert
  border-color var(--saf0o-danger)
  color var(--saf0o-danger)
  background var(--saf0o-danger-soft)

.dappGuardrailActions,
.dappGuardrailConfirmActions
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--saf0o-space-2)

.dappGuardrailActions
  grid-template-columns repeat(auto-fit, minmax(150px, 1fr))

  button.saf0oControl
    width 100%
    min-height 44px

.dappGuardrailConfirm
  display grid
  gap var(--saf0o-space-2)
  margin-bottom var(--saf0o-space-2)
  padding var(--saf0o-space-2)
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  background var(--saf0o-surface-overlay)

  strong
    color var(--saf0o-text-primary)

  > span
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-caption)

  button.saf0oControl
    width 100%
    min-height 44px

@container panel (max-width: 540px)
  .dappGuardrailEditorHeader,
  .dappGuardrailEvidence > div
    grid-template-columns 1fr

  .dappGuardrailEditorHeader
    display grid

  .dappGuardrailActions,
  .dappGuardrailConfirmActions
    grid-template-columns 1fr

  .revokeAccessActions
    grid-template-columns 1fr

.dappGuardrailEditor details > summary
  box-sizing border-box
  min-height 44px
  padding var(--saf0o-space-3) 0
  cursor pointer
  font-size var(--saf0o-type-caption)
  line-height 20px

// Guardrails use the page measure, with flat fields and readable decision text.
.permissionsLedgerView
  scrollbar-gutter stable both-edges

  .connectedAppsList .clusterValue
    background transparent
    border-radius 0

  .connectedAppsList .signerPermission
    padding var(--saf0o-space-3) 0

  .connectedAppsList .signerPermissionOrigin,
  .dappGuardrailIdentity strong,
  .dappGuardrailAction,
  .connectedAppDetails summary
    font-size var(--saf0o-type-body)
    line-height 22px

  .dappGuardrailIdentity > span,
  .connectedAppKind
    font-size var(--saf0o-type-small)
    line-height 20px

.dappGuardrailEditor
  margin 0
  padding 0
  border 0
  border-radius 0
  background transparent
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-body)
  line-height 22px

  .dappGuardrailEditorHeader
    margin-bottom var(--saf0o-space-4)

    strong
      font-size var(--saf0o-type-sub)

    span
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-body)
      line-height 22px

  details > summary
    font-size var(--saf0o-type-body)

  .dappGuardrailDisclosure
    padding 0
    margin var(--saf0o-space-3) 0 var(--saf0o-space-6)
    border 0
    background transparent
    font-size var(--saf0o-type-body)
    line-height 22px

  .dappGuardrailField
    gap var(--saf0o-space-2)
    margin-bottom var(--saf0o-space-6)

    label
      display grid
      gap var(--saf0o-space-2)

  .dappGuardrailField > span,
  .dappGuardrailToggleField legend,
  input, select, textarea,
  .dappGuardrailMessage,
  .dappGuardrailConfirm > span
    font-size var(--saf0o-type-body)
    line-height 22px

  textarea
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-small)

  .dappGuardrailToggleField
    padding 0
    margin 0 0 var(--saf0o-space-6)
    border 0
    border-radius 0

    legend
      min-height 44px
      align-items center
      font-size var(--saf0o-type-body)

  .dappGuardrailFieldDetail
    padding var(--saf0o-space-1) 0 0
    font-size var(--saf0o-type-small)
    line-height 20px
    color var(--saf0o-text-secondary)

  .dappGuardrailEvidence
    gap var(--saf0o-space-2)

    > div
      grid-template-columns 124px minmax(0, 1fr)
      gap var(--saf0o-space-3)

    dt
      font-size var(--saf0o-type-small)
      text-transform none

    dd
      font-size var(--saf0o-type-small)
      line-height 20px

  .dappGuardrailActions
    padding-top var(--saf0o-space-4)
    border-top 1px solid var(--saf0o-border-subtle)

  .dappGuardrailConfirm
    padding var(--saf0o-space-4)
    gap var(--saf0o-space-4)

.permissionsLedgerView button.saf0oControl.dappGuardrailManage
  min-height 64px

.connectedAppDetails > summary
  padding 0
  margin 0

  &:after
    width 44px
    text-align center

.guardrailConnectionIdentity h3
  margin var(--saf0o-space-4) 0 var(--saf0o-space-2)
  font-size var(--saf0o-type-body)
  line-height 22px
