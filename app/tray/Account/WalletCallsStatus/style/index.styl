.walletCallsStatus
  position absolute
  inset 0
  color var(--saf0o-text-primary)
  background transparent

.walletCallsStatusScroll
  position absolute
  inset 0
  padding var(--saf0o-space-6) var(--saf0o-space-8) var(--saf0o-space-8)
  box-sizing border-box
  overflow-y auto

.walletCallsStatusSummary
  display flex
  min-height 82px
  padding var(--saf0o-space-1) 0 var(--saf0o-space-5)
  justify-content space-between
  align-items center
  gap var(--saf0o-space-6)

.walletCallsStatusEyebrow
  color var(--saf0o-accent-primary-hover)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  font-weight 550
  letter-spacing .03em
  text-transform uppercase

.walletCallsStatusSummaryCopy
  h2,
  p
    margin 0

  h2
    margin-top 3px
    font-size var(--saf0o-type-title)
    font-weight 660
    line-height 1.18

  p
    margin-top var(--saf0o-space-2)
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-small)
    line-height 1.45

.walletCallsStatusMark
  display flex
  flex 0 0 38px
  width 38px
  height 38px
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-md)
  color var(--saf0o-text-secondary)
  background var(--saf0o-bg-elevated)
  align-items center
  justify-content center

.walletCallsStatusSummary-success .walletCallsStatusMark
  color var(--saf0o-success)

.walletCallsStatusSummary-failure .walletCallsStatusMark
  color var(--saf0o-danger)

.walletCallsStatusSummary-warning .walletCallsStatusMark
  color var(--saf0o-warning)

.walletCallsStatusSummary-pending .walletCallsStatusMark
  color var(--saf0o-accent-primary-hover)

.walletCallsStatusUnavailableActions
  display flex
  padding 0 0 var(--saf0o-space-4)
  justify-content flex-end
  gap var(--saf0o-space-2)

  button
    height 34px
    padding 0 var(--saf0o-space-3)
    border 1px solid var(--saf0o-border-default)
    border-radius var(--saf0o-radius-sm)
    color var(--saf0o-text-secondary)
    background var(--saf0o-control-texture-dark), var(--saf0o-bg-elevated)
    box-shadow var(--saf0o-control-shadow)
    font-size var(--saf0o-type-caption)
    font-weight 620

    &:not(:disabled):hover
      color var(--saf0o-text-primary)
      border-color var(--saf0o-border-strong)
      background var(--saf0o-control-texture-dark), var(--saf0o-surface-hover)

    &:disabled
      opacity .5

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

.walletCallsStatusSection
  padding var(--saf0o-space-4) 0
  border-top 1px solid var(--saf0o-ledger-rule)

  > h3
    margin 0 0 var(--saf0o-space-3)
    font-size var(--saf0o-type-small)
    font-weight 650

.walletCallsStatusContext
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap var(--saf0o-space-4)

  div
    min-width 0

  span,
  strong
    display block

  span
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)

  strong
    margin-top var(--saf0o-space-1)
    overflow hidden
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-small)
    font-weight 570
    text-overflow ellipsis
    white-space nowrap

  .walletCallsStatusNonAtomic
    color var(--saf0o-warning)

.walletCallsStatusAtomic
  display flex
  margin-top var(--saf0o-space-4)
  color var(--saf0o-warning)
  font-size var(--saf0o-type-caption)
  line-height 1.45
  align-items center
  gap var(--saf0o-space-2)

.walletCallsStatusSectionHeading
  display flex
  margin-bottom var(--saf0o-space-2)
  justify-content space-between
  align-items baseline
  gap var(--saf0o-space-4)

  h3
    margin 0
    font-size var(--saf0o-type-small)
    font-weight 650

  span
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)

.walletCallsStatusReceipts
  border-bottom 1px solid var(--saf0o-ledger-rule)

.walletCallsStatusReceipt
  display grid
  min-height 88px
  padding var(--saf0o-space-4) 0
  border-top 1px solid var(--saf0o-ledger-rule)
  box-sizing border-box
  grid-template-columns 42px minmax(0, 1fr) 76px
  gap var(--saf0o-space-3)
  align-items start

  &:hover
    background linear-gradient(90deg, transparent, rgba(255, 255, 255, .016) 10%, rgba(255, 255, 255, .016) 90%, transparent)

.walletCallsStatusReceiptNumber
  padding-top 2px
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)

.walletCallsStatusReceiptBody
  min-width 0

  > button
    display block
    max-width 100%
    padding 0
    border 0
    color inherit
    background transparent
    text-align left
    cursor copy

    strong,
    span
      display block

    strong
      color var(--saf0o-text-primary)
      font-size var(--saf0o-type-body)
      font-weight 640

    span
      margin-top var(--saf0o-space-1)
      overflow hidden
      color var(--saf0o-text-muted)
      font-family var(--saf0o-font-utility)
      font-size var(--saf0o-type-caption)
      text-overflow ellipsis
      white-space nowrap

    &:hover span
      color var(--saf0o-accent-primary-hover)

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 3px

  dl
    display grid
    margin var(--saf0o-space-3) 0 0
    grid-template-columns 100px 120px minmax(0, 1fr)
    gap var(--saf0o-space-3)

    div
      min-width 0

    dt,
    dd,
    small
      display block

    dt
      color var(--saf0o-text-muted)
      font-family var(--saf0o-font-utility)
      font-size var(--saf0o-type-caption)

    dd
      margin var(--saf0o-space-1) 0 0
      color var(--saf0o-text-secondary)
      font-family var(--saf0o-font-utility)
      font-size var(--saf0o-type-caption)

    small
      margin-top 3px
      color var(--saf0o-text-muted)
      font-family var(--saf0o-font-utility)
      font-size var(--saf0o-type-caption)
      line-height 1.4

.walletCallsStatusReceiptGood,
.walletCallsStatusReceiptBad
  padding-top 2px
  font-size var(--saf0o-type-caption)
  font-weight 650
  text-align right

.walletCallsStatusReceiptGood
  color var(--saf0o-success)

.walletCallsStatusReceiptBad
  color var(--saf0o-danger)

.walletCallsStatusEmpty
  padding var(--saf0o-space-6) 0
  border-top 1px solid var(--saf0o-ledger-rule)
  border-bottom 1px solid var(--saf0o-ledger-rule)
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-small)

.walletCallsStatusMetadata
  display flex
  padding-top var(--saf0o-space-3)
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  gap var(--saf0o-space-4)

  span
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

@container panel (max-width: 610px)
  .walletCallsStatusScroll
    padding-right var(--saf0o-space-6)
    padding-left var(--saf0o-space-6)

  .walletCallsStatusContext
    grid-template-columns repeat(2, minmax(0, 1fr))

  .walletCallsStatusReceiptBody dl
    grid-template-columns repeat(2, minmax(90px, 1fr))

    div:last-child
      grid-column 1 / -1
