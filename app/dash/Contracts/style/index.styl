.contracts
  width 100%
  min-height 100%
  box-sizing border-box
  padding 0 var(--saf0o-page-gutter)
  overflow-x clip
  color var(--saf0o-text-primary)

.contractsHeader
  padding var(--saf0o-space-4) 0 var(--saf0o-space-2)

  h1
    margin 0
    font-size var(--saf0o-type-title)
    font-weight 500
    letter-spacing -.4px

.contractsModeSwitch.sendModeSwitch
  margin 0 0 var(--saf0o-space-3)

.contractsPanel[hidden]
  display none

.contractsPanel
  min-width 0
  box-sizing border-box
  padding 0 2px

  > .deployment,
  > .contractVerification
    min-height 0
    overflow-x visible
    padding-right 0
    padding-left 0

  > .deployment .deploymentActionShelf,
  > .contractVerification .contractVerificationActionShelf
    margin-right 0
    margin-left 0
    padding-right 0
    padding-left 0

@media (max-width: 540px)
  .contracts
    padding-right var(--saf0o-space-3)
    padding-left var(--saf0o-space-3)
