.addChainTitle
  padding var(--saf0o-space-8) var(--saf0o-space-5) var(--saf0o-space-4)
  color var(--saf0o-text-primary)
  font-size var(--saf0o-type-title)
  font-weight 500
  font-variation-settings var(--saf0o-font-heading-settings)

.addChain
  position relative
  z-index 3
  width 100%
  box-sizing border-box
  padding-bottom var(--saf0o-space-8)
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-body)
  word-break break-word

.chainColorSwatches
  display flex
  gap 3px
  margin var(--saf0o-space-1) 0
  padding 3px
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-sm)
  background var(--saf0o-surface-inset)

  .chainColorSwatch
    appearance none
    flex 1
    height 36px
    min-width 0
    padding 0
    border 1px solid transparent
    border-radius 3px
    cursor pointer
    transition transform var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease)

  .chainColorSwatch:hover
    transform translateY(-1px)
    border-color var(--saf0o-text-primary)

  .chainColorSwatch:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

  .chainColorSwatchSelected
    border-color var(--saf0o-text-primary)
    box-shadow inset 0 0 0 1px var(--saf0o-surface-inset)

.chainId
  width calc(50% - 5px)

.chainSymbol
  width calc(50% - 5px)

.chainRpc
  width 100%

.chainInput
  width 100%
  box-sizing border-box
  margin-top var(--saf0o-space-1)
  padding var(--saf0o-space-3)
  border 1px solid var(--saf0o-border-default)
  border-radius var(--saf0o-radius-sm)
  outline none
  color var(--saf0o-text-primary)
  background var(--saf0o-surface-inset)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-body)
  font-weight 400
  text-align left
  transition border-color var(--saf0o-motion-fast) var(--saf0o-ease), background var(--saf0o-motion-fast) var(--saf0o-ease)

.chainInput:hover
  border-color var(--saf0o-border-strong)

.chainInput:focus
  border-color var(--saf0o-focus)
  background var(--saf0o-bg-subtle)

.chainInput:focus-visible
  outline 2px solid var(--saf0o-focus)
  outline-offset 2px

.chainInputDim
  color var(--saf0o-text-tertiary)

.chainInputLabel
  padding var(--saf0o-space-2) 0 0
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-small)
  font-weight 500
  letter-spacing 0
  text-transform none

.chainFieldDisplay
  padding var(--saf0o-space-3)
  margin-top var(--saf0o-space-1)
  text-align left

.addChainSubmit
  appearance none
  width 100%
  min-height 44px
  box-sizing border-box
  margin var(--saf0o-space-3) 0 var(--saf0o-space-1)
  padding var(--saf0o-space-2) var(--saf0o-space-4)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-disabled)
  background var(--saf0o-surface-inset)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-body)
  font-weight 500
  text-align center
  text-transform none
  opacity 1
  cursor not-allowed

  svg
    margin-right var(--saf0o-space-2)

.addChainSubmitEnabled
  border-color var(--saf0o-accent-secondary)
  color var(--saf0o-text-inverse)
  background var(--saf0o-accent-secondary)
  cursor pointer
  transition background var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease)

  *
    pointer-events none

.addChainSubmitEnabled:hover
  border-color var(--saf0o-accent-secondary-hover)
  background var(--saf0o-accent-secondary-hover)

.addChainSubmitEnabled:active
  background var(--saf0o-accent-secondary-active)

.addChainSubmit:focus-visible
  outline 2px solid var(--saf0o-focus)
  outline-offset 2px

.chainRow
  display flex
  flex-direction column
  width 100%
  box-sizing border-box
  padding 0 var(--saf0o-space-4) var(--saf0o-space-4)

.chainRowTestnet
  display flex
  align-items center
  justify-content space-between
  width auto
  margin var(--saf0o-space-1) var(--saf0o-space-4) var(--saf0o-space-4)
  padding var(--saf0o-space-3)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-sm)
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-small)
  font-weight 500
  letter-spacing 0
  text-transform none

.chainRowRemove
  padding var(--saf0o-space-2) 0

.networkEditor
  display flex
  flex-direction column
  width 100%
  height calc(100vh - 64px)
  min-height 0
  box-sizing border-box
  overflow hidden
  color var(--saf0o-text-primary)
  background transparent
  font-family var(--saf0o-font-ui)

// The editor owns its vertical rhythm. General settings-page padding otherwise
// adds a small, empty scroll range around an editor that already fits.
.localSettings:has(.networkEditor) > .localSettingsWrap
  padding 0
  overflow hidden

.networkEditorHeader
  flex none
  min-height 70px
  box-sizing border-box
  padding var(--saf0o-space-4) var(--saf0o-page-gutter) var(--saf0o-space-3)

  h1,
  p
    margin 0

  h1
    overflow hidden
    font-size var(--saf0o-type-heading)
    font-weight 660
    font-variation-settings 'CASL' .28, 'CRSV' 0
    line-height 25px
    text-overflow ellipsis
    white-space nowrap

  p
    margin-top 2px
    overflow hidden
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-caption)
    text-overflow ellipsis
    white-space nowrap

.networkEditorBody
  position relative
  flex 1 1 auto
  min-height 0
  padding 34px var(--saf0o-page-gutter) var(--saf0o-space-6)
  overflow-x hidden
  overflow-y auto
  scrollbar-gutter stable both-edges

.networkEditorGrid
  display grid
  grid-template-columns minmax(0, 2fr) minmax(0, 1fr)
  gap var(--saf0o-space-6) var(--saf0o-space-4)

.networkEditorWide
  grid-column 1 / -1

.networkEditorField
  display block
  min-width 0

.networkEditorFieldLabel
  display flex
  min-height 20px
  align-items flex-start
  justify-content space-between
  gap var(--saf0o-space-3)
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-caption)
  font-weight 590

.networkEditorFieldStatus
  overflow hidden
  color var(--saf0o-success)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-caption)
  font-weight 400
  text-overflow ellipsis
  white-space nowrap

.networkEditorFieldStatusError
  color var(--saf0o-danger)

input.networkEditorInput
  width 100%
  height 44px
  padding 0 var(--saf0o-space-3)
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-small)
  text-align left

  &[readonly]
    color var(--saf0o-text-muted)

input.networkEditorInputTechnical
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-caption)

.rpcEndpointSection
  min-width 0

.rpcEndpointHeading
  display flex
  margin-bottom var(--saf0o-space-2)
  align-items flex-end
  justify-content space-between

  h2,
  p
    margin 0

  h2
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-small)
    font-weight 500
    line-height 20px

  p
    max-width 520px
    margin-top 2px
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-small)
    line-height 18px

.rpcEndpointRow
  display grid
  min-height 70px
  box-sizing border-box
  border 0
  align-items center
  grid-template-columns 18px 18px minmax(0, 1fr) 88px 44px 44px
  gap var(--saf0o-space-2)

.rpcEndpointRowOff
  color var(--saf0o-text-muted)

  .rpcEndpointInput
    color var(--saf0o-text-muted)

.rpcEndpointOrder
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-caption)
  text-align center

.rpcEndpointState
  display flex
  width 18px
  height 18px
  align-items center
  justify-content center
  color var(--saf0o-text-disabled)

.rpcEndpointState-connected
  color var(--saf0o-success)

.rpcEndpointState-checking
  color var(--saf0o-warning)

.rpcEndpointState-standby
  color var(--saf0o-text-muted)

.rpcEndpointState-checking svg
  animation rpcEndpointChecking var(--saf0o-motion-slow) linear infinite

.rpcEndpointState-error
  color var(--saf0o-danger)

@keyframes rpcEndpointChecking
  to
    transform rotate(360deg)

@media (prefers-reduced-motion: reduce)
  .rpcEndpointState-checking svg
    animation none

.rpcEndpointInputWrap
  display grid
  min-width 0
  gap 2px
  padding var(--saf0o-space-1) 0

input.rpcEndpointInput
  width 100%
  height 44px
  min-width 0
  box-sizing border-box
  padding 0 var(--saf0o-space-2)
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-caption)
  text-align left

.rpcEndpointStatus
  min-height 17px
  overflow hidden
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-caption)
  line-height 17px
  text-overflow ellipsis
  white-space nowrap

.rpcEndpointStatus-connected
  color var(--saf0o-success)

.rpcEndpointStatus-checking
  color var(--saf0o-warning)

.rpcEndpointStatus-error
  color var(--saf0o-danger)

.rpcEndpointMove
  display grid
  width 88px
  height 44px
  grid-template-columns repeat(2, 44px)

  button
    appearance none
    display flex
    width 44px
    height 44px
    min-height 44px
    padding 0
    border 0
    align-items center
    justify-content center
    color var(--saf0o-text-secondary)
    background transparent
    cursor pointer

    &:hover:not(:disabled)
      color var(--saf0o-text-primary)
      background var(--saf0o-surface-hover)

    &:disabled
      color var(--saf0o-text-disabled)
      cursor default

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset -2px

.rpcEndpointRemove
  appearance none
  display flex
  width 44px
  height 44px
  padding 0
  border 0
  align-items center
  justify-content center
  color var(--saf0o-text-muted)
  background transparent
  cursor pointer

  &:hover
    color var(--saf0o-danger)
    background var(--saf0o-danger-soft)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset -2px

.rpcEndpointRemoveSpacer
  width 44px

.rpcEndpointRowNoToggle
  grid-template-columns 18px 18px minmax(0, 1fr) 88px 44px

.rpcEndpointAddRow
  display flex
  min-height 46px
  padding-top var(--saf0o-space-2)
  padding-left var(--saf0o-space-12)
  box-sizing border-box
  align-items center
  justify-content flex-start
  gap var(--saf0o-space-3)

  > span
    margin-left auto
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-caption)

  button
    appearance none
    display inline-flex
    min-width 0
    height 44px
    padding 0 var(--saf0o-space-2) 0 var(--saf0o-space-3)
    border 1px solid transparent
    border-radius var(--saf0o-radius-sm)
    align-items center
    justify-content center
    gap var(--saf0o-space-2)
    color var(--saf0o-text-secondary)
    background transparent
    box-shadow none
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-caption)
    font-weight 590
    cursor pointer

    &:hover:not(:disabled)
      color var(--saf0o-text-primary)
      background var(--saf0o-surface-hover)

    &:active:not(:disabled)
      transform translateY(1px)
      background var(--saf0o-surface-active)

    &:disabled
      color var(--saf0o-text-disabled)
      background transparent
      cursor default

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

.networkEditorToggleRow
  display flex
  min-height 44px
  margin-top var(--saf0o-space-6)
  align-items center
  justify-content space-between
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-small)
  font-weight 590

.networkEditorMessage
  margin-top var(--saf0o-space-3)
  color var(--saf0o-danger)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-caption)

.networkEditorFooter
  display flex
  flex none
  min-height 104px
  box-sizing border-box
  padding var(--saf0o-space-6) var(--saf0o-page-gutter)
  align-items center
  justify-content space-between
  gap var(--saf0o-space-3)
  border-top 1px solid var(--saf0o-border-subtle)
  background var(--saf0o-surface-overlay)

.networkEditorFooterActions
  display flex
  margin-left auto
  align-items center
  gap var(--saf0o-space-2)

button.networkEditorCancel,
button.networkEditorSubmit
  width 156px
  min-width 156px
  height 46px
  min-height 46px
  padding 0 var(--saf0o-space-5)
  font-size var(--saf0o-type-body)
  font-weight 650

button.networkEditorCancel
  width 160px
  min-width 160px
  height 48px
  min-height 48px
  transform translateY(-1px)

button.networkEditorRemove.saf0oControl
  height 44px
  min-height 44px

// The dash header leaves a 680px editor viewport in the supported 620 × 744 shell.
// Keep the actions anchored while the complete form remains scrollable there.
@media (max-height: 760px) and (min-width: 561px)
  .networkEditorHeader
    min-height 60px
    padding-top var(--saf0o-space-2)
    padding-bottom var(--saf0o-space-2)

  .networkEditorBody
    padding-top var(--saf0o-space-3)
    padding-bottom var(--saf0o-space-2)

  .networkEditorGrid
    row-gap var(--saf0o-space-3)

  .networkEditorToggleRow
    margin-top var(--saf0o-space-2)

  .networkEditorFooter
    min-height 74px
    padding-top var(--saf0o-space-3)
    padding-bottom var(--saf0o-space-3)

@media (max-width: 560px)
  .networkEditorHeader
    padding-right var(--saf0o-space-3)
    padding-left var(--saf0o-space-3)

  .networkEditorBody
    padding var(--saf0o-space-5) var(--saf0o-space-3)

  .networkEditorGrid
    grid-template-columns 1fr

  .networkEditorWide
    grid-column auto

  .networkEditorFooter
    flex-wrap wrap
    padding-right var(--saf0o-space-3)
    padding-left var(--saf0o-space-3)

  .networkEditorFooterActions
    width 100%

  button.networkEditorCancel,
  button.networkEditorSubmit
    flex 1 1 0
    width auto
    min-width 0

.networkEditorConnections
  padding-top var(--saf0o-space-2)

.networkEditorSections
  margin 0 var(--saf0o-page-gutter) var(--saf0o-space-2)

.networkEditorConnections > button
  margin-top var(--saf0o-space-5)
