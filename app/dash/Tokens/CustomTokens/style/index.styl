.customTokens
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-ui)

  .customTokensTitle
    min-height 47px
    display flex
    justify-content space-between
    align-items center
    padding 0 var(--saf0o-space-3)
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-body)
    font-weight 500
    border-bottom 1px solid var(--saf0o-border-subtle)

    .customTokensAddToken
      appearance none
      min-height 30px
      display flex
      justify-content center
      align-items center
      padding 0 var(--saf0o-space-3)
      border 1px solid var(--saf0o-border-default)
      border-radius var(--saf0o-radius-sm)
      background var(--saf0o-bg-elevated)
      color var(--saf0o-text-primary)
      font-family inherit
      font-size var(--saf0o-type-small)
      font-weight 500
      cursor pointer
      transition background var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease)

      *
        pointer-events none

    .customTokensAddToken:hover
      background var(--saf0o-surface-hover)
      border-color var(--saf0o-border-strong)

    .customTokensAddToken:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

  .customTokensFooter
    position absolute
    right 0
    bottom 0
    left 0
    min-height 64px
    display flex
    justify-content center
    align-items center
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-body)
    font-weight 500

  .customTokensList
    padding var(--saf0o-space-3) 0
    z-index 2

  .customTokensListNoTokens
    display flex
    flex-direction column
    justify-content center
    align-items center
    gap var(--saf0o-space-2)
    min-height 260px
    padding var(--saf0o-space-4) var(--saf0o-space-6) var(--saf0o-space-6)
    color var(--saf0o-text-tertiary)
    font-size var(--saf0o-type-small)
    text-align center

    img
      display block
      width min(410px, 100%)
      height 150px
      object-fit cover
      object-position center

    strong
      color var(--saf0o-text-primary)
      font-size var(--saf0o-type-body)
      font-weight 550

    span
      max-width 300px
      line-height 19px

  .customTokensListItem
    position relative
    box-sizing border-box
    min-height 58px
    overflow hidden
    border-bottom 1px solid var(--saf0o-ledger-rule)
    background transparent
    transition background var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease)

    &:last-child
      border-bottom 0

    .customTokensListItemTitle
      min-height 58px
      display flex
      justify-content space-between
      align-items center
      padding var(--saf0o-space-2) var(--saf0o-space-3)
      box-sizing border-box

      .customTokensListItemExpand
        appearance none
        position relative
        width 44px
        height 44px
        margin-left var(--saf0o-space-1)
        padding 14px
        box-sizing border-box
        border 0
        background transparent
        color var(--saf0o-text-secondary)
        cursor pointer

        &::before
          content ''
          position absolute
          inset 7px
          border 1px solid var(--saf0o-border-default)
          border-radius var(--saf0o-radius-sm)
          background var(--saf0o-bg-elevated)
          transition background var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease)

        svg
          position relative
          z-index 1
          transform rotate(-180deg)
          transition transform var(--saf0o-motion-fast) var(--saf0o-ease)

        *
          pointer-events none

      .customTokensListItemExpand:hover
        color var(--saf0o-text-primary)

        &::before
          background var(--saf0o-surface-hover)
          border-color var(--saf0o-border-strong)

      .customTokensListItemExpand:focus-visible
        outline 2px solid var(--saf0o-focus)
        outline-offset 2px

      .customTokensListItemExpand:disabled
        color var(--saf0o-text-disabled)
        cursor default
        opacity .6

      .customTokensListItemExpandActive
        svg
          transform rotate(0deg)

      .customTokensListItemName
        min-width 0
        display flex
        align-items center
        color var(--saf0o-text-primary)
        font-weight 500

        .customTokensAssetMark
          margin-right var(--saf0o-space-3)

        .customTokensListItemText
          min-width 0
          display flex
          flex-direction column
          align-items flex-start

        .customTokensListItemSymbol
          max-width 100%
          overflow hidden
          color var(--saf0o-text-primary)
          font-size var(--saf0o-type-body)
          font-weight 500
          line-height 18px
          text-overflow ellipsis
          white-space nowrap

        .customTokensListItemSub
          max-width 100%
          margin-top 2px
          overflow hidden
          color var(--saf0o-text-tertiary)
          font-size var(--saf0o-type-small)
          line-height 16px
          text-overflow ellipsis
          white-space nowrap

      .customTokensListItemChain
        display flex
        align-items center
        color var(--saf0o-text-secondary)
        font-family var(--saf0o-font-mono)
        font-size var(--saf0o-type-small)

    .customTokensListItemChainLabel
      margin-right var(--saf0o-space-1)
      color var(--saf0o-text-tertiary)
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-small)

    .customTokensListItemAddress
      appearance none
      width calc(100% - 24px)
      min-height 44px
      display flex
      justify-content center
      align-items center
      margin 0 var(--saf0o-space-3)
      padding 0 var(--saf0o-space-2)
      overflow hidden
      border 1px solid var(--saf0o-border-default)
      border-radius var(--saf0o-radius-sm)
      background var(--saf0o-surface-inset)
      color var(--saf0o-text-secondary)
      font-family var(--saf0o-font-mono)
      font-size var(--saf0o-type-small)
      text-overflow ellipsis
      white-space nowrap
      cursor pointer
      transition background var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease), color var(--saf0o-motion-fast) var(--saf0o-ease)

    .customTokensListItemAddress:hover
      background var(--saf0o-surface-hover)
      border-color var(--saf0o-border-strong)
      color var(--saf0o-text-primary)

    .customTokensListItemAddress:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

    .customTokensListItemAddress:disabled
      color var(--saf0o-text-disabled)
      cursor default
      opacity .6

    .customTokensListItemAddress:disabled:hover
      background var(--saf0o-surface-inset)
      border-color var(--saf0o-border-default)

    .customTokensCopyStatus
      position absolute
      width 1px
      height 1px
      padding 0
      margin -1px
      overflow hidden
      clip rect(0, 0, 0, 0)
      white-space nowrap
      border 0

    .customTokensListItemBottom
      display flex
      align-items center
      gap var(--saf0o-space-2)
      padding var(--saf0o-space-3)

    .customTokensListItemButton
      appearance none
      width 50%
      min-height 44px
      display flex
      justify-content center
      align-items center
      box-sizing border-box
      padding 0 var(--saf0o-space-2)
      border 1px solid var(--saf0o-border-default)
      border-radius var(--saf0o-radius-sm)
      background var(--saf0o-bg-elevated)
      color var(--saf0o-text-primary)
      font-family inherit
      font-size var(--saf0o-type-small)
      font-weight 500
      cursor pointer
      transition background var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease)

      *
        pointer-events none

    .customTokensListItemButton:hover
      background var(--saf0o-surface-hover)
      border-color var(--saf0o-border-strong)

    .customTokensListItemButton:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

    .customTokensListItemButton:disabled,
    .customTokensListItemButton[aria-disabled='true']
      color var(--saf0o-text-disabled)
      cursor default
      opacity .6

    .customTokensListItemButton:disabled:hover,
    .customTokensListItemButton[aria-disabled='true']:hover
      background var(--saf0o-bg-elevated)
      border-color var(--saf0o-border-default)

    .editButton
      color var(--saf0o-accent-secondary-hover)

    .removeButton
      color var(--saf0o-danger)

    .customTokensListItemRemoval
      display flex
      flex-direction column
      gap var(--saf0o-space-2)
      padding var(--saf0o-space-3)
      color var(--saf0o-text-secondary)
      font-size var(--saf0o-type-small)
      line-height 18px

      strong
        color var(--saf0o-text-primary)
        font-weight 550

      .customTokensListItemRemovalActions
        display flex
        gap var(--saf0o-space-2)

        .customTokensListItemButton
          width 50%

          &:disabled
            cursor default
            opacity .6

  .customTokensListItemExpanded
    border-color var(--saf0o-border-default)

  .customTokensListItemChainDecimal
    display flex
    justify-content center
    align-items center
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-small)
