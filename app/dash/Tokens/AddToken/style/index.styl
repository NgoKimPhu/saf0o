.newTokenView
  width 100%
  padding 20px 20px 32px
  box-sizing border-box
  color var(--saf0o-text-primary)
  background transparent
  font-family var(--saf0o-font-ui)

.newTokenFormInner
  width 100%
  max-width none
  margin 0
  padding 0
  box-sizing border-box
  background transparent

.newTokenTitle
  margin 0
  padding var(--saf0o-space-4) 0 var(--saf0o-space-5)
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-title)
  font-weight 620
  line-height 1.2

.newTokenChainSelectChain
  width 100%

.newTokenEmpty
  min-height 88px
  display flex
  align-items center
  justify-content center
  margin var(--saf0o-space-2)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-md)
  background var(--saf0o-surface-inset)
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-body)

.newTokenChainSelectFooter
  display flex
  margin-top var(--saf0o-space-5)
  justify-content flex-start

  .newTokenEnableChainLink
    min-height 44px

.newTokenForm,
.addToken
  display grid
  gap var(--saf0o-space-5)

.newTokenDetails
  display grid
  gap var(--saf0o-space-5)
  margin-top var(--saf0o-space-1)
  padding-top var(--saf0o-space-4)
  border-top 1px solid var(--saf0o-ledger-rule)

.newTokenDetailsTitle
  margin 0
  color var(--saf0o-text-primary)
  font-size var(--saf0o-type-heading)
  font-weight 600
  line-height 1.3

.newTokenLookupStatus
  display flex
  min-height 20px
  margin-top calc(-1 * var(--saf0o-space-3))
  align-items center
  gap var(--saf0o-space-2)
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-small)
  line-height 1.4

.newTokenLookupStatus-ready
  color var(--saf0o-success)

.newTokenLookupStatus-checking
  color var(--saf0o-warning)

  svg
    animation newTokenLookupChecking var(--saf0o-motion-slow) linear infinite

.newTokenLookupStatus-error
  color var(--saf0o-danger)

@keyframes newTokenLookupChecking
  to
    transform rotate(360deg)

@media (prefers-reduced-motion: reduce)
  .newTokenLookupStatus-checking svg
    animation none

.newTokenNetwork
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-small)
  font-weight 500

.newTokenContext
  display flex
  min-height 44px
  margin-bottom var(--saf0o-space-5)
  padding var(--saf0o-space-2) 0
  box-sizing border-box
  align-items center
  justify-content space-between
  gap var(--saf0o-space-3)
  border-top 1px solid var(--saf0o-ledger-rule)
  border-bottom 1px solid var(--saf0o-ledger-rule)

.newTokenChainAddress
  display flex
  min-width 0
  align-items center
  color var(--saf0o-text-secondary)
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-small)

  svg
    margin 0 var(--saf0o-space-1)

.tokenFieldRow
  display grid
  grid-template-columns minmax(0, 1fr) minmax(112px, .62fr)
  gap var(--saf0o-space-4)

.tokenInputLabel
  display grid
  min-width 0
  gap var(--saf0o-space-2)
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-small)
  font-weight 590
  text-align left

.tokenInput
  width 100%
  min-height 44px
  padding 0 var(--saf0o-space-3)
  color var(--saf0o-text-primary)
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-body)
  font-weight 400
  text-align left

.tokenInputAddress
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-small)

.newTokenActions
  display flex
  min-height 44px
  justify-content flex-end
  gap var(--saf0o-space-3)

  .saf0oControl
    min-height 44px

.newTokenSaveError
  padding var(--saf0o-space-3)
  border 1px solid var(--saf0o-danger)
  border-radius var(--saf0o-radius-sm)
  background var(--saf0o-surface-inset)
  color var(--saf0o-danger)
  font-size var(--saf0o-type-small)
  line-height 1.45

@media (max-height: 760px)
  .newTokenView
    padding-top var(--saf0o-space-3)
    padding-bottom var(--saf0o-space-5)

  .newTokenTitle
    padding-bottom var(--saf0o-space-4)

  .newTokenForm,
  .addToken
    gap var(--saf0o-space-4)

  .newTokenContext
    margin-bottom var(--saf0o-space-4)

@media (max-width: 520px)
  .tokenFieldRow
    grid-template-columns 1fr

  .newTokenContext
    align-items flex-start
    flex-direction column

.tokenMetadata
  display grid
  gap var(--saf0o-space-3)
