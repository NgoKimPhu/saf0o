.saf0oSettings
  .localSettingsWrap
    padding var(--saf0o-space-2) var(--saf0o-page-gutter) var(--saf0o-space-8)

  .saf0oSettingsSection
    margin 0
    padding 0

  .saf0oSettingsSection + .saf0oSettingsSection
    margin-top var(--saf0o-space-5)

  .saf0oSettingsSectionTitle
    margin 0
    padding var(--saf0o-space-4) var(--saf0o-space-2) var(--saf0o-space-2)
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-small)
    font-weight 500
    letter-spacing 0
    line-height 18px
    text-transform none

  .localSetting
    min-height 56px
    margin 0
    padding var(--saf0o-space-3) var(--saf0o-space-2)
    box-sizing border-box
    border 0
    border-radius 0
    background transparent
    box-shadow none

    &:hover
      background var(--saf0o-surface-hover)

    .signerPermissionControls
      min-height 32px
      align-items center
      gap var(--saf0o-space-4)

    .signerPermissionSetting
      width auto
      min-width 0
      max-width none
      flex 1
      padding 0
      color var(--saf0o-text-primary)
      direction ltr
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-body)
      font-weight 500
      line-height 20px
      text-align left

    .signerPermissionDetails
      position absolute
      width 1px
      height 1px
      margin -1px
      padding 0
      overflow hidden
      clip rect(0 0 0 0)
      clip-path inset(50%)
      white-space nowrap

    .dropdownWrap
      flex 0 0 auto
      height 44px

    .dropdown
      min-width 130px
      height 44px
      background-position calc(100% - 16px) 19px, calc(100% - 11px) 19px

  .localSettingShortcut
    min-height 72px

    .settingsShortcutSetting
      display flex
      align-items center
      gap var(--saf0o-space-3)
      flex-wrap wrap
      direction ltr

    .signerPermissionControls
      min-height 28px

    .signerPermissionSetting
      overflow visible
      white-space normal

    .signerPermissionDetails
      position static
      width auto
      height auto
      margin 3px 0 0
      padding 0
      overflow visible
      clip auto
      clip-path none
      color var(--saf0o-text-tertiary)
      font-size var(--saf0o-type-caption)
      line-height 20px
      white-space normal

    .keyCommand,
    .keyCommandLoading
      min-height 24px
      height 24px
      margin-left var(--saf0o-space-2)
      padding 0 var(--saf0o-space-2)

  .localSettingExplained
    min-height 76px

    .signerPermissionDetails
      position static
      width auto
      height auto
      margin 3px 0 0
      padding 0
      overflow visible
      clip auto
      clip-path none
      color var(--saf0o-text-tertiary)
      font-size var(--saf0o-type-caption)
      line-height 18px
      white-space normal

  .recentRecipientsSetting,
  .recentRecipientsClear
    height auto

  .recentRecipientsDialog
    width 100%
    box-sizing border-box

  .contractVerificationCredential
    height auto

  .contractVerificationCredentialIdentity
    display flex
    width 100%
    min-width 0
    align-items center
    justify-content space-between
    gap var(--saf0o-space-3)

  .contractVerificationCredentialControls
    width 100%
    align-items stretch
    flex-direction column
    gap var(--saf0o-space-2)

  .contractVerificationCredentialStatus,
  .contractVerificationCredentialHint,
  .contractVerificationCredentialMessage,
  .contractVerificationCredentialError
    color var(--saf0o-text-tertiary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-caption)
    line-height 18px

  .contractVerificationCredentialActions
    display flex
    width 100%
    align-items center
    justify-content flex-start
    gap var(--saf0o-space-2)

    button
      min-height 44px
      flex none

  .contractVerificationCredentialInput
    padding 0 var(--saf0o-space-3)
    min-width 0
    width auto
    height 44px
    box-sizing border-box
    flex 1 1 auto

  .contractVerificationCredentialMessage
    min-height 0
    color var(--saf0o-success)

    &:empty
      display none

  .contractVerificationCredentialHint
    margin-top var(--saf0o-space-1)
    color var(--saf0o-text-secondary)

  .contractVerificationCredentialError
    min-height 18px
    color var(--saf0o-danger)
    box-sizing border-box

  .recentRecipientsStatus
    &:empty
      display none

    min-height 18px
    padding var(--saf0o-space-1) var(--saf0o-space-2) 0
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-caption)
    line-height 18px

  .interfaceScaleSetting
    min-height 104px

  button.localConnectionTarget.saf0oControl
    min-height 44px

  .interfaceScaleHeader
    display flex
    width 100%
    min-width 0
    align-items center
    justify-content space-between
    gap var(--saf0o-space-5)

  .interfaceScaleCopy
    min-width 0

  .interfaceScaleDescription,
  .interfaceScaleStatus
    margin-top var(--saf0o-space-1)
    color var(--saf0o-text-tertiary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-caption)
    font-weight 400
    line-height 18px

  .interfaceScaleStatus
    color var(--saf0o-text-secondary)

  .interfaceScaleOptions
    display grid
    flex none
    grid-template-columns repeat(3, minmax(56px, 1fr))
    border 1px solid var(--saf0o-border-default)
    border-radius var(--saf0o-radius-sm)
    overflow hidden

  .windowTransparencyControl
    display flex
    flex none
    align-items center
    gap var(--saf0o-space-3)

    input
      width 140px
      accent-color var(--saf0o-accent-primary)

    output
      min-width 40px
      color var(--saf0o-text-secondary)
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-caption)
      text-align right

  .interfaceScaleOption
    min-width 56px
    min-height 44px
    padding 0 var(--saf0o-space-2)
    border 0
    border-radius 0
    box-shadow none
    font-size var(--saf0o-type-caption)

    & + .interfaceScaleOption
      border-left 1px solid var(--saf0o-border-default)

    &.saf0oControlGhost:hover:not(:disabled)
      color var(--saf0o-text-primary)
      background-color var(--saf0o-surface-active)
      box-shadow inset 0 0 0 1px var(--saf0o-border-strong)

    &[aria-pressed='true']
      border-color var(--saf0o-accent-primary-hover)
      color var(--saf0o-text-inverse)
      background-color var(--saf0o-accent-primary)
      background-image var(--saf0o-control-texture-light)
      box-shadow var(--saf0o-control-primary-shadow)

    &[aria-pressed='true']:hover:not(:disabled),
    &[aria-pressed='true']:active:not(:disabled),
    &[aria-pressed='true']:focus-visible
      border-color var(--saf0o-control-primary-border-hover)
      color var(--saf0o-text-inverse)
      background-color var(--saf0o-accent-primary-hover)
      background-image var(--saf0o-control-texture-light)
      box-shadow var(--saf0o-control-primary-shadow-hover)

    &:focus-visible
      outline-offset -3px

  .interfaceScaleAnnouncement
    position absolute
    width 1px
    height 1px
    margin -1px
    padding 0
    overflow hidden
    clip rect(0 0 0 0)
    clip-path inset(50%)
    white-space nowrap

  .connectionCustomInput
    margin-top var(--saf0o-space-2)

  .recoverySettings
    display flex
    padding 0 var(--saf0o-space-2)
    flex-direction column
    gap var(--saf0o-space-2)

  .recoveryOption
    display flex
    min-height 72px
    padding var(--saf0o-space-3) 0
    align-items center
    justify-content space-between
    gap var(--saf0o-space-5)

    > button
      min-width 148px
      flex none

  .recoveryOptionCopy
    display flex
    min-width 0
    flex-direction column
    gap var(--saf0o-space-1)

    strong
      color var(--saf0o-text-primary)
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-body)
      font-weight 500

    span
      max-width 560px
      color var(--saf0o-text-tertiary)
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-caption)
      line-height 18px

  .recoveryOptionActions
    display flex
    flex none
    gap var(--saf0o-space-2)

    button
      min-width 132px

  .recoveryPanel
    display flex
    padding var(--saf0o-space-4)
    flex-direction column
    gap var(--saf0o-space-3)
    border 1px solid var(--saf0o-border-subtle)
    border-radius 2px
    color var(--saf0o-text-primary)
    background var(--saf0o-surface-inset)

    > strong
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-body)
      font-weight 600

  .recoveryReplacePanel
    border-color rgba(213, 116, 104, .42)
    background var(--saf0o-danger-soft)

  .recoveryPanelCopy
    margin 0
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-small)
    line-height 19px

  .recoveryFields
    display grid
    grid-template-columns minmax(128px, .34fr) minmax(0, 1fr)
    align-items center
    gap var(--saf0o-space-2) var(--saf0o-space-3)

    label
      color var(--saf0o-text-secondary)
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-small)

    input
      width 100%
      min-height 44px
      padding 0 var(--saf0o-space-3)
      font-family var(--saf0o-font-mono)

  .recoveryActions
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap var(--saf0o-space-2)

  .recoveryError,
  .recoveryStatus
    padding var(--saf0o-space-3)
    border-radius 2px
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-small)
    line-height 18px

  .recoveryError
    color var(--saf0o-danger)
    background var(--saf0o-danger-soft)

  .recoveryStatus
    color var(--saf0o-text-secondary)
    background var(--saf0o-surface-inset)

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

  .recoveryMetadata
    display grid
    margin 0
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap var(--saf0o-space-2)

    > div
      padding var(--saf0o-space-2)
      background var(--saf0o-bg-panel)

    dt,
    dd
      margin 0
      font-family var(--saf0o-font-ui)

    dt
      color var(--saf0o-text-tertiary)
      font-size var(--saf0o-type-caption)

    dd
      margin-top 3px
      color var(--saf0o-text-primary)
      font-size var(--saf0o-type-small)

  .appInfo
    display grid
    min-height 44px
    padding 0 var(--saf0o-space-2)
    grid-template-columns minmax(0, 1fr) auto auto auto
    column-gap var(--saf0o-space-3)
    align-items center
    border-top 0
    color var(--saf0o-text-muted)
    font-size var(--saf0o-type-caption)

    button
      appearance none
      min-height 44px
      border 0
      color inherit
      background transparent
      font-family inherit
      cursor pointer

      &:focus-visible
        outline 2px solid var(--saf0o-focus)
        outline-offset 2px

    .appInfoLine
      display flex
      align-items center
      justify-content center
      text-align center

    .appInfoLineInstanceId
      width 100%
      max-width 100%
      margin 0
      justify-content flex-start
      overflow hidden
      color var(--saf0o-text-muted)
      font-family var(--saf0o-font-mono)
      font-size var(--saf0o-type-caption)
      text-overflow ellipsis
      text-transform none
      white-space nowrap

    .appInfoLineInstanceId,
    .appInfoViewLicense,
    .appInfoLineResetButton
      display inline-flex
      align-items center
      justify-content center

    .instanceIdCopied
      color var(--saf0o-success)
      text-transform none

    .appInfoLineVersion
      color var(--saf0o-text-tertiary)
      font-family var(--saf0o-font-mono)
      font-size var(--saf0o-type-caption)

    .appInfoViewLicense
      margin 0
      color var(--saf0o-text-tertiary)
      font-size var(--saf0o-type-caption)

      &:hover
        color var(--saf0o-text-primary)

    .appInfoLineReset
      width auto
      margin 0
      color var(--saf0o-text-tertiary)
      font-size var(--saf0o-type-caption)
      line-height 24px

      &:has(.appInfoLineResetConfirm)
        width 100%
        grid-column 1 / -1

    .appInfoLineResetConfirm
      display flex
      max-width 520px
      margin var(--saf0o-space-3) auto 0
      padding var(--saf0o-space-3)
      flex-direction column
      gap var(--saf0o-space-2)
      border 1px solid rgba(213, 116, 104, .36)
      border-radius var(--saf0o-radius-sm)
      color var(--saf0o-text-secondary)
      background var(--saf0o-danger-soft)
      font-size var(--saf0o-type-small)
      line-height 18px
      text-align left

      strong
        color var(--saf0o-text-primary)
        font-size var(--saf0o-type-body)
        font-weight 500

    .appInfoLineResetConfirmButtons
      display flex
      justify-content flex-end
      gap var(--saf0o-space-2)

      button
        min-height 40px
        padding 0 var(--saf0o-space-4)

    .appInfoLineResetButton
      padding 0
      color var(--saf0o-text-muted)
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-caption)

      &:hover
        color var(--saf0o-danger)

// Perch Settings landing: shared Control navigation and stacked real settings cards.
.saf0oSettings.saf0oSettingsPerch
  color var(--saf0o-text-secondary)
  justify-content flex-start

  .localSettingsWrap
    width 100%
    padding var(--saf0o-space-5) var(--saf0o-space-4) var(--saf0o-space-6)
    box-sizing border-box

  .saf0oSettingsSection
    position relative
    margin 0 0 var(--saf0o-space-3)
    padding var(--saf0o-space-3) var(--saf0o-space-5) var(--saf0o-space-2)
    box-sizing border-box
    border 1px solid rgba(140, 160, 182, .16)
    border-radius var(--saf0o-radius-lg)
    background linear-gradient(172deg, rgba(255, 255, 255, .022), rgba(255, 255, 255, 0) 46%), var(--saf0o-surface-card)
    box-shadow 0 10px 26px rgba(0, 0, 0, .5)

    &::before
      position absolute
      inset 0
      border-radius inherit
      box-shadow inset 1px 1px 0 rgba(140, 160, 182, .05), inset 0 1px 0 rgba(255, 255, 255, .05)
      content ''
      pointer-events none

  .saf0oSettingsSection + .saf0oSettingsSection
    margin-top 0

  .saf0oSettingsSectionTitle
    margin 0
    padding 0 0 var(--saf0o-space-2)
    color var(--saf0o-text-tertiary)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    font-weight 600
    letter-spacing 1.4px
    line-height 18px
    text-transform uppercase

  .localSetting
    min-height 64px
    margin 0
    padding var(--saf0o-space-2) 0
    border 0
    border-bottom 1px solid rgba(140, 160, 182, .10)
    border-radius 0
    background transparent
    box-shadow none

    &:last-child
      border-bottom 0

    &:hover
      background transparent

    .signerPermissionControls
      min-height 44px
      gap var(--saf0o-space-4)

    .signerPermissionSetting
      color var(--saf0o-text-primary)
      font-size var(--saf0o-type-body)
      font-weight 500

    .signerPermissionDetails
      position absolute
      width 1px
      height 1px
      margin -1px
      padding 0
      overflow hidden
      clip rect(0 0 0 0)
      clip-path inset(50%)
      white-space nowrap

    .dropdownWrap
      height 44px

  .localSettingShortcut,
  .localSettingExplained
    min-height 72px

    .signerPermissionDetails
      position static
      width auto
      height auto
      margin 3px 60px 0 0
      padding 0
      overflow visible
      clip auto
      clip-path none
      color var(--saf0o-text-tertiary)
      font-family var(--saf0o-font-ui)
      font-size var(--saf0o-type-caption)
      line-height 18px
      white-space normal

  .interfaceScaleSetting
    min-height 104px

  .interfaceScaleDescription
    display none

  .interfaceScaleStatus
    color var(--saf0o-text-tertiary)

  .interfaceScaleOptions
    border-color rgba(140, 160, 182, .16)
    border-radius var(--saf0o-radius-md)
    background rgba(8, 11, 18, .34)

  .interfaceScaleOption
    color var(--saf0o-text-tertiary)

    &[aria-pressed='true'],
    &[aria-pressed='true']:hover:not(:disabled),
    &[aria-pressed='true']:active:not(:disabled),
    &[aria-pressed='true']:focus-visible
      color var(--saf0o-text-primary)
      background var(--saf0o-bg-elevated)
      border-color transparent
      box-shadow var(--saf0o-shadow-sm)

  .recoverySettings
    padding 0

  .appInfo
    padding 0

@media (max-height: 760px)
  .saf0oSettings
    .localSettingsWrap
      padding-top 0

    .saf0oSettingsSection + .saf0oSettingsSection
      margin-top var(--saf0o-space-3)

    .saf0oSettingsSectionTitle
      padding-top var(--saf0o-space-3)

    .localSetting
      min-height 52px
      padding-top var(--saf0o-space-2)
      padding-bottom var(--saf0o-space-2)

    .interfaceScaleSetting
      min-height 96px

@media (max-width: 620px)
  .saf0oSettings
    .interfaceScaleHeader
      align-items flex-start
      flex-direction column
      gap var(--saf0o-space-3)

    .interfaceScaleOptions
      width 100%

    .recoveryOption
      align-items stretch
      flex-direction column
      gap var(--saf0o-space-3)

      > button
        width 100%

    .recoveryFields
      grid-template-columns 1fr

    .recoveryMetadata
      grid-template-columns 1fr

    .contractVerificationCredentialControls
      width 100%
      align-items stretch
      flex-direction column

    .contractVerificationCredentialActions
      width 100%
      align-items center
      flex-direction row

    .contractVerificationCredentialInput
      width auto

    .contractVerificationCredentialActions button
      width auto

.settingsCategories
  display flex
  gap var(--saf0o-space-1)
  padding var(--saf0o-space-1)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-md)
  background var(--saf0o-surface-inset)

  button.saf0oControl.saf0oControlGhost
    flex 1
    min-width 0
    min-height 44px
    height auto
    padding var(--saf0o-space-2)
    font-size var(--saf0o-type-small)
    border-color transparent
    border-radius var(--saf0o-radius-sm)

    &[aria-pressed='true'],
    &[aria-pressed='true']:hover:not(:disabled)
      border-color var(--saf0o-border-subtle)
      color var(--saf0o-text-primary)
      background var(--saf0o-surface-active)
      box-shadow var(--saf0o-shadow-sm)
  flex-wrap wrap
  margin-bottom var(--saf0o-space-5)

.saf0oSettingsSection[hidden]
  display none

.settings .recentRecipientsClear,
.recentRecipientsClear.localSetting
  border-bottom 0

.localSettings .saf0oSettingsSection .localSetting.recentRecipientsClear
  border-bottom 0

.recentRecipientsOverlay
  position fixed
  z-index 50000000
  inset 0
  display flex
  align-items center
  justify-content center
  padding var(--saf0o-space-5)
  box-sizing border-box
  background rgba(9, 11, 18, .72)
  backdrop-filter blur(4px)

  .recentRecipientsDialog
    width 100%
    max-width 440px
    max-height 100%
    overflow-y auto
    margin 0
    box-sizing border-box
