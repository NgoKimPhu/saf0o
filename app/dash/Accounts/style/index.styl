.dashAccountsPerch
  color var(--saf0o-text-primary)
  justify-content flex-start

  .localSettingsWrap
    width 100%
    padding var(--saf0o-space-5) var(--saf0o-space-4) var(--saf0o-space-6)
    box-sizing border-box

  .dashHomeCard
    padding var(--saf0o-space-3) var(--saf0o-space-5)

  .dashAccountsSignerCard
    padding-bottom var(--saf0o-space-2)

.dashAccountsCardHeader
  display flex
  min-height 34px
  align-items flex-start
  justify-content space-between

  h2
    margin 0
    color var(--saf0o-text-tertiary)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    font-weight 600
    letter-spacing 1.4px
    line-height 18px
    text-transform uppercase

.dashAccountSignerLedger
  width 100%

.dashAccountSigner
  appearance none
  display grid
  width 100%
  min-height 72px
  padding 0
  grid-template-columns 42px minmax(0, 1fr) auto 16px
  align-items center
  gap var(--saf0o-space-3)
  border 0
  border-top 1px solid rgba(140, 160, 182, .10)
  color var(--saf0o-text-primary)
  background transparent
  font-family var(--saf0o-font-ui)
  text-align left
  cursor pointer

  &:first-child
    border-top 0

  &:hover
    background var(--saf0o-surface-hover)

  &:active
    background var(--saf0o-pressed)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset -2px

.dashAccountSignerIcon
  display flex
  width 42px
  height 42px
  align-items center
  justify-content center
  box-sizing border-box
  border 1px solid rgba(140, 160, 182, .18)
  border-radius var(--saf0o-radius-md)
  color var(--saf0o-text-secondary)
  background rgba(18, 23, 30, .72)

.dashAccountSignerIdentity
  display flex
  min-width 0
  flex-direction column
  gap 3px

  strong,
  span
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  strong
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-body)
    font-weight 500

  span
    color var(--saf0o-text-tertiary)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)

.dashAccountSignerRole
  color var(--saf0o-text-tertiary)
  font-family var(--saf0o-font-utility)
  font-size var(--saf0o-type-caption)
  text-transform capitalize

.dashAccountsAddCard
  padding-bottom var(--saf0o-space-4) !important

.dashAccountsActions
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap var(--saf0o-space-2)

  button
    appearance none
    display flex
    min-width 0
    min-height 44px
    padding 0 var(--saf0o-space-3)
    align-items center
    justify-content center
    gap var(--saf0o-space-2)
    border 1px solid rgba(140, 160, 182, .16)
    border-radius var(--saf0o-radius-md)
    color var(--saf0o-text-secondary)
    background var(--saf0o-bg-elevated)
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .018)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-small)
    font-weight 500
    text-align center
    cursor pointer
    transition border-color var(--saf0o-motion-fast) var(--saf0o-ease), background var(--saf0o-motion-fast) var(--saf0o-ease)

    svg
      flex none
      color currentColor

    &:hover
      border-color rgba(140, 160, 182, .25)
      color var(--saf0o-text-primary)
      background var(--saf0o-surface-hover)

    &:active
      background var(--saf0o-pressed)

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset 2px

.dashAccountsWatchCard
  padding-bottom var(--saf0o-space-3) !important

  .dashAccountsEmptyCopy
    min-height 36px

  .watchAccount
    min-height 62px
    padding 0

  .watchAccount:hover
    background var(--saf0o-surface-hover)

  .watchAccount:active
    background var(--saf0o-pressed)

  .watchAccountIcon
    width 42px
    height 42px
    margin-right var(--saf0o-space-3)
    border 1px solid rgba(140, 160, 182, .18)
    border-radius var(--saf0o-radius-md)
    color var(--saf0o-text-secondary)
    background rgba(18, 23, 30, .72)

  .watchAccountName
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-body)
    font-weight 500

  .watchAccountAddress
    color var(--saf0o-text-tertiary)
    font-size var(--saf0o-type-caption)

.dashAccountsEmptyCopy
  min-height 52px
  margin 0
  display flex
  align-items center
  color var(--saf0o-text-tertiary)
  font-size var(--saf0o-type-small)
  line-height 1.5

.dashAccountsPerch > .localSettingsWrap > .delegationRevocation
  margin 80px 0 var(--saf0o-space-3)
  padding var(--saf0o-space-4) var(--saf0o-space-5)
  border 1px solid rgba(140, 160, 182, .16)
  border-radius var(--saf0o-radius-lg)
  background linear-gradient(172deg, rgba(255, 255, 255, .022), rgba(255, 255, 255, 0) 46%), var(--saf0o-surface-card)
  box-shadow 0 10px 26px rgba(0, 0, 0, .5)

@media (max-width: 560px)
  .dashAccountsActions
    grid-template-columns repeat(3, minmax(0, 1fr))

    button
      padding 0 var(--saf0o-space-2)
      font-size var(--saf0o-type-caption)

.accountTypeAdvanced > h2
  margin var(--saf0o-space-5) 0 0
  padding var(--saf0o-space-3) 0
  color var(--saf0o-text-muted)
  font-size var(--saf0o-type-caption)
  font-weight 500
  line-height 20px
.dashAccountsActions
  grid-template-columns repeat(2, minmax(0, 1fr))

.accountDelegationEntry
  margin var(--saf0o-space-5) 0

  > summary
    display flex
    align-items center
    justify-content space-between
    min-height 44px
    padding 0 var(--saf0o-space-4)
    box-sizing border-box
    border 1px solid var(--saf0o-border-subtle)
    border-radius var(--saf0o-radius-md)
    color var(--saf0o-text-muted)
    background var(--saf0o-surface-card)
    cursor pointer
    list-style none
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    font-weight 600
    letter-spacing 1.4px
    text-transform uppercase
    transition border-color var(--saf0o-motion-fast) var(--saf0o-ease), color var(--saf0o-motion-fast) var(--saf0o-ease)

    &::-webkit-details-marker
      display none

    &::after
      width 6px
      height 6px
      border-right 1.5px solid currentColor
      border-bottom 1.5px solid currentColor
      content ''
      transform translateY(-2px) rotate(45deg)
      transition transform var(--saf0o-motion-fast) var(--saf0o-ease)

    &:hover
      border-color var(--saf0o-border-default)
      color var(--saf0o-text-secondary)

  &[open] > summary::after
    transform translateY(2px) rotate(-135deg)

.accountDelegationEntry .delegationRevocation
  margin-top 0
  padding-top var(--saf0o-space-2)
