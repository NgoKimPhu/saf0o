html, body
  margin 0
  border 0
  font-family 'MainFont'
  font-weight 300
  -webkit-app-region no-drag
  overflow hidden
  color var(--outerspace)
  background transparent

button,
[role='button']
  user-select none

::-webkit-scrollbar
  width 6px
  height 6px
  background transparent

::-webkit-scrollbar-track
  background transparent

::-webkit-scrollbar-thumb
  border 2px solid transparent
  border-radius 2px
  background-color unquote('color-mix(in srgb, var(--saf0o-text-muted) 40%, transparent)')
  background-clip content-box

::-webkit-scrollbar-thumb:hover
  background-color unquote('color-mix(in srgb, var(--saf0o-text-muted) 60%, transparent)')

.dash
  width 100%
  height 100%
  overflow-y scroll
  overflow-x hidden
  position relative
  box-sizing border-box
  border 0

  .dashMain
    position absolute 
    top 80px
    right 12px
    bottom 24px
    left 12px
    z-index 1000
    background var(--ghostZ)
    border 1px solid var(--saf0o-border-subtle)
    border-radius 16px
    padding-bottom 20px
    transition var(--standard)

    .dashMainScroll
      position absolute 
      top 0px
      right 0px
      bottom 0px
      left 0px
      z-index 2000
      border-radius 16px
      overflow-y scroll
      overflow-x hidden

    .dashMainOverlay
      position absolute
      top 0px
      right 0px
      bottom 0px
      left 0px
      border-radius 16px
      z-index 40000000
      box-shadow inset 0px 0px 6px var(--ghostY)
      pointer-events none

    .originTitle
      margin 30px 8px 5px 0px
      font-size 18px
      display flex
      align-items center
      font-weight 400

      .originTitleIcon
        margin 9px 16px

      .originTitleText
        margin-top -2px

    .clearOriginsButton
      background var(--ghostA)
      margin 74px 6px 7px 6px
      height 38px
      border-radius 20px
      font-weight 500
      box-sizing border-box
      padding 18px 16px 16px 17px
      text-align center
      margin-bottom 5px
      display flex
      justify-content center
      align-items center
      font-size 13px
      text-transform uppercase
      cursor pointer
      border-bottom 2px solid var(--ghostZ)
      box-shadow 0px 2px 4px var(--ghostY)
      letter-spacing 1px
      transform translateY(0px)
      *
        pointer-events none

    .clearOriginsButton:hover
      background var(--ghostB)
      box-shadow 0px 4px 8px var(--ghostY)
      transform translateY(-1px)

    .clearOriginsButton:active
      background var(--ghostB)
      box-shadow 0px 1px 2px var(--ghostY)
      transform translateY(0px)

  .dashFooter
    background var(--ghostZ)
    position absolute
    bottom 24px
    height 60px
    left 12px
    right 12px
    border-radius 16px
    padding 3px 3px 1px 3px
    box-sizing border-box

    .dashFooterButton
      height 56px
      position relative
      background var(--ghostA)
      border-radius 12px
      display flex
      justify-content center
      align-items center
      cursor pointer
      font-size 16px
      box-shadow 0px 2px 4px var(--ghostY)
      border-bottom 2px solid var(--ghostZ)
      box-sizing border-box
      box-sizing border-box
      letter-spacing 1px
      color var(--outerspace)
      font-family 'MainFont'
      font-weight 400
      z-index 5
      transform translateY(0px)

      *
        pointer-events none

      .newAccountIcon
        position absolute
        top 0
        left 0
        bottom 0px
        width 64px
        font-size 28px
        display flex
        justify-content center
        align-items center
        font-weight 300
      
    .newAccount:hover
      background var(--ghostB)

  .dashFooterButton:hover
    transform translateY(-1px)
    box-shadow 0px 4px 8px var(--ghostY)
    background var(--ghostB)

  .dashFooterButton:active
    transform translateY(0px)
    box-shadow 0px 1px 2px var(--ghostY)
    background var(--ghostB)

  .panelScrollOverlay
    position absolute
    top 0px
    right 0px
    bottom 0px
    left 0px
    border-radius 16px
    z-index 40000000
    box-shadow inset 0px 0px 6px var(--ghostX)
    pointer-events none

  .addAccounts
    position absolute
    top 0px
    left 0
    right 0
    bottom 0
    background var(--ghostZ)
    z-index 4000
    overflow-y scroll
    overflow-x hidden
    padding-bottom 60px

    .addAccountsHeader
      .addAccountsHeaderTitle
        margin-top 20px
        margin-bottom 20px
        font-size 14px
        font-weight 400
        height 50px
        display flex
        justify-content center
        align-items center

      .addAccountsHeaderClose
        position absolute
        top 18px
        right 10px
        border-radius 8px
        cursor pointer
        background var(--ghostB)
        width 90px
        height 30px
        display flex
        justify-content center
        align-items center
        text-transform uppercase
        font-size var(--saf0o-type-caption)
        letter-spacing 1px
        font-weight 300
        padding-bottom 1px
        padding-left 1px
        display none

        *
          pointer-events none

      .addAccountsHeaderClose:hover
        background var(--ghostC)

    .accountTypeSelect
      appearance none
      height 100px
      width calc(100% - 12px)
      padding 0
      color inherit
      font-family inherit
      font-weight 400
      border-radius 27px
      margin 6px 6px 8px 6px
      display flex
      justify-content center
      align-items center
      cursor pointer
      background var(--ghostA)
      box-shadow 0px 4px 8px var(--ghostY)
      font-size 16px
      border 0
      border-bottom 2px solid var(--ghostZ)
      transform translateY(0px)
      position relative
      *
        pointer-event none

      .accountTypeSelectIcon
        margin-right 16px

    .accountTypeSelect:hover
      transform translateY(-1px)
      box-shadow 0px 4px 12px var(--ghostY)
      background var(--ghostB)
      z-index 200

    .accountTypeSelect:active
      transform translateY(0px)
      box-shadow 0px 2px 4px var(--ghostY)
      z-index 201

  .signers
    width 100%

    .signersHeader
      width calc(100% - 32px)
      display flex
      justify-content center
      align-items center
      position relative
      height 32px
      margin 0px 16px 12px 16px
      box-sizing border-box
      font-size var(--saf0o-type-small)
      text-transform uppercase
      letter-spacing 1px
      font-weight 400

    .noSigners
      position relative
      width 100%
      height 48px
      overflow hidden
      background var(--ghostA)
      box-sizing border-box
      margin 0px 0px 40px 0px
      border-radius 12px
      display flex
      justify-content center
      align-items center
      font-size var(--saf0o-type-caption)
      font-weight 400
      letter-spacing 2px
      text-transform uppercase
      box-shadow 0px 4px 8px var(--ghostY)

    .signersMid
      padding 0px 6px 64px 6px

    .signersList
      display flex
      flex-wrap wrap

@import './Chains/style'
@import './Dapps/style'
@import './Command/style'
@import './Main/style'
@import './Accounts/style'
@import './Accounts/Add/style'
@import './Signer/style'
@import './Notify/style'
@import './Tokens/style'
@import './AddressBook/style'
@import './Settings/style'
@import './Inspector/style'
@import './Deployment/style'
@import './ContractVerification/style'
@import './card.styl'

// Saf0o dashboard shell
.frameOverlay
  display none

.dash
  --saf0o-window-mode-canvas var(--saf0o-window-canvas)
  --saf0o-window-mode-image var(--saf0o-window-atmosphere-workspace-right)
  --saf0o-window-mode-repeat var(--saf0o-window-atmosphere-repeat)
  --saf0o-window-mode-size var(--saf0o-window-atmosphere-workspace-size)
  --saf0o-window-mode-blend var(--saf0o-window-atmosphere-blend)
  --saf0o-window-mode-shadow var(--saf0o-window-atmosphere-workspace-shadow)
  background-color unquote("color-mix(in srgb, var(--saf0o-window-mode-canvas) calc(var(--saf0o-window-alpha, .7) * 100%), transparent)")
  background-image var(--saf0o-window-mode-image)
  background-repeat var(--saf0o-window-mode-repeat)
  background-size var(--saf0o-window-mode-size)
  background-blend-mode var(--saf0o-window-mode-blend)
  box-shadow var(--saf0o-window-mode-shadow)
  overflow hidden
  cursor default
  user-select none

  input,
  textarea,
  [contenteditable='true']
    cursor text
    user-select text

  > .command,
  > .dashMain,
  > .dashFooter
    opacity 1
    transition opacity var(--saf0o-motion-slow) var(--saf0o-ease)

  .dashMain
    top 64px
    right 0
    bottom 0
    left 0
    padding-bottom 0
    overflow hidden
    border 0
    border-radius 0
    background transparent
    box-shadow none

    .dashMainScroll
      border-radius 0
      overflow-y auto
      scrollbar-gutter stable both-edges

    &:has(.sendComposer) .dashMainScroll,
    &:has(.addAccounts) .dashMainScroll,
    &:has(.addressBookEditor) .dashMainScroll,
    &:has(.networkEditor) .dashMainScroll
      overflow-y hidden
      scrollbar-gutter auto

      > .cardShow
        animation none

    .dashMainOverlay
      display none
      border-radius 0
      box-shadow none

    // Ordinary dashboard destinations sit directly on the shared workspace
    // canvas; focused notification and signing surfaces keep their own fills.
    .localSettings
      background transparent

    .dashControlShell
      min-height 100%
      padding 16px 18px 24px
      box-sizing border-box

      > .dashControlNavigation
        width 100%
        margin 0 0 16px
        box-sizing border-box

    .dashControlContent
      min-width 0

      .cardShow
        animation none

      > .localSettings,
      > .connectedApps
        position static
        inset auto
        min-height 0

      .localSettingsWrap
        padding 0

  .dashFooter
    display flex
    align-items center
    justify-content flex-end
    right 20px
    bottom 16px
    left 20px
    height 46px
    padding 0
    border 0
    border-radius 0
    background transparent
    pointer-events none

    .dashFooterButton
      width auto
      min-width 190px
      height 46px
      min-height 46px
      padding 0 var(--saf0o-space-4)
      border 1px solid var(--saf0o-accent-primary-hover)
      border-radius 7px
      color #11130f
      background-color var(--saf0o-accent-primary)
      background-image var(--saf0o-control-texture-light)
      box-shadow var(--saf0o-control-primary-shadow)
      font-family var(--saf0o-font-ui)
      font-size 13px
      font-weight 500
      letter-spacing 0
      pointer-events auto

      &:hover
        transform none
        border-color var(--saf0o-control-primary-border-hover)
        background-color var(--saf0o-accent-primary-hover)
        background-image var(--saf0o-control-texture-light)
        box-shadow var(--saf0o-control-primary-shadow-hover)

      &:active
        transform translateY(1px)
        background-color var(--saf0o-accent-primary-active)
        box-shadow var(--saf0o-control-primary-shadow-pressed)

      .newAccountIcon
        position static
        width auto
        height auto
        margin-right var(--saf0o-space-2)

  // An inactive network is a neutral availability state, not an error.
  .network .signerPermissionToggle
    width 44px
    height 44px
    margin-top 0
    border 0
    background transparent
    box-shadow none

    &::before
      position absolute
      top 10px
      left 0
      width 44px
      height 24px
      box-sizing border-box
      border 1px solid var(--saf0o-border-default)
      border-radius 2px
      content ''
      background var(--saf0o-surface-inset)
      box-shadow var(--saf0o-shadow-inset)
      transition border-color var(--saf0o-motion-fast) var(--saf0o-ease), background var(--saf0o-motion-fast) var(--saf0o-ease)

    .signerPermissionToggleSwitch
      top 14px
      left 4px
      bottom auto
      width 16px
      height 16px
      border 0
      border-bottom 2px solid var(--saf0o-border-strong)
      border-radius 1px
      background var(--saf0o-text-secondary)
      box-shadow var(--saf0o-shadow-sm)
      transition background var(--saf0o-motion-fast) var(--saf0o-ease), opacity var(--saf0o-motion-fast) var(--saf0o-ease), transform var(--saf0o-motion-fast) var(--saf0o-ease)

  .network .signerPermissionToggleOn
    &::before
      border-color var(--saf0o-success)
      background var(--saf0o-success-soft)

    .signerPermissionToggleSwitch
      background var(--saf0o-success)
      transform translateX(20px)

  .network .signerPermissionToggle:disabled
    opacity 1
    cursor default

    &::before
      border-color var(--saf0o-border-strong)

    .signerPermissionToggleSwitchLocked
      inset 0
      border-radius 2px
      cursor default

      .signerPermissionToggleSwitch
        opacity 1

      svg
        position absolute
        z-index 1
        top 17px
        left 7px
        opacity 1
        color var(--saf0o-text-muted)
        transition color var(--saf0o-motion-fast) var(--saf0o-ease)

.workspace-edge-left .dash,
.workspace-overlay .dash
  --saf0o-window-mode-image var(--saf0o-window-atmosphere-workspace-left)

.dash:has(.dashHomePerch),
.dash:has(.dashNetworksPerch),
.dash:has(.dashAccountsPerch),
.dash:has(.saf0oSettingsPerch),
.dash:has(.connectedAppsPerch),
.dash:has(.sendComposer)
  --saf0o-window-mode-image var(--saf0o-window-atmosphere-wallet)
  --saf0o-window-mode-size var(--saf0o-window-atmosphere-wallet-size)
  --saf0o-window-mode-shadow var(--saf0o-window-atmosphere-wallet-shadow)

.workspace-edge-right .dash
  border-top-left-radius var(--saf0o-radius-xl)
  border-top-right-radius 0
  border-bottom-right-radius 0
  border-bottom-left-radius var(--saf0o-radius-xl)

.workspace-edge-left .dash
  border-top-left-radius 0
  border-top-right-radius var(--saf0o-radius-xl)
  border-bottom-right-radius var(--saf0o-radius-xl)
  border-bottom-left-radius 0

.workspace-overlay .dash
  border 0
  border-radius var(--saf0o-radius-xl)

.workspace-content-prepared .dash
  > .command,
  > .dashMain,
  > .dashFooter
    opacity 0
    transition none
    animation saf0oShellContentRevealFallback 0s linear 700ms forwards

.workspace-content-concealing .dash
  background transparent

  > .command,
  > .dashMain,
  > .dashFooter
    opacity 0
    transition-duration var(--saf0o-motion-standard)

// Renderer-side opening failsafe: a missed prepared-state reveal must not
// leave a visible workspace blank. Conceal remains fail-closed until main hides
// the native window or sends an explicit reveal.
@keyframes saf0oShellContentRevealFallback
  to
    opacity 1

// Saf0o account chooser
.dash .dashMain .addAccounts
  background transparent

.dash .dashMain .addAccounts.addAccountsChooser
  display block
  padding 0 var(--saf0o-page-gutter) var(--saf0o-space-6)
  box-sizing border-box

  .addAccountsHeader
    .addAccountsHeaderTitle
      height auto
      margin var(--saf0o-space-5) var(--saf0o-space-2) var(--saf0o-space-4)
      justify-content flex-start
      color var(--saf0o-text-secondary)
      font-size var(--saf0o-type-body)
      font-weight 500

  .accountTypeGroup + .accountTypeGroup
    margin-top var(--saf0o-space-5)

  .accountTypeGroup
    overflow hidden
    border 1px solid rgba(150, 182, 150, .16)
    border-radius 10px
    background var(--saf0o-surface-card)
    box-shadow 0 10px 26px rgba(0, 0, 0, .38), inset 1px 1px 0 rgba(150, 182, 150, .04)

  .accountTypeGroupTitle
    margin 0
    padding 12px 16px 10px
    border-bottom 1px solid var(--saf0o-ledger-rule)
    color var(--saf0o-text-tertiary)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    font-weight 600
    letter-spacing 1.2px
    line-height 18px
    text-transform uppercase

  .accountTypeList
    border 0

  .accountTypeSelect
    width 100%
    height 56px
    margin 0
    gap 10px
    padding 0 16px
    justify-content flex-start
    border 0
    border-bottom 1px solid var(--saf0o-ledger-rule)
    border-radius 0
    color var(--saf0o-text-primary)
    background transparent
    box-shadow none
    font-family var(--saf0o-font-ui)
    font-size 15px
    font-weight 500
    text-align left
    transform none
    transition background var(--saf0o-motion-fast) var(--saf0o-ease)

    .accountTypeSelectIcon
      display flex
      width 24px
      margin-right var(--saf0o-space-3)
      align-items center
      justify-content center
      color var(--saf0o-accent-primary-hover)

    &:hover
      z-index auto
      transform none
      background var(--saf0o-surface-hover)
      box-shadow none

    &:active
      transform none
      background var(--saf0o-surface-active)
      box-shadow none

    &:focus-visible
      outline 2px solid var(--saf0o-focus)
      outline-offset -2px

    &:last-child
      border-bottom 0

.accountsEmpty
  min-height 620px
  display flex
  align-items center
  justify-content center

  .saf0oEmptyStateExpanded
    min-height 340px
    padding 0
    flex-direction column
    justify-content center
    background transparent
    text-align center

    .saf0oEmptyStateImage
      position static
      width 220px
      margin 0 0 var(--saf0o-space-3)
      transform none

    .saf0oEmptyStateText
      max-width 360px

    .saf0oEmptyStateTitle
      font-size var(--saf0o-type-body)

    .saf0oEmptyStateCopy
      font-size var(--saf0o-type-small)

.watchAccounts
  width 100%

.watchAccount
  appearance none
  display flex
  align-items center
  width 100%
  min-height 72px
  box-sizing border-box
  padding 0 var(--saf0o-space-2)
  border 0
  color var(--saf0o-text-primary)
  background transparent
  font-family var(--saf0o-font-ui)
  text-align left
  cursor pointer
  transition background var(--saf0o-motion-fast) var(--saf0o-ease)

  &:hover
    background var(--saf0o-ledger-hover)

  &:active
    background var(--saf0o-surface-active)

  &:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset -2px

  > svg
    flex none
    color var(--saf0o-text-tertiary)

.watchAccountIcon
  display flex
  align-items center
  justify-content center
  width 38px
  height 38px
  flex none
  margin-right var(--saf0o-space-3)
  border 0
  color var(--saf0o-accent-primary-hover)
  background transparent

.watchAccountIdentity
  display flex
  min-width 0
  flex 1
  flex-direction column
  gap 3px

.watchAccountName
  overflow hidden
  font-size var(--saf0o-type-body)
  font-weight 560
  text-overflow ellipsis
  white-space nowrap

.watchAccountAddress
  overflow hidden
  color var(--saf0o-text-muted)
  font-family var(--saf0o-font-mono)
  font-size var(--saf0o-type-caption)
  text-overflow ellipsis
  white-space nowrap

.delegationRevocation
  width 100%
  box-sizing border-box
  margin var(--saf0o-space-5) 0 0
  padding var(--saf0o-space-4) var(--saf0o-space-2)
  color var(--saf0o-text-primary)
  background transparent

.delegationRevocationHeader
  display flex
  align-items flex-start
  justify-content space-between
  padding-bottom var(--saf0o-space-3)
  margin-bottom var(--saf0o-space-3)

  h2
    margin 0
    font-family var(--saf0o-font-heading)
    font-size var(--saf0o-type-body)
    font-variation-settings var(--saf0o-font-heading-settings)
    font-weight 600

  p
    margin var(--saf0o-space-1) 0 0
    color var(--saf0o-text-secondary)
    font-size 12px
    line-height 1.45

.delegationRevocationSelectors
  display grid
  grid-template-columns minmax(0, 1.35fr) minmax(160px, .65fr)
  gap var(--saf0o-space-3)
  padding var(--saf0o-space-3) 0

  label
    display flex
    min-width 0
    flex-direction column
    gap var(--saf0o-space-1)
    color var(--saf0o-text-secondary)
    font-size 12px

    small
      color var(--saf0o-text-muted)
      font-size 12px
      line-height 1.4

  select
    width 100%
    min-height 44px
    box-sizing border-box
    color var(--saf0o-text-primary)
    background var(--saf0o-surface-inset)

.delegationRevocationMessage
  min-height 44px
  box-sizing border-box
  margin 0
  padding var(--saf0o-space-3) 0 0
  color var(--saf0o-text-secondary)
  font-size 12px
  line-height 1.5

.delegationRevocationEligible
  display flex
  align-items center
  justify-content space-between
  gap var(--saf0o-space-4)
  padding-top var(--saf0o-space-3)

  > button.saf0oControl.saf0oControlPrimary
    height 44px
    min-height 44px
    flex none

.delegationRevocationIdentity
  display flex
  min-width 0
  flex-direction column
  gap 3px

  span,
  small
    color var(--saf0o-text-secondary)
    font-size 12px

  strong
    overflow hidden
    font-family var(--saf0o-font-mono)
    font-size 12px
    font-weight 500
    text-overflow ellipsis
    white-space nowrap

@media (max-width: 540px)
  .delegationRevocationSelectors
    grid-template-columns 1fr

  .delegationRevocationEligible
    align-items stretch
    flex-direction column

    > button
      width 100%

@media (max-height: 760px)
  .accountsEmpty
    min-height 450px

  .dash .dashMain .addAccounts.addAccountsChooser
    .accountTypeGroup + .accountTypeGroup
      margin-top var(--saf0o-space-2)

    .accountTypeSelect
      height 52px

@import '../../resources/Components/Button'
@import '../../resources/Components/Input'
@import './Send/style/index'
@import './Contracts/style/index'

.walletRecovery
  position absolute
  right 0
  top 0
  width 100%
  max-width 620px
  height 100%
  box-sizing border-box
  padding var(--saf0o-space-6)
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap var(--saf0o-space-5)
  background var(--saf0o-bg-canvas)
  color var(--saf0o-text-primary)
  border-radius var(--saf0o-radius-xl)

.walletRecoveryActions
  display flex
  gap var(--saf0o-space-3)

  button
    font inherit
    color var(--saf0o-text-primary)
    padding 12px 18px
    border 1px solid var(--saf0o-border-default)
    border-radius var(--saf0o-radius-md)
    background var(--saf0o-bg-elevated)
    box-shadow var(--saf0o-control-shadow)
    cursor pointer

    &:hover
      box-shadow var(--saf0o-control-shadow-hover)

    &:active
      box-shadow var(--saf0o-control-shadow-pressed)

    &:focus-visible
      outline 2px solid var(--saf0o-text-muted)
      outline-offset 3px

// Slide out and park with the tray panel while the wallet is hidden, and slide back in with it.
// Windows reshows the hidden view's last frame on reopen; parked, that frame is empty instead of
// a stale sidebar flashing before the slide (same as .suspend in app/tray/index.styl).
@keyframes dashSlideInRight
  from
    transform translateX(100%)

@keyframes dashSlideInLeft
  from
    transform translateX(-100%)

.workspace-edge-right.suspend .dash
  transform translateX(100%)
  transition transform 40ms ease-in

.workspace-edge-left.suspend .dash
  transform translateX(-100%)
  transition transform 40ms ease-in

.workspace-edge-right:not(.suspend) .dash
  animation dashSlideInRight 180ms ease-out 40ms backwards

.workspace-edge-left:not(.suspend) .dash
  animation dashSlideInLeft 180ms ease-out 40ms backwards

@media (prefers-reduced-motion: reduce)
  .suspend .dash
    transition none !important

  .workspace-edge-right:not(.suspend) .dash,
  .workspace-edge-left:not(.suspend) .dash
    animation none !important
