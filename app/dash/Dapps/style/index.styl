.connectedApps
  display flow-root
  width 100%
  min-height 100%
  box-sizing border-box
  padding 0 var(--saf0o-page-gutter) var(--saf0o-space-8)

.connectedAppsPerch
  padding 0

  .sliceOriginGroup
    margin-bottom var(--saf0o-space-3)
    overflow hidden
    border 1px solid rgba(140, 160, 182, .16)
    border-radius var(--saf0o-radius-lg)
    background var(--saf0o-surface-card)
    box-shadow 0 10px 26px rgba(0, 0, 0, .42), inset 1px 1px 0 rgba(140, 160, 182, .045)

  .originTitle
    min-height 48px
    margin 0
    padding 0 var(--saf0o-space-4)
    box-sizing border-box
    border-bottom 1px solid var(--saf0o-ledger-rule)
    color var(--saf0o-text-tertiary)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    font-weight 600
    letter-spacing 1.2px
    text-transform uppercase

    .originTitleIcon
      margin 0 var(--saf0o-space-3) 0 0

    .originTitleText
      margin 0

  .sliceOriginList
    margin 0 var(--saf0o-space-5) var(--saf0o-space-2)
    border-top 0

// The legacy dashboard shell has a higher-specificity origin header. Keep the
// Perch chain header and rows on the same compact ledger rhythm.
.dash .dashMain .connectedAppsPerch
  .originTitle
    display flex
    align-items center
    height 44px
    min-height 44px
    margin 0
    padding 0 var(--saf0o-space-4)
    box-sizing border-box
    color var(--saf0o-text-secondary)
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-small)
    font-weight 600
    letter-spacing .1px
    line-height 20px
    text-transform none

    .originTitleIcon
      display flex
      flex 0 0 24px
      height 44px
      margin 0 var(--saf0o-space-2) 0 0
      align-items center
      justify-content center

    .originTitleText
      display flex
      min-height 44px
      margin 0
      align-items center
      line-height 20px

  .sliceOrigin
    min-height 52px
    padding-top var(--saf0o-space-2)
    padding-bottom var(--saf0o-space-2)

.sliceTileUsage
  display flex
  align-items center
  justify-content center
  width 100%
  height 100%
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-caption)
  font-weight 400
  text-transform none

  .sliceTileUsageCount
    display flex
    align-items center
    justify-content center
    margin-right var(--saf0o-space-2)
    color var(--saf0o-text-primary)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-body)

.sliceOrigin
  appearance none
  display flex
  align-items center
  width 100%
  min-height 60px
  box-sizing border-box
  margin 0
  padding var(--saf0o-space-2) var(--saf0o-space-3)
  border 0
  border-bottom 1px solid var(--saf0o-ledger-rule)
  border-radius 0
  color var(--saf0o-text-primary)
  background transparent
  font-family var(--saf0o-font-ui)
  font-size var(--saf0o-type-small)
  text-align left
  cursor pointer
  transition background var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease)

  *
    pointer-events none

.sliceOriginIdentity
  display flex
  flex 1
  min-width 0
  flex-direction column
  align-items flex-start
  padding 0 var(--saf0o-space-3) 0 var(--saf0o-space-3)

  .sliceOriginTitle
    max-width 100%
    overflow hidden
    color var(--saf0o-text-primary)
    font-weight 500
    text-overflow ellipsis
    white-space nowrap

  .sliceOriginStatus
    margin-top 2px
    color var(--saf0o-text-tertiary)
    font-family var(--saf0o-font-utility)
    font-size var(--saf0o-type-caption)
    line-height 14px

.sliceOrigin:hover
  background var(--saf0o-ledger-hover)

.sliceOrigin:active
  background var(--saf0o-surface-active)

.sliceOrigin:focus-visible
  outline 2px solid var(--saf0o-focus)
  outline-offset 2px

.sliceOriginGroup
  display block

.sliceOriginList
  margin 0 0 var(--saf0o-space-3)
  border-top 1px solid var(--saf0o-ledger-rule)

  .sliceOrigin:last-child
    border-bottom 0

@media (max-width: 560px)
  .connectedAppsPerch .sliceOriginList
    margin-right var(--saf0o-space-3)
    margin-left var(--saf0o-space-3)

.sliceOrigin:disabled
  color var(--saf0o-text-disabled)
  cursor not-allowed
  opacity .65

.sliceOriginIndicator
  flex 0 0 auto
  width 8px
  height 8px
  border-radius 50%
  background var(--saf0o-success)

.sliceOriginIndicatorOff
  background var(--saf0o-text-muted)

.connectedAppsEmpty
  display flex
  flex-direction column
  align-items center
  justify-content center
  min-height 410px
  box-sizing border-box
  padding 28px var(--saf0o-space-6) var(--saf0o-space-12)
  color var(--saf0o-text-secondary)
  text-align center

  .connectedAppsEmptyArtwork
    display block
    width min(100%, 420px)
    max-height 230px
    margin-bottom var(--saf0o-space-4)
    object-fit contain

  strong
    color var(--saf0o-text-primary)
    font-size var(--saf0o-type-sub)
    font-weight 600

  span
    max-width 340px
    margin-top var(--saf0o-space-2)
    font-size var(--saf0o-type-small)
    line-height 20px

.originSwapOrigin
  display flex
  align-items center
  justify-content center
  min-height 112px
  padding var(--saf0o-space-4)
  box-sizing border-box
  color var(--saf0o-text-primary)
  font-size var(--saf0o-type-heading)
  font-weight 500

  .originSwapOriginText
    margin-left var(--saf0o-space-2)

.originSwapTitle
  padding 0 var(--saf0o-space-4) var(--saf0o-space-2)
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-small)
  font-weight 500
  text-transform none

.originSwapChainList
  margin var(--saf0o-space-2)
  padding var(--saf0o-space-1)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-md)
  background var(--saf0o-surface-inset)

  .originChainItem
    appearance none
    position relative
    display flex
    align-items center
    width 100%
    min-height 58px
    box-sizing border-box
    margin 0
    padding var(--saf0o-space-2) 52px var(--saf0o-space-2) var(--saf0o-space-2)
    border 1px solid transparent
    border-radius var(--saf0o-radius-sm)
    color var(--saf0o-text-primary)
    background transparent
    font-family var(--saf0o-font-ui)
    font-size var(--saf0o-type-body)
    font-weight 500
    text-align left
    cursor pointer
    transition background var(--saf0o-motion-fast) var(--saf0o-ease), border-color var(--saf0o-motion-fast) var(--saf0o-ease)

  .originChainItem:hover
    border-color var(--saf0o-border-default)
    background var(--saf0o-surface-hover)

  .originChainItem:active
    background var(--saf0o-surface-active)

  .originChainItem:focus-visible
    outline 2px solid var(--saf0o-focus)
    outline-offset 2px

  .originChainItem:disabled
    cursor default
    opacity .65

  .originChainItemIcon
    display flex
    align-items center
    justify-content center
    width 36px
    margin-right var(--saf0o-space-3)

  .originChainItemCheck
    position absolute
    top 50%
    right var(--saf0o-space-3)
    display flex
    align-items center
    justify-content center
    width 28px
    height 28px
    border-radius var(--saf0o-radius-sm)
    color var(--saf0o-success)
    background var(--saf0o-success-soft)
    transform translateY(-50%)

  .originChainItemActive
    color var(--saf0o-success)

.connectedAppsDetails
  .originSwapTitle
    padding-right 0
    padding-left 0

  .originSwapChainList
    margin-right 0
    margin-left 0

.originAccessContext
  margin-bottom var(--saf0o-space-5)

  p
    margin 0
    color var(--saf0o-text-secondary)
    font-size var(--saf0o-type-small)
    line-height 20px

.connectedAppMissing
  display flex
  align-items center
  justify-content center
  min-height 220px
  padding var(--saf0o-space-6)
  color var(--saf0o-text-secondary)
  text-align center

@media (max-width: 540px)
  .connectedApps.connectedAppsPerch
    padding-right 0
    padding-left 0

  .connectedApps:not(.connectedAppsPerch)
    padding-right var(--saf0o-space-3)
    padding-left var(--saf0o-space-3)
