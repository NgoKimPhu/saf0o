.loaderWrap
  width: 18.5px;
  height: 18.5px;
  margin-left var(--saf0o-space-2)

@keyframes load
  0%
    transform rotate(0deg)
  100%
    transform rotate(360deg)

.loader,
.loader:after
  border-radius 100%
  width 7em
  height 7em

.loader 
  font-size 2px
  position relative
  text-indent -9999em
  border-top 2px solid var(--outerspace01)
  border-right 2px solid var(--outerspace01)
  border-bottom 2px solid var(--outerspace01)
  border-left 2px solid var(--outerspace08)
  transform translateZ(0)
  animation load 1.1s infinite linear

.dashModule
  height 120px
  margin-bottom var(--saf0o-space-2)
  border-radius 26px
  cursor pointer
  display flex
  justify-content center
  align-items center
  margin var(--saf0o-space-2)
  font-size var(--saf0o-type-sub)
  font-weight 300
  border-radius 26px
  background var(--ghostAZ)
  box-shadow 0px 2px 4px var(--ghostY)
  border-bottom 2px solid var(--ghostZ)

  *
    pointer-events none

  .dashModuleIcon
    margin-right var(--saf0o-space-5)

.dashModule:hover
  transform translateY(-1px)
  box-shadow 0px 4px 8px var(--ghostY)
  background var(--saf0o-hover)
  z-index 200
  position relative

.dashModule:active
  transform translateY(0px)
  box-shadow 0px 1px 2px var(--ghostY)
  background var(--saf0o-pressed)

button.dashModule
  width calc(100% - 12px)
  border-top 0
  border-right 0
  border-left 0
  color inherit
  font-family 'MainFont'

button.dashModule:focus-visible
  box-shadow 0 0 0 2px var(--moon), 0px 2px 4px var(--ghostY)

button.requestFeatureButton:focus-visible
  box-shadow 0 0 0 2px var(--moon), 0px 2px 4px var(--ghostY)

.signerPermission
  position relative
  justify-content space-between
  padding var(--saf0o-space-3) 0px 0px 0px 
  font-size var(--saf0o-type-body)
  font-weight 300
  transform translateZ(0)
  z-index 2000
  border-radius 26px
  background var(--ghostA)
  box-shadow 0px 4px 6px var(--ghostY)
  border-bottom 2px solid var(--ghostZ)

  .signerPermissionControls
    display flex
    position relative
    justify-content space-between
    transform translateZ(0)
    z-index 40

  .signerPermissionDetails
    display flex
    position relative
    justify-content space-between
    transform translateZ(0)
    font-size var(--saf0o-type-small)
    padding var(--saf0o-space-3) 0px 0px 1px
    z-index 20
    font-weight 300
    font-family 'MainFont'
    line-height 18px

  .keyCommand
    margin-left var(--saf0o-space-1)
    padding 1px var(--saf0o-space-2) 2px var(--saf0o-space-2)
    font-weight 400
    border-radius var(--saf0o-radius-sm)
    font-size var(--saf0o-type-small)
    border 1px solid var(--outerspace05)
    color var(--outerspace)
    height 30px

  .keyCommandLoading
    margin-left var(--saf0o-space-1)
    padding 1px var(--saf0o-space-2) 2px var(--saf0o-space-2)
    font-weight 400
    border-radius var(--saf0o-radius-sm)
    font-size var(--saf0o-type-small)
    border 1px solid var(--outerspace05)
    color var(--outerspace)
    height 30px

  .nodeProviderStatus
    display flex
    justify-content center
    align-items center
    height 18px
    border-radius var(--saf0o-radius-lg)
    font-size var(--saf0o-type-caption)
    text-transform uppercase
    padding-left var(--saf0o-space-2)
    padding-right var(--saf0o-space-2)
    background var(--bad)
    padding-bottom 1px
    font-weight 400
    color #f3f6fd
    text-shadow 0px 1px 2px rgba(100, 0, 0, 0.2), 0px 1px 0px rgba(100, 0, 0, 0.2)
    transform translateZ(0)

  .nodeProviderConnected
    background var(--good)
    text-shadow 0px 1px 2px rgba(0, 50, 50, 0.2), 0px 1px 0px rgba(0, 50, 50, 0.2)

  .signerPermissionOrigin
    background transparent
    width 250px
    direction rtl
    text-overflow ellipsis
    overflow hidden
    text-align left
    white-space nowrap
    font-weight 300
    margin-top 2px

  .signerPermissionNoPermissions
    font-weight 300
    text-align center
    width 100%
    font-size var(--saf0o-type-body)

  .signerPermissionSetting
    background transparent
    width 250px
    direction rtl
    text-overflow ellipsis
    overflow hidden
    text-align left
    white-space nowrap
    font-family 'MainFont'
    font-weight 300
    font-size var(--saf0o-type-sub)
    position relative
    padding-top var(--saf0o-space-1)

.localSetting
  background var(--ghostAZ)
  border-radius 27px
  margin var(--saf0o-space-2)
  padding var(--saf0o-space-5)
  box-shadow 0px 4px 8px var(--ghostY)

.signerPermissionToggle
  appearance none
  border 0
  padding 0
  position relative
  background var(--bad)
  height 20px
  width 40px
  margin-right var(--saf0o-space-2)
  margin-left var(--saf0o-space-3)
  margin-top var(--saf0o-space-1)
  border-radius 2px
  transition var(--standard)
  transform translateZ(0)
  cursor pointer

  &:disabled
    cursor default

  .signerPermissionToggleSwitch
    position absolute
    top 2px
    left 2px
    bottom 2px
    width 16px
    border-radius 1px
    transition var(--standard)
    background var(--ghostC)
    transform translateZ(0)
    pointer-events none
    border-bottom 2px solid var(--ghostZ)

  .signerPermissionToggleSwitchLocked
    position absolute
    top 0px
    left 0px
    bottom 0px
    right 0px
    border-radius 2px
    display flex
    align-items center
    justify-content center
    cursor pointer
    *
      pointer-events none

    .signerPermissionToggleSwitch
      opacity 1
      transition var(--standard)

    svg
      transition var(--standard)
      opacity 0
      color var(--ghostC)

  .signerPermissionToggleSwitchLocked:hover
    .signerPermissionToggleSwitch
      opacity 0

    svg
      opacity 1

.signerPermissionToggleOn
  background var(--good)
  .signerPermissionToggleSwitch
    position absolute
    transform translateX(20px)

.signerPermissionToggle:hover
  .signerPermissionToggleSwitch
    background var(--saf0o-text-primary)

// Saf0o dashboard home
.localSettings
  justify-content flex-start

  .localSettingsWrap
    width 100%
    padding var(--saf0o-space-5) var(--saf0o-page-gutter) var(--saf0o-space-8)
    box-sizing border-box

  .localSetting
    margin 0 0 var(--saf0o-space-2)
    padding var(--saf0o-space-4)
    border 1px solid var(--saf0o-border-subtle)
    border-radius var(--saf0o-radius-sm)
    background var(--saf0o-surface-card)
    box-shadow var(--saf0o-shadow-sm), var(--saf0o-shadow-inset)

    .signerPermissionSetting
      width auto
      max-width calc(100% - 90px)
      color var(--saf0o-text-primary)
      font-size var(--saf0o-type-body)
      font-weight 500
      text-transform none

    .signerPermissionDetails
      padding-top var(--saf0o-space-2)
      color var(--saf0o-text-tertiary)
      font-size var(--saf0o-type-small)
      line-height 18px

    .keyCommand,
    .keyCommandLoading
      min-height 28px
      height auto
      border-color var(--saf0o-border-default)
      border-radius var(--saf0o-radius-sm)
      color var(--saf0o-text-secondary)
      background var(--saf0o-surface-inset)
      font-family var(--saf0o-font-mono)

  .localSetting:last-of-type
    margin-bottom 0

.dashHomePerch
  color var(--saf0o-text-secondary)

  .localSettingsWrap
    width 100%
    padding 2px var(--saf0o-space-4) var(--saf0o-space-4)
    box-sizing border-box

.dashModules
  display flex
  flex-direction column
  gap var(--saf0o-space-2)
  margin-bottom var(--saf0o-space-3)

// Rows, cards and button strips on the Control page share one radius, one border, one 44px row.
button.dashModule.saf0oControl
  position relative
  display grid
  grid-template-columns 28px minmax(0, 1fr) auto
  gap var(--saf0o-space-3)
  width 100%
  height 36px
  min-height 36px
  margin 0
  padding 0 var(--saf0o-space-3)
  align-items center
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-md)
  color var(--saf0o-text-secondary)
  background var(--saf0o-surface-card)
  background-image none
  box-shadow none
  font-family var(--saf0o-font-ui)
  text-align left
  transform none

  &:hover:not(:disabled)
    z-index auto
    border-color var(--saf0o-border-default)
    color var(--saf0o-text-primary)
    background var(--saf0o-surface-hover)
    box-shadow none
    transform none

  &:active:not(:disabled)
    background var(--saf0o-surface-active)
    transform none

  .dashModuleIcon
    position static
    display flex
    width 28px
    height 28px
    margin 0
    align-items center
    justify-content center
    border-radius var(--saf0o-radius-sm)
    color var(--saf0o-text-tertiary)
    transition color var(--saf0o-motion-fast) var(--saf0o-ease)

  .dashModuleCopy
    position static
    display block
    min-width 0

  .dashModuleTitle
    display block
    color inherit
    font-size var(--saf0o-type-body)
    font-weight 500
    line-height 18px

  .dashModuleDescription
    position absolute
    width 1px
    height 1px
    overflow hidden
    clip rect(0 0 0 0)
    white-space nowrap

  .dashModuleMeta
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    font-weight 400

  .dashModuleArrow
    display flex
    color var(--saf0o-text-muted)

button.dashModule.saf0oControl.saf0oControlGhost
  border-color var(--saf0o-border-subtle)
  background-color var(--saf0o-surface-card)

  &:hover:not(:disabled)
    border-color var(--saf0o-border-default)
    background-color var(--saf0o-surface-hover)

// Current page: the logo emerald, as a border and icon tint on the same card surface.
button.dashModuleCurrent.saf0oControl
  border-color var(--saf0o-accent-primary)
  color var(--saf0o-text-primary)
  background var(--saf0o-accent-primary-soft)

  &:hover:not(:disabled)
    border-color var(--saf0o-accent-primary)
    background var(--saf0o-accent-primary-soft)

  .dashModuleIcon
    color var(--saf0o-accent-primary)

.dashHomeCard
  position relative
  margin-bottom var(--saf0o-space-3)
  padding var(--saf0o-space-4)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-md)
  background var(--saf0o-surface-card)
  box-sizing border-box

  h2
    margin 0 0 var(--saf0o-space-2)
    color var(--saf0o-text-muted)
    font-family var(--saf0o-font-mono)
    font-size var(--saf0o-type-caption)
    font-weight 600
    letter-spacing 1.4px
    line-height 16px
    text-transform uppercase

.dashCompanionBrowserActions
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--saf0o-space-2)

  button.saf0oControl.saf0oControlGhost
    width 100%
    height 36px
    min-height 36px
    border 1px solid var(--saf0o-border-default)
    border-radius var(--saf0o-radius-md)
    color var(--saf0o-text-secondary)
    background var(--saf0o-surface-inset)
    box-shadow none
    font-size var(--saf0o-type-small)

    &:hover:not(:disabled)
      border-color var(--saf0o-border-strong)
      color var(--saf0o-text-primary)
      background var(--saf0o-surface-hover)

    span
      font-size var(--saf0o-type-small)

.dashSupportActions
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap var(--saf0o-space-2)
  margin-bottom 0

  button.requestFeatureButton.saf0oControl
    justify-content center
    width 100%
    height 36px
    min-height 36px
    padding 0 var(--saf0o-space-2)
    gap var(--saf0o-space-2)
    border 1px solid var(--saf0o-border-subtle)
    border-radius var(--saf0o-radius-md)
    color var(--saf0o-text-secondary)
    background var(--saf0o-surface-card)
    background-image none
    box-shadow none
    font-size var(--saf0o-type-caption)
    font-weight 500
    white-space nowrap

    &:hover:not(:disabled)
      color var(--saf0o-text-primary)
      border-color var(--saf0o-border-default)
      background var(--saf0o-surface-hover)
      box-shadow none

  .requestFeatureDanger
    color var(--saf0o-danger) !important
    border-color var(--saf0o-danger-soft) !important
    background var(--saf0o-danger-soft) !important

.dashToolsCard
  margin-bottom var(--saf0o-space-3)

.dashToolList
  display flex
  flex-direction column

  button.dashModuleCompact.saf0oControl
    height 36px
    min-height 36px
    padding 0
    grid-template-columns 28px minmax(0, 1fr) auto
    border 0
    border-bottom 1px solid var(--saf0o-border-subtle)
    border-radius 0
    background transparent
    box-shadow none

    &:last-child
      border-bottom 0

    &:hover:not(:disabled)
      border-color var(--saf0o-border-subtle)
      background transparent
      box-shadow none

    .dashModuleIcon
      border 0
      color var(--saf0o-text-tertiary)
      background transparent

@media (max-height: 760px)
  .dashHomePerch .localSettingsWrap
    padding-bottom var(--saf0o-space-3)

.networkEditorSections
  display flex
  gap var(--saf0o-space-1)
  padding var(--saf0o-space-1)
  border 1px solid var(--saf0o-border-subtle)
  border-radius var(--saf0o-radius-md)
  background var(--saf0o-surface-inset)

  button.saf0oControl.saf0oControlGhost
    flex 1
    min-width 0
    min-height 44px
    height auto
    padding var(--saf0o-space-2)
    font-size var(--saf0o-type-small)
    border-color transparent
    border-radius var(--saf0o-radius-sm)

    &[aria-pressed='true'],
    &[aria-pressed='true']:hover:not(:disabled)
      border-color var(--saf0o-border-subtle)
      color var(--saf0o-text-primary)
      background var(--saf0o-surface-active)
      box-shadow var(--saf0o-shadow-sm)
  margin-bottom var(--saf0o-space-4)

.networkEditorLiveStatus
  color var(--saf0o-text-secondary)
  font-size var(--saf0o-type-caption)

.accountTypeAdvanced
  margin-top var(--saf0o-space-5)

.originAccountAccess
  display flex
  flex-direction column
  align-items flex-start
  gap var(--saf0o-space-1)
  width 100%
  padding var(--saf0o-space-3)
  code
    overflow-wrap anywhere

// Five destinations on one line: icons hidden, labels centered.
.dashControlNavigation
  flex-direction row

  button.dashModule.saf0oControl
    flex 1 1 0
    min-width 0
    grid-template-columns minmax(0, 1fr)
    justify-items center
    padding 0 var(--saf0o-space-2)

    .dashModuleIcon
      display none

    .dashModuleTitle
      overflow hidden
      text-overflow ellipsis
      white-space nowrap
