{
  "roots": ["test/e2e"],
  "testEnvironment": "<rootDir>/test/e2e/setup/environment.js",
  "testTimeout": 10000,
  "setupFiles": ["<rootDir>/test/e2e/setup/isolation.js"],
  "transform": {
    "\\.ts$": [
      "@swc/jest",
      {
        "jsc": {
          "target": "es2021",
          "parser": {
            "syntax": "typescript"
          }
        },
        "module": {
          "type": "commonjs"
        }
      }
    ],
    "\\.tsx$": [
      "@swc/jest",
      {
        "jsc": {
          "target": "es2021",
          "parser": {
            "syntax": "typescript",
            "tsx": true
          },
          "transform": {
            "react": {
              "runtime": "automatic"
            }
          }
        },
        "module": {
          "type": "commonjs"
        }
      }
    ],
    "\\.jsx?$": [
      "@swc/jest",
      {
        "jsc": {
          "target": "es2021",
          "parser": {
            "syntax": "ecmascript",
            "jsx": true
          },
          "transform": {
            "react": {
              "runtime": "automatic"
            }
          }
        },
        "module": {
          "type": "commonjs"
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@ethereumjs/wallet|@ethereumjs/util|ethereum-cryptography|@noble/[^/]+|@scure/[^/]+)(/|$))"
  ],
  "clearMocks": true
}
