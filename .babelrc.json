{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "node": "16"
        }
      }
    ],
    ["@babel/preset-typescript", { "onlyRemoveTypeImports": false }]
  ],
  "overrides": [
    {
      "exclude": "./**/*.ts",
      "presets": [
        [
          "@babel/preset-react",
          {
            "runtime": "automatic"
          }
        ]
      ]
    }
  ]
}
